#!/bin/bash

# Kali Laptop Deploy Script (kali-autodeploy-laptop)
# Tools come from Kali's own kali-tools-* metapackages
# Installs:
#   - kali-tools-* metapackages (see TOOL_METAS below -- edit to taste)
#   - kali-desktop-i3 (i3 + xorg + kali-desktop-core, session registered with
#     the display manager) plus polybar and kitty
#   - the v5 i3 / polybar / kitty configs
#
# Hardening (laptop on a hostile LAN -- see Phase 4):
#   ufw default-deny inbound, no SSH server, no mDNS/CUPS/Bluetooth
#   advertisement, NetworkManager MAC randomization, idle screen lock.
#
# Usage:
#   sudo ./kali-autodeploy-laptop [options]
#
#   --dry-run          show what would happen; change nothing
#   --skip <phase>     skip a phase (repeatable)
#   --only <phase>     run only these phases (repeatable)
#   --list-phases      print phase names and exit
#   -h, --help         this message
#
# Phases: base tools desktop harden i3 polybar kitty shell wordlists
#
# Design notes: an installer should keep going when an optional piece fails
# rather than aborting -- you should never have to reinstall the OS because one
# package went missing. We keep -u and pipefail but NOT -e, make every fallible
# step tolerant, and re-running the script is always safe (every phase is
# idempotent). A full transcript is written to /var/log so a failure is
# diagnosable after the fact instead of scrolling off the screen.

set -uo pipefail

# ------------------------------------------------------------------------------
# Configuration
# ------------------------------------------------------------------------------

readonly WORDLIST_DIR="/usr/share/wordlists"
readonly ZSHRC_MARKER="# >>> kali-autodeploy-laptop >>>"
readonly ZSHRC_END_MARKER="# <<< kali-autodeploy-laptop <<<"
readonly MIN_DISK_GB=20

# Tool metapackages. Kali curates these and resolves their dependencies, so the
# names are stable across rolling in a way a hand-listed set of tools is not.
# Each is probed with apt_available before install: one that Kali renames is a
# clean skip, never an aborted run.
#
# Deliberately omitted: kali-tools-sdr (gnuradio pulls a very large dependency
# tree and needs hardware you may not carry). Add it here if you want it.
TOOL_METAS=(
    kali-tools-information-gathering
    kali-tools-vulnerability
    kali-tools-web
    kali-tools-database
    kali-tools-passwords
    kali-tools-exploitation
    kali-tools-post-exploitation
    kali-tools-sniffing-spoofing
    kali-tools-windows-resources
    kali-tools-reverse-engineering
    kali-tools-802-11
    kali-tools-wireless
    kali-tools-bluetooth
    kali-tools-rfid
)

# Not guaranteed by the metapackages above, or wanted regardless.
# ncat split out of the nmap package on current Debian/Kali; psmisc provides
# the killall that polybar's launch.sh calls.
EXTRA_PKGS=(
    ncat
    psmisc
    jq
    unzip
    curl
    wget
    git
    seclists
    ufw
)

# Desktop. kali-desktop-i3 is a full desktop, not just a window manager: it
# pulls kali-desktop-core/base, i3, i3-dotfiles, lightdm, polybar, kitty, picom,
# feh, network-manager, pulseaudio and betterlockscreen. That registers the i3
# session with the display manager for us -- the thing v5 had to hand-patch on
# Ubuntu by adding xorg/xinit itself.
#
# polybar and kitty are already dependencies; they stay listed explicitly
# because this script writes configs for them and should fail loudly if they
# ever leave the metapackage.
#
# Do NOT add i3lock here. kali-desktop-i3 -> betterlockscreen -> i3lock-color,
# and i3lock-color both Conflicts and Provides i3lock, so naming plain i3lock
# makes the whole batch unresolvable (caught by tests/ T2). i3lock-color ships
# /usr/bin/i3lock, so the `i3lock -c` call in the i3 config below still works.
#
# Kali stages its own i3/polybar/kitty configs under /usr/share/i3-dotfiles/
# rather than installing them into $HOME, so they never collide with ours --
# worth a look if you want to borrow anything from them.
DESKTOP_PKGS=(
    kali-desktop-i3
    polybar
    kitty
    xss-lock
    fonts-powerline
)

readonly ALL_PHASES=(base tools desktop harden i3 polybar kitty shell wordlists)

# Colors
readonly RED='\033[0;31m'
readonly GREEN='\033[0;32m'
readonly YELLOW='\033[1;33m'
readonly BLUE='\033[0;34m'
readonly NC='\033[0m'

DRY_RUN=0
SKIP_PHASES=()
ONLY_PHASES=()

# ------------------------------------------------------------------------------
# Helper Functions
# ------------------------------------------------------------------------------

# warn/err go to stderr so they don't get captured by $(...) command
# substitutions (e.g. get_real_user) and so they're visible on the error path.
msg()   { echo -e "${GREEN}[+]${NC} $1"; }
warn()  { echo -e "${YELLOW}[*]${NC} $1" >&2; }
err()   { echo -e "${RED}[!]${NC} $1" >&2; }
phase() { echo -e "\n${BLUE}=== $1 ===${NC}"; }

usage() {
    sed -n '3,50p' "$0" | sed 's/^# \{0,1\}//'
    exit 0
}

get_real_user() {
    if [[ -n "${SUDO_USER:-}" ]] && [[ "$SUDO_USER" != "root" ]]; then
        echo "$SUDO_USER"
    else
        err "This script must be run with sudo, not as root directly"
        err "Usage: sudo $0"
        exit 1
    fi
}

get_user_home() {
    getent passwd "$1" | cut -d: -f6
}

# Every mutating command goes through run() so --dry-run is honoured in one
# place rather than being sprinkled through each phase.
run() {
    if (( DRY_RUN )); then
        echo -e "${YELLOW}[dry-run]${NC} $*"
        return 0
    fi
    "$@"
}

# Write a heredoc to a file, honouring --dry-run. Reads content from stdin.
write_file() {
    local dst="$1" mode="${2:-}"
    if (( DRY_RUN )); then
        echo -e "${YELLOW}[dry-run]${NC} write $dst"
        cat >/dev/null
        return 0
    fi
    mkdir -p "$(dirname "$dst")"
    cat > "$dst" || { err "could not write $dst"; return 1; }
    [[ -n "$mode" ]] && chmod "$mode" "$dst"
    return 0
}

should_run() {
    local p="$1" x
    if (( ${#ONLY_PHASES[@]} )); then
        for x in "${ONLY_PHASES[@]}"; do [[ "$x" == "$p" ]] && return 0; done
        return 1
    fi
    for x in "${SKIP_PHASES[@]}"; do [[ "$x" == "$p" ]] && return 1; done
    return 0
}

is_phase() {
    local p="$1" x
    for x in "${ALL_PHASES[@]}"; do [[ "$x" == "$p" ]] && return 0; done
    return 1
}

# True if apt has an installation candidate for the package on THIS system.
# Lets us skip packages that were renamed/removed instead of aborting the batch.
apt_available() {
    local cand
    cand=$(apt-cache policy "$1" 2>/dev/null | awk '/Candidate:/ {print $2}')
    [[ -n "$cand" && "$cand" != "(none)" ]]
}

# Install a list of apt packages, falling back to one-by-one so that a single
# unavailable package doesn't take down the entire batch. In the fallback we
# probe availability first so a removed/renamed package is a clean skip.
apt_install() {
    (( $# )) || return 0
    if (( DRY_RUN )); then
        echo -e "${YELLOW}[dry-run]${NC} apt-get install -y $*"
        return 0
    fi
    if apt-get install -y "$@"; then
        return 0
    fi
    warn "Bulk apt install failed; retrying packages individually..."
    for pkg in "$@"; do
        if apt_available "$pkg"; then
            apt-get install -y "$pkg" || warn "Could not install '$pkg' (skipping)"
        else
            warn "Package '$pkg' not available on this system (skipping)"
        fi
    done
}

# Install the FIRST package from the list that this system actually offers.
apt_install_first() {
    local label="$1"; shift
    local pkg
    for pkg in "$@"; do
        if apt_available "$pkg"; then
            if (( DRY_RUN )); then
                echo -e "${YELLOW}[dry-run]${NC} $label: would install '$pkg'"
                return 0
            fi
            if apt-get install -y "$pkg"; then
                msg "$label: installed '$pkg'"
                return 0
            fi
        fi
    done
    warn "$label: none of [$*] are available (skipping)"
    return 1
}

# Disable and mask a systemd unit if it exists. Guarded for containers/WSL where
# there is no systemd at all.
disable_unit() {
    local unit="$1" why="$2"
    systemctl list-unit-files "$unit" &>/dev/null || return 0
    if systemctl cat "$unit" &>/dev/null; then
        run systemctl disable --now "$unit" 2>/dev/null \
            || warn "could not disable $unit"
        msg "disabled $unit ($why)"
    fi
}

# ------------------------------------------------------------------------------
# Argument parsing
# ------------------------------------------------------------------------------

while (( $# )); do
    case "$1" in
        --dry-run)      DRY_RUN=1; shift ;;
        --skip)         [[ -n "${2:-}" ]] || { err "--skip needs a phase"; exit 1; }
                        SKIP_PHASES+=("$2"); shift 2 ;;
        --only)         [[ -n "${2:-}" ]] || { err "--only needs a phase"; exit 1; }
                        ONLY_PHASES+=("$2"); shift 2 ;;
        --list-phases)  printf '%s\n' "${ALL_PHASES[@]}"; exit 0 ;;
        # Every package name this script can install, one per line. The test
        # harness reads its package list from here so it can never drift out of
        # sync with the arrays above.
        --print-packages)
                        printf '%s\n' "${TOOL_METAS[@]}" "${EXTRA_PKGS[@]}" \
                                      "${DESKTOP_PKGS[@]}"; exit 0 ;;
        -h|--help)      usage ;;
        *)              err "unknown option: $1"; err "try --help"; exit 1 ;;
    esac
done

for p in "${SKIP_PHASES[@]}" "${ONLY_PHASES[@]}"; do
    is_phase "$p" || { err "unknown phase: $p"; err "valid: ${ALL_PHASES[*]}"; exit 1; }
done

# ------------------------------------------------------------------------------
# Pre-flight Checks
# ------------------------------------------------------------------------------

if [[ $EUID -ne 0 ]]; then
    err "This script must be run with sudo"
    exit 1
fi

# get_real_user's `exit 1` only exits the command-substitution subshell, so we
# must check its status and exit the parent ourselves (no `set -e` to do it).
REAL_USER=$(get_real_user) || exit 1
USER_HOME=$(get_user_home "$REAL_USER")

if [[ -z "$REAL_USER" || -z "$USER_HOME" ]]; then
    err "Could not determine the target user or home directory"
    exit 1
fi

# Log everything. A deploy that fails 40 minutes in is only debuggable if the
# transcript outlived the scrollback. Skipped for --dry-run (nothing to record).
LOGFILE="/var/log/kali-autodeploy-laptop-$(date +%Y%m%d-%H%M%S).log"
if (( ! DRY_RUN )); then
    exec > >(tee -a "$LOGFILE") 2>&1
fi

phase "Pre-flight"
msg "User:      $REAL_USER ($USER_HOME)"
(( DRY_RUN )) && msg "Mode:      DRY RUN (nothing will be changed)" \
              || msg "Log:       $LOGFILE"

# Kali check -- advisory, not fatal. /etc/os-release on kali-rolling has ID=kali
# but NO VERSION_ID, so never branch on version: under `set -u` that is a crash.
distro_id="$(. /etc/os-release 2>/dev/null && echo "${ID:-unknown}")"
if [[ "$distro_id" != "kali" ]]; then
    warn "This does not look like Kali (ID=$distro_id)."
    warn "The kali-tools-* metapackages and kali-desktop-i3 will not resolve."
    warn "Continuing anyway -- every package is probed before install."
else
    msg "Distro:    Kali ($(. /etc/os-release 2>/dev/null && echo "${VERSION_ID:-rolling}"))"
fi

# Disk. The metapackage set is large; running out of space mid-install is the
# other classic way a deploy strands you.
avail_gb=$(df -BG --output=avail / 2>/dev/null | tail -1 | tr -dc '0-9')
if [[ -n "$avail_gb" ]]; then
    if (( avail_gb < MIN_DISK_GB )); then
        warn "Only ${avail_gb}G free on / (recommended: ${MIN_DISK_GB}G+)"
        warn "The tool metapackages may not fit. Ctrl-C now if that's a problem."
        sleep 5
    else
        msg "Disk:      ${avail_gb}G free on /"
    fi
fi

# Network. Cheap check so we fail loudly here rather than confusingly later.
if getent hosts http.kali.org >/dev/null 2>&1; then
    msg "Network:   kali mirror resolves"
else
    warn "Cannot resolve http.kali.org -- apt phases will likely fail"
fi

(( ${#SKIP_PHASES[@]} )) && msg "Skipping:  ${SKIP_PHASES[*]}"
(( ${#ONLY_PHASES[@]} )) && msg "Only:      ${ONLY_PHASES[*]}"

# ------------------------------------------------------------------------------
# Phase: base -- apt update / full-upgrade, debconf pre-seed
# ------------------------------------------------------------------------------

if should_run base; then
    phase "Phase: base"

    # Kali is a rolling release: `upgrade` can hold back packages and leave a
    # partially-upgraded system, which is a documented way to break it.
    # full-upgrade is the supported path.
    export DEBIAN_FRONTEND=noninteractive

    msg "Updating package lists..."
    run apt-get update || warn "apt-get update reported errors (continuing)"

    msg "Full-upgrading (rolling release; 'upgrade' is not safe here)..."
    run apt-get -y full-upgrade || warn "full-upgrade reported errors (continuing)"

    # Several packages inside the chosen metapackages ask debconf questions and
    # will HANG an unattended run waiting for an answer. DEBIAN_FRONTEND alone
    # picks the default; pre-seeding picks *our* answer. All three below are
    # security-relevant, and the safe answer is "no".
    #   wireshark-common -- give dumpcap setuid so non-root users can capture
    #   kismet           -- same question, plus which users to add
    #   macchanger       -- change MAC automatically on every ifup
    msg "Pre-seeding debconf (prevents interactive hangs mid-install)..."
    if (( DRY_RUN )); then
        echo -e "${YELLOW}[dry-run]${NC} debconf-set-selections <<< (wireshark/kismet/macchanger)"
    else
        debconf-set-selections <<'PRESEED' || warn "debconf pre-seed failed"
wireshark-common wireshark-common/install-setuid boolean false
kismet kismet/install-setuid boolean false
kismet kismet/install-users string
macchanger macchanger/automatically_run boolean false
PRESEED
    fi
fi

# ------------------------------------------------------------------------------
# Phase: tools -- kali-tools-* metapackages
# ------------------------------------------------------------------------------

if should_run tools; then
    phase "Phase: tools"

    export DEBIAN_FRONTEND=noninteractive

    available_metas=()
    for m in "${TOOL_METAS[@]}"; do
        if apt_available "$m"; then
            available_metas+=("$m")
        else
            warn "metapackage '$m' not available (skipping)"
        fi
    done

    if (( ${#available_metas[@]} )); then
        msg "Installing ${#available_metas[@]} tool metapackages (this takes a while)..."
        # One at a time: these are big, and a failure in one shouldn't cost you
        # the other thirteen. Each is already known-available from the probe.
        for m in "${available_metas[@]}"; do
            msg "  -> $m"
            apt_install "$m"
        done
    else
        warn "No tool metapackages available -- is this actually Kali?"
    fi

    msg "Installing extra packages..."
    apt_install "${EXTRA_PKGS[@]}"

    apt_install_first "Java runtime" default-jre-headless default-jre \
        openjdk-21-jre-headless openjdk-17-jre-headless
fi

# ------------------------------------------------------------------------------
# Phase: desktop -- kali-desktop-i3 + polybar + kitty
# ------------------------------------------------------------------------------

if should_run desktop; then
    phase "Phase: desktop"

    export DEBIAN_FRONTEND=noninteractive

    msg "Installing i3 desktop..."
    apt_install "${DESKTOP_PKGS[@]}"

    # Make kitty the x-terminal-emulator so anything that shells out to a
    # terminal gets the one we configured.
    if command -v kitty &>/dev/null; then
        run update-alternatives --install /usr/bin/x-terminal-emulator \
            x-terminal-emulator /usr/bin/kitty 50 || true
        run update-alternatives --set x-terminal-emulator /usr/bin/kitty || true
    fi
fi

# ------------------------------------------------------------------------------
# Phase: harden -- posture for a laptop on a hostile LAN
# ------------------------------------------------------------------------------

if should_run harden; then
    phase "Phase: harden"

    # --- No listening SSH. This laptop is one you sit at; an SSH server on the
    # DEFCON network is an attack surface with no upside.
    disable_unit ssh.service "no SSH server on a laptop"

    # --- Stop advertising ourselves. avahi broadcasts hostname and services
    # over mDNS; cups-browsed both listens and browses for printers.
    disable_unit avahi-daemon.service "mDNS advertises this host"
    disable_unit avahi-daemon.socket  "mDNS advertises this host"
    disable_unit cups.service         "printing daemon listens"
    disable_unit cups-browsed.service "printer discovery"

    # --- Bluetooth tools stay installed; the daemon needn't be discoverable.
    disable_unit bluetooth.service "BT tools installed, daemon off by default"

    # --- MAC randomization. Both the scan-time MAC and the associated MAC, so
    # you aren't trivially trackable across the conference network.
    msg "Configuring NetworkManager MAC randomization..."
    write_file /etc/NetworkManager/conf.d/00-macrandomize.conf <<'NMCONF'
# Managed by kali-autodeploy-laptop -- MAC randomization.
# scan-rand-mac-address randomizes the MAC used while scanning for networks;
# cloned-mac-address=random gives a fresh MAC per connection. Delete this file
# to restore stock behaviour (some captive portals and MAC-allowlisted networks
# will need you to).
[device]
wifi.scan-rand-mac-address=yes

[connection]
wifi.cloned-mac-address=random
ethernet.cloned-mac-address=random
NMCONF
    run systemctl reload NetworkManager 2>/dev/null \
        || warn "could not reload NetworkManager (applies on next start)"

    # --- Firewall. Default-deny inbound. No lockout risk: you have the keyboard.
    if command -v ufw &>/dev/null; then
        msg "Configuring ufw (default-deny inbound)..."
        run ufw default deny incoming  || warn "ufw: could not set default deny incoming"
        run ufw default allow outgoing || warn "ufw: could not set default allow outgoing"
        run ufw --force enable         || warn "ufw: could not enable"
    else
        warn "ufw not installed -- skipping firewall"
    fi
fi

# ------------------------------------------------------------------------------
# Phase: i3 -- window manager config
# ------------------------------------------------------------------------------

if should_run i3; then
    phase "Phase: i3"

    I3_DIR="$USER_HOME/.config/i3"
    [[ -f "$I3_DIR/config" ]] && run cp "$I3_DIR/config" "$I3_DIR/config.backup"

    write_file "$I3_DIR/config" <<'I3CONFIG'
# i3 config -- kali-autodeploy-laptop
# Mod is Alt (Mod1), not Super. Deliberate, carried over from the Ubuntu recipe.

set $mod Mod1

font pango:monospace 8

# Terminal
bindsym $mod+Return exec kitty

# Kill window
bindsym $mod+Shift+q kill

# Launcher
bindsym $mod+d exec dmenu_run

# Focus
bindsym $mod+h focus left
bindsym $mod+j focus down
bindsym $mod+k focus up
bindsym $mod+l focus right
bindsym $mod+Left focus left
bindsym $mod+Down focus down
bindsym $mod+Up focus up
bindsym $mod+Right focus right

# Move
bindsym $mod+Shift+h move left
bindsym $mod+Shift+j move down
bindsym $mod+Shift+k move up
bindsym $mod+Shift+l move right
bindsym $mod+Shift+Left move left
bindsym $mod+Shift+Down move down
bindsym $mod+Shift+Up move up
bindsym $mod+Shift+Right move right

# Split
bindsym $mod+b split h
bindsym $mod+v split v

# Fullscreen
bindsym $mod+f fullscreen toggle

# Layout
bindsym $mod+s layout stacking
bindsym $mod+w layout tabbed
bindsym $mod+e layout toggle split

# Floating
bindsym $mod+Shift+space floating toggle
bindsym $mod+space focus mode_toggle

# Parent container
bindsym $mod+a focus parent

# Workspaces
set $ws1 "1"
set $ws2 "2"
set $ws3 "3"
set $ws4 "4"
set $ws5 "5"
set $ws6 "6"
set $ws7 "7"
set $ws8 "8"
set $ws9 "9"
set $ws10 "10"

bindsym $mod+1 workspace number $ws1
bindsym $mod+2 workspace number $ws2
bindsym $mod+3 workspace number $ws3
bindsym $mod+4 workspace number $ws4
bindsym $mod+5 workspace number $ws5
bindsym $mod+6 workspace number $ws6
bindsym $mod+7 workspace number $ws7
bindsym $mod+8 workspace number $ws8
bindsym $mod+9 workspace number $ws9
bindsym $mod+0 workspace number $ws10

bindsym $mod+Shift+1 move container to workspace number $ws1
bindsym $mod+Shift+2 move container to workspace number $ws2
bindsym $mod+Shift+3 move container to workspace number $ws3
bindsym $mod+Shift+4 move container to workspace number $ws4
bindsym $mod+Shift+5 move container to workspace number $ws5
bindsym $mod+Shift+6 move container to workspace number $ws6
bindsym $mod+Shift+7 move container to workspace number $ws7
bindsym $mod+Shift+8 move container to workspace number $ws8
bindsym $mod+Shift+9 move container to workspace number $ws9
bindsym $mod+Shift+0 move container to workspace number $ws10

# Reload/Restart
bindsym $mod+Shift+c reload
bindsym $mod+Shift+r restart
bindsym $mod+Shift+e exec "i3-nagbar -t warning -m 'Exit i3?' -B 'Yes' 'i3-msg exit'"

# Resize mode
mode "resize" {
    bindsym h resize shrink width 10 px or 10 ppt
    bindsym j resize grow height 10 px or 10 ppt
    bindsym k resize shrink height 10 px or 10 ppt
    bindsym l resize grow width 10 px or 10 ppt
    bindsym Left resize shrink width 10 px or 10 ppt
    bindsym Down resize grow height 10 px or 10 ppt
    bindsym Up resize shrink height 10 px or 10 ppt
    bindsym Right resize grow width 10 px or 10 ppt
    bindsym Return mode "default"
    bindsym Escape mode "default"
    bindsym $mod+r mode "default"
}
bindsym $mod+r mode "resize"

# Polybar
exec_always --no-startup-id $HOME/.config/polybar/launch.sh

# Lock screen -- manual, and automatically after 5 min idle. On a conference
# floor an unattended unlocked laptop is the whole threat model.
bindsym $mod+Escape exec i3lock -c 282a2e
exec --no-startup-id xss-lock --transfer-sleep-lock -- i3lock -c 282a2e --nofork
exec --no-startup-id xset s 300 300
I3CONFIG

    run chown -R "$REAL_USER:$REAL_USER" "$I3_DIR"
    msg "i3 config written to $I3_DIR/config"
fi

# ------------------------------------------------------------------------------
# Phase: polybar -- status bar
# ------------------------------------------------------------------------------

if should_run polybar; then
    phase "Phase: polybar"

    POLYBAR_DIR="$USER_HOME/.config/polybar"

    # Font Awesome lines from the Ubuntu recipe are dropped: every module prefix
    # here is plain ASCII ("CPU ", "MEM "), so the glyph fonts were never used,
    # and asking for "Font Awesome 6" against Kali's FA4/5 package just fills the
    # polybar log with font errors.
    write_file "$POLYBAR_DIR/config.ini" <<'POLYBAR'
[colors]
background = #282A2E
background-alt = #373B41
foreground = #C5C8C6
primary = #F0C674
secondary = #8ABEB7
alert = #A54242
disabled = #707880

[bar/main]
width = 100%
height = 24pt
radius = 0
background = ${colors.background}
foreground = ${colors.foreground}
line-size = 3pt
border-size = 0
padding-left = 0
padding-right = 1
module-margin = 1
separator = |
separator-foreground = ${colors.disabled}
font-0 = monospace;2
modules-left = i3 xwindow
modules-center = date
modules-right = wlan network cpu memory battery
cursor-click = pointer
cursor-scroll = ns-resize
enable-ipc = true

[module/i3]
type = internal/i3
pin-workspaces = true
show-urgent = true
strip-wsnumbers = true
index-sort = true
format = <label-state> <label-mode>
label-focused = %index%
label-focused-background = ${colors.background-alt}
label-focused-underline = ${colors.primary}
label-focused-padding = 1
label-unfocused = %index%
label-unfocused-padding = 1
label-visible = %index%
label-visible-underline = ${colors.secondary}
label-visible-padding = 1
label-urgent = %index%
label-urgent-background = ${colors.alert}
label-urgent-padding = 1

[module/xwindow]
type = internal/xwindow
label = %title:0:60:...%

[module/cpu]
type = internal/cpu
interval = 2
format-prefix = "CPU "
format-prefix-foreground = ${colors.primary}
label = %percentage:2%%

[module/memory]
type = internal/memory
interval = 2
format-prefix = "MEM "
format-prefix-foreground = ${colors.primary}
label = %percentage_used:2%%

[module/network]
type = internal/network
interface-type = wired
interval = 3.0
format-connected = <label-connected>
format-connected-prefix = "ETH "
format-connected-prefix-foreground = ${colors.primary}
label-connected = %ifname% %local_ip%
format-disconnected =

[module/wlan]
type = internal/network
interface-type = wireless
interval = 3.0
format-connected = <label-connected>
format-connected-prefix = "WLAN "
format-connected-prefix-foreground = ${colors.primary}
label-connected = %essid% %local_ip%
format-disconnected = <label-disconnected>
label-disconnected = wlan down
label-disconnected-foreground = ${colors.disabled}

[module/battery]
type = internal/battery
battery = BAT0
adapter = AC
full-at = 98
format-charging = <label-charging>
format-charging-prefix = "BAT+ "
format-charging-prefix-foreground = ${colors.secondary}
label-charging = %percentage%%
format-discharging = <label-discharging>
format-discharging-prefix = "BAT "
format-discharging-prefix-foreground = ${colors.primary}
label-discharging = %percentage%%
format-full-prefix = "FULL "
format-full-prefix-foreground = ${colors.secondary}
label-full = %percentage%%

[module/date]
type = internal/date
interval = 1
date = %Y-%m-%d %H:%M:%S
date-alt = %A, %B %d, %Y %H:%M:%S
label = %date%
label-foreground = ${colors.primary}

[settings]
screenchange-reload = true
pseudo-transparency = false
POLYBAR

    write_file "$POLYBAR_DIR/launch.sh" 755 <<'LAUNCH'
#!/bin/bash
killall -q polybar
while pgrep -u $UID -x polybar >/dev/null; do sleep 1; done
polybar main &
LAUNCH

    run chown -R "$REAL_USER:$REAL_USER" "$POLYBAR_DIR"
    msg "polybar config written to $POLYBAR_DIR/config.ini"
fi

# ------------------------------------------------------------------------------
# Phase: kitty -- terminal
# ------------------------------------------------------------------------------

if should_run kitty; then
    phase "Phase: kitty"

    KITTY_DIR="$USER_HOME/.config/kitty"

    write_file "$KITTY_DIR/kitty.conf" <<'KITTY'
font_family      monospace
font_size        11.0
shell            /usr/bin/zsh
shell_integration enabled
enable_audio_bell no
background_opacity 0.95
background       #1e1e1e
scrollback_lines 10000
open_url_with    default
detect_urls      yes
repaint_delay    10
input_delay      3
sync_to_monitor  yes

# Live font-size adjustment (Ctrl+Shift + / - / Backspace). These override
# kitty's defaults to use a 1.0pt step; Backspace resets to font_size above.
map ctrl+shift+equal         change_font_size all +1.0
map ctrl+shift+plus          change_font_size all +1.0
map ctrl+shift+kp_add        change_font_size all +1.0
map ctrl+shift+minus         change_font_size all -1.0
map ctrl+shift+kp_subtract   change_font_size all -1.0
map ctrl+shift+backspace     change_font_size all 0
KITTY

    run chown -R "$REAL_USER:$REAL_USER" "$KITTY_DIR"
    msg "kitty config written to $KITTY_DIR/kitty.conf"
fi

# ------------------------------------------------------------------------------
# Phase: shell -- append to Kali's zsh, don't replace it
# ------------------------------------------------------------------------------

if should_run shell; then
    phase "Phase: shell"

    # Kali already ships a tuned zsh (syntax highlighting, autosuggestions, a
    # good prompt) and makes it the default shell. We append a marker-guarded
    # block rather than installing Oh My Zsh over the top: faster startup, and
    # no sed against a template that may not be there. Re-running is a no-op.
    ZSHRC="$USER_HOME/.zshrc"

    if [[ ! -f "$ZSHRC" ]]; then
        warn "$ZSHRC does not exist -- creating one"
        run touch "$ZSHRC"
        run chown "$REAL_USER:$REAL_USER" "$ZSHRC"
    fi

    if grep -qF "$ZSHRC_MARKER" "$ZSHRC" 2>/dev/null; then
        msg "zshrc block already present (idempotent -- leaving it alone)"
    elif (( DRY_RUN )); then
        echo -e "${YELLOW}[dry-run]${NC} append config block to $ZSHRC"
    else
        cat >> "$ZSHRC" <<ZSHRC_BLOCK

$ZSHRC_MARKER
# Added by kali-autodeploy-laptop. Delete this block (through the closing
# marker) to remove. Kali's own zsh config above is untouched.

export PATH="\$HOME/.local/bin:\$HOME/.cargo/bin:\$PATH"

# Wordlists
export WORDLISTS="/usr/share/wordlists"
export SECLISTS="/usr/share/seclists"
export ROCKYOU="/usr/share/wordlists/rockyou.txt"

# Security
alias nse='ls /usr/share/nmap/scripts/ | grep'
alias serve='python3 -m http.server'

# Proxychains
alias pchains='proxychains4'
alias pc='proxychains4'

# Network
alias ports='ss -tulanp'
alias listening='ss -tlnp'
alias myip='curl -s ifconfig.me'
alias localip="ip -4 -brief addr show scope global"

# ufw is default-deny inbound on this box: a listener won't be reachable from
# the LAN until you open it. These are the two you'll actually want.
alias fw-open='sudo ufw allow'
alias fw-status='sudo ufw status verbose'

# Encoders
b64e() { echo -n "\$1" | base64; }
b64d() { echo -n "\$1" | base64 -d; }
urlencode() { python3 -c "import urllib.parse,sys; print(urllib.parse.quote(sys.argv[1]))" "\$1"; }
urldecode() { python3 -c "import urllib.parse,sys; print(urllib.parse.unquote(sys.argv[1]))" "\$1"; }
$ZSHRC_END_MARKER
ZSHRC_BLOCK
        chown "$REAL_USER:$REAL_USER" "$ZSHRC"
        msg "appended config block to $ZSHRC"
    fi
fi

# ------------------------------------------------------------------------------
# Phase: wordlists
# ------------------------------------------------------------------------------

if should_run wordlists; then
    phase "Phase: wordlists"

    # Kali ships rockyou gzipped; decompress in place, keeping the .gz.
    if [[ -f "$WORDLIST_DIR/rockyou.txt" ]]; then
        msg "rockyou.txt already present"
    elif [[ -f "$WORDLIST_DIR/rockyou.txt.gz" ]]; then
        run gunzip -k "$WORDLIST_DIR/rockyou.txt.gz" && msg "decompressed rockyou.txt"
    else
        warn "rockyou.txt(.gz) not found (is the 'wordlists' package installed?)"
    fi

    if [[ -d /usr/share/seclists ]]; then
        msg "SecLists present at /usr/share/seclists"
    else
        warn "SecLists not found -- 'apt install seclists'"
    fi
fi

# ------------------------------------------------------------------------------
# Verification
# ------------------------------------------------------------------------------

phase "Verification"

if (( DRY_RUN )); then
    msg "Dry run complete -- nothing was changed."
    exit 0
fi

check() {
    if command -v "$1" &>/dev/null; then
        echo -e "${GREEN}/${NC} $1"
    else
        echo -e "${RED}x${NC} $1"
    fi
}

echo ""
echo "Tools:"
for c in nmap ncat hashcat john netexec impacket-ntlmrelayx responder \
         mitm6 certipy enum4linux-ng bloodhound-python proxychains4 \
         aircrack-ng wifite hcxdumptool bettercap sqlmap ffuf gobuster; do
    check "$c"
done

echo ""
echo "Desktop:"
for c in i3 polybar kitty dmenu_run i3lock xss-lock Xorg; do
    check "$c"
done

echo ""
echo "Wordlists:"
[[ -f "$WORDLIST_DIR/rockyou.txt" ]] \
    && echo -e "${GREEN}/${NC} rockyou.txt" || echo -e "${RED}x${NC} rockyou.txt"
[[ -d /usr/share/seclists ]] \
    && echo -e "${GREEN}/${NC} SecLists"   || echo -e "${RED}x${NC} SecLists"

echo ""
echo "Hardening:"
if command -v ufw &>/dev/null; then
    echo "  ufw: $(ufw status 2>/dev/null | head -1)"
fi
for u in ssh avahi-daemon cups bluetooth; do
    state=$(systemctl is-enabled "$u" 2>/dev/null || echo "n/a")
    echo "  $u: $state"
done

# The real hardening deliverable: what is actually listening, right now. Read
# this rather than trusting the toggles above.
echo ""
echo "Listening sockets (should be loopback-only on a laptop):"
if command -v ss &>/dev/null; then
    ss -tulpnH 2>/dev/null | awk '{printf "  %-6s %-24s %s\n", $1, $5, $7}' \
        || echo "  (ss failed)"
else
    echo "  (ss not available)"
fi

cat <<BANNER

==============================================
  Deploy complete
==============================================

  Log: $LOGFILE

  Verify on the hardware -- these cannot be checked from a script:

    1. Log out. At the LightDM greeter, pick the i3 session from the
       session menu. Kali defaults to Xfce, so i3 is NOT automatic.
    2. Confirm polybar appears at the top and the battery module shows a
       percentage (it is pinned to BAT0 -- check 'ls /sys/class/power_supply'
       if it stays blank).
    3. Mod is Alt. Mod+Return = kitty, Mod+d = dmenu, Mod+Escape = lock.
       Watch for Alt collisions with app shortcuts.
    4. Screen auto-locks after 5 minutes idle (xss-lock).
    5. MAC randomization is on. If a captive portal or a MAC-allowlisted
       network refuses you, that is why:
           sudo rm /etc/NetworkManager/conf.d/00-macrandomize.conf
    6. Check monitor mode on your wireless adapter before you rely on it:
           sudo airmon-ng start wlan0

  Inbound is default-deny. To expose a listener (Responder, mitm6, a
  python http.server) you must open it:
           sudo ufw allow 8000/tcp        # or: fw-open 8000/tcp

BANNER
