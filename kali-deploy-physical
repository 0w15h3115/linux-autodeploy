POLYBAR

    write_file "$POLYBAR_DIR/launch.sh" 755 <<'LAUNCH'
#!/bin/bash
killall -q polybar
while pgrep -u $UID -x polybar >/dev/null; do sleep 1; done
polybar main &
LAUNCH

    run chown -R "$REAL_USER:$REAL_USER" "$POLYBAR_DIR"
    msg "polybar config written to $POLYBAR_DIR/config.ini"
fi

# ------------------------------------------------------------------------------
# Phase: kitty -- terminal
# ------------------------------------------------------------------------------

if should_run kitty; then
    phase "Phase: kitty"

    KITTY_DIR="$USER_HOME/.config/kitty"

    # kitten themes writes dark-theme.auto.conf / light-theme.auto.conf when a
    # selection is confirmed and the OS reports a matching colour-scheme
    # preference. kitty loads whichever one matches automatically, appended
    # after kitty.conf, with no include line needed -- so a theme picked
    # interactively on a prior session silently outlives this deploy and wins
    # over every colour set below. current-theme.conf is the same hazard for
    # a manual/non-auto save. Cleared so kitty.conf is the only thing setting
    # colours, every run.
    run rm -f "$KITTY_DIR/dark-theme.auto.conf" "$KITTY_DIR/light-theme.auto.conf" \
              "$KITTY_DIR/current-theme.conf"

    write_file "$KITTY_DIR/kitty.conf" <<'KITTY'
# The desktop phase installs this face. If it is missing -- fetch failed, or
# --only kitty on a box that never ran desktop -- kitty falls back to its own
# default monospace and logs a warning, which is survivable: the prompt will
# already be in ASCII mode because the shell phase probes for the same font.
font_family      JetBrainsMono Nerd Font
font_size        11.0
shell            /usr/bin/zsh
shell_integration enabled
enable_audio_bell no
# Fully opaque -- no window transparency, so this needs no compositor to render
# correctly. The owl (background_image + background_tint below) is drawn by
# kitty itself onto its own opaque background and is unaffected by this value.
background_opacity 1.0
# Neowave Mocha -- not a catalog theme. This is the box's own scheme, the same
# one Windows Terminal runs, and the ground the whole palette is tuned against:
# background is #282828 exactly, which is what every contrast figure quoted in
# this file and in dots/shell/zsh/prompt.zsh is computed on. A catalog theme
# cannot be used here for that reason alone: it would ground somewhere else,
# and moving the background is what cost the quiet greys their contrast the
# last time it happened -- VINNY_DIM sits at 245 rather than 242 because of it.
#
# Applied directly rather than left to kitten themes because that kitten only
# writes to disk once a selection is confirmed with Enter, a manual step a
# redeploy cannot drive.
foreground              #cdd6f4
background              #282828
selection_foreground    none
selection_background    #3f3f3f
cursor                  #89dceb
cursor_text_color       #282828

#: black
color0                  #45475a
color8                  #585b70
#: red
color1                  #f38ba8
color9                  #eba0ac
#: green
color2                  #a6e3a1
color10                 #94e2d5
#: yellow
color3                  #fab387
color11                 #f9e2af
#: blue
color4                  #89dceb
color12                 #74c7ec
#: magenta
color5                  #cba6f7
color13                 #f5c2e7
#: cyan
color6                  #94e2d5
color14                 #89dceb
#: white
color7                  #bac2de
color15                 #cdd6f4

# Window borders and the bell, kept in the same palette rather than left to
# kitty's defaults, which are a saturated red/green that belong to nothing here.
active_border_color     #cba6f7
inactive_border_color   #3f3f3f
bell_border_color       #fab387

# Tab bar colors
active_tab_foreground   #282828
active_tab_background   #cba6f7
inactive_tab_foreground #bac2de
inactive_tab_background #3f3f3f
scrollback_lines 10000
open_url_with    default
detect_urls      yes
repaint_delay    10
input_delay      3
sync_to_monitor  yes

# Live font-size adjustment (Ctrl+Shift + / - / Backspace). These override
# kitty's defaults to use a 1.0pt step; Backspace resets to font_size above.
map ctrl+shift+equal         change_font_size all +1.0
map ctrl+shift+plus          change_font_size all +1.0
map ctrl+shift+kp_add        change_font_size all +1.0
map ctrl+shift+minus         change_font_size all -1.0
map ctrl+shift+kp_subtract   change_font_size all -1.0
map ctrl+shift+backspace     change_font_size all 0
KITTY

    run chown -R "$REAL_USER:$REAL_USER" "$KITTY_DIR"
    msg "kitty config written to $KITTY_DIR/kitty.conf"
fi

# ------------------------------------------------------------------------------
# Phase: shell -- append to Kali's zsh, don't replace it
# ------------------------------------------------------------------------------

if should_run shell; then
    phase "Phase: shell"

    # Kali already ships a tuned zsh (syntax highlighting, autosuggestions, a
    # good prompt) and makes it the default shell. We append a marker-guarded
    # block rather than installing Oh My Zsh over the top: faster startup, and
    # no sed against a template that may not be there. Re-running is a no-op.
    ZSHRC="$USER_HOME/.zshrc"

    if [[ ! -f "$ZSHRC" ]]; then
        warn "$ZSHRC does not exist -- creating one"
        run touch "$ZSHRC"
        run chown "$REAL_USER:$REAL_USER" "$ZSHRC"
    fi

    if grep -qF "$ZSHRC_MARKER" "$ZSHRC" 2>/dev/null; then
        msg "zshrc block already present (idempotent -- leaving it alone)"
    elif (( DRY_RUN )); then
        echo -e "${YELLOW}[dry-run]${NC} append config block to $ZSHRC"
    else
        # dots' prompt draws Nerd Fonts private-use glyphs. Ask fontconfig
        # whether anything on this box can render one of them (U+F4DF), and if
        # not, tell the prompt to use plain characters rather than leaving tofu
        # on screen. Probed here, at the point of writing, so an idempotent
        # re-run that changes nothing does not announce a decision it isn't
        # making.
        #
        # Probed rather than assumed: --only shell can run on a box where the
        # desktop phase never did, so the font may or may not be present
        # regardless of what this script would have installed. A missing
        # fc-list lands in the same branch, which is the right answer -- a box
        # without fontconfig has no font to check.
        #
        # Correct for a laptop, which renders its own terminal. It would be
        # actively wrong on a headless box reached over SSH, where the client's
        # font decides what appears; kali-deploy-remote omits it for that
        # reason.
        #
        # Command substitution, not `fc-list | grep -q`. Under `set -o pipefail`
        # that pipeline is a race: grep -q exits at the first match, fc-list
        # takes SIGPIPE, and pipefail reports the pipeline as failed -- so a box
        # with a perfectly good font intermittently gets told it has none.
        if [[ -n "$(fc-list ':charset=f4df' 2>/dev/null)" ]]; then
            PROMPT_GLYPH_NOTE="# A Nerd Font is installed, so the dots prompt keeps its glyphs."
            msg "Nerd Font coverage found -- dots prompt keeps its glyphs"
        else
            PROMPT_GLYPH_NOTE="# No font here covers the Nerd Fonts glyphs, so the dots prompt uses ASCII.
# Delete this once a patched font is installed (deploy phase: desktop).
export VINNY_ASCII=1"
            warn "no Nerd Font coverage -- dots prompt will use ASCII"
        fi

        cat >> "$ZSHRC" <<ZSHRC_BLOCK

$ZSHRC_MARKER
# Added by kali-deploy-physical. Delete this block (through the closing
# marker) to remove. Kali's own zsh config above is untouched.

export PATH="\$HOME/.local/bin:\$HOME/.cargo/bin:\$PATH"

export ROCKYOU="/usr/share/wordlists/rockyou.txt"

$PROMPT_GLYPH_NOTE

# Security
alias nse='ls /usr/share/nmap/scripts/ | grep'

# Proxychains
alias pchains='proxychains4'
alias pc='proxychains4'

# Network
alias localip="ip -4 -brief addr show scope global"
alias extip='curl -s ifconfig.me'     # what the internet sees; \`myip\` is local

# ufw is default-deny inbound on this box: a listener won't be reachable from
# the LAN until you open it. These are the two you'll actually want.
alias fw-open='sudo ufw allow'
alias fw-status='sudo ufw status verbose'

# Files. A child process cannot change its parent's directory, so lf prints
# where it ended up and the wrapper does the cd -- without this you always land
# back where you started, which is the one thing you notice missing. Named
# lfcd rather than aliased over lf so plain \`lf\` stays the real binary.
# Outside the dots guard below on purpose. That guard is for things dots does
# better, and it is allowed to be absent -- but THIS script installs lf, so its
# one usability wrapper must not hinge on a private repo whose phase is designed
# to skip. dots defines no lf integration to collide with, and even if it grows
# one, two identical functions are harmless where \`alias serve\` would not be.
lfcd() {
    local dir
    dir=\$(command lf -print-last-dir "\$@") && [[ -d "\$dir" ]] && cd "\$dir"
}

# Everything below duplicates something the dots shell kit provides, so define
# it only when dots is absent. The box ends up fully equipped either way, and
# nothing collides when dots is there.
#
# It has to be a guard rather than a deletion because the dots phase is allowed
# to fail (see below) -- and \`alias serve\` in particular would otherwise shadow
# dots' serve() permanently, since zsh resolves aliases before functions.
if [[ ! -r "\$HOME/dots/shell/zshrc" ]]; then
    export WORDLISTS="/usr/share/wordlists"
    export SECLISTS="/usr/share/seclists"
    alias serve='python3 -m http.server'
    alias ports='ss -tulanp'
    alias listening='ss -tlnp'
    alias myip="ip -4 -o addr show | awk '{print \\\$2, \\\$4}' | grep -v '^lo '"
    b64e() { echo -n "\$1" | base64; }
    b64d() { echo -n "\$1" | base64 -d; }
    urlencode() { python3 -c "import urllib.parse,sys; print(urllib.parse.quote(sys.argv[1]))" "\$1"; }
    urldecode() { python3 -c "import urllib.parse,sys; print(urllib.parse.unquote(sys.argv[1]))" "\$1"; }
fi
$ZSHRC_END_MARKER
ZSHRC_BLOCK
        chown "$REAL_USER:$REAL_USER" "$ZSHRC"
        msg "appended config block to $ZSHRC"
    fi

    # Make zsh the login shell if it is not already. Writing a ~/.zshrc for a
    # user whose shell is bash produces a box that looks untouched: the block is
    # on disk and nothing ever sources it. kitty is pointed at /usr/bin/zsh so a
    # terminal window is fine either way, but a TTY, an SSH session and anything
    # spawning $SHELL are not -- and a tty is exactly where you end up when the
    # desktop is what broke.
    #
    # Guarded rather than unconditional: chsh on a box that is already zsh is
    # noise, and a box deliberately set to something else should stay that way
    # once, not be re-argued on every run.
    CURRENT_SHELL=$(getent passwd "$REAL_USER" | cut -d: -f7)
    ZSH_PATH=$(command -v zsh 2>/dev/null)
    if [[ -z "$ZSH_PATH" ]]; then
        warn "zsh is not installed -- the block above will never be sourced"
        warn "  install it and re-run: sudo $0 --only shell"
    elif [[ "$CURRENT_SHELL" == "$ZSH_PATH" ]]; then
        msg "login shell is already $ZSH_PATH"
    elif (( DRY_RUN )); then
        echo -e "${YELLOW}[dry-run]${NC} chsh -s $ZSH_PATH $REAL_USER (currently $CURRENT_SHELL)"
    elif chsh -s "$ZSH_PATH" "$REAL_USER" 2>/dev/null; then
        msg "login shell changed from $CURRENT_SHELL to $ZSH_PATH (takes effect next login)"
    else
        warn "could not change login shell from $CURRENT_SHELL to $ZSH_PATH"
        warn "  do it by hand: chsh -s $ZSH_PATH $REAL_USER"
    fi
fi

# ------------------------------------------------------------------------------
# Phase: dots -- the personal shell kit, cloned and left to install itself
# ------------------------------------------------------------------------------

if should_run dots; then
    phase "Phase: dots"

    DOTS_SLUG="${DOTS_REPO:-owlshells/dots}"
    DOTS_DIR="$USER_HOME/dots"

    # git must never block on a prompt. Without these, a host key it has not
    # seen or a private repo over HTTPS sits waiting for input that is not
    # coming, and on a reimage that means walking back to the machine.
    DOTS_SSH_OPTS="ssh -o BatchMode=yes -o ConnectTimeout=10 -o StrictHostKeyChecking=accept-new"

    as_user() {
        sudo -u "$REAL_USER" -H env GIT_TERMINAL_PROMPT=0 \
            GIT_SSH_COMMAND="$DOTS_SSH_OPTS" "$@"
    }

    # DOTS_REPO defaults to a public repo, but a freshly imaged box may still
    # need to reach a private fork, so try authenticated transports first --
    # most deliberate first -- and fall back to a plain anonymous clone, which
    # is all a public repo ever needed. Treat total failure as a skip: a
    # missing shell kit is an inconvenience, not a reason to redo an install.
    dots_transport() {
        [[ -n "${DOTS_TOKEN:-}" ]] && { echo token; return 0; }
        as_user git ls-remote "git@github.com:${DOTS_SLUG}.git" &>/dev/null \
            && { echo ssh; return 0; }
        as_user gh auth token &>/dev/null && { echo gh; return 0; }
        as_user git ls-remote "https://github.com/${DOTS_SLUG}.git" &>/dev/null \
            && { echo public; return 0; }
        return 1
    }

    # A token goes in a per-invocation Authorization header, never in the URL.
    # A URL-embedded credential is persisted into .git/config by clone and gets
    # echoed back in git's own error messages -- and this script's transcript
    # lands in /var/log. This way the stored remote is the clean HTTPS one and
    # there is nothing to scrub afterwards.
    dots_clone() {
        local tok hdr
        case "$1" in
            ssh)
                as_user git clone --quiet "git@github.com:${DOTS_SLUG}.git" "$DOTS_DIR"
                ;;
            token|gh)
                if [[ "$1" == token ]]; then tok="$DOTS_TOKEN"; else tok=$(as_user gh auth token); fi
                hdr=$(printf 'x-access-token:%s' "$tok" | base64 -w0)
                as_user git -c "http.extraHeader=Authorization: Basic $hdr" \
                    clone --quiet "https://github.com/${DOTS_SLUG}.git" "$DOTS_DIR"
                ;;
            public)
                as_user git clone --quiet "https://github.com/${DOTS_SLUG}.git" "$DOTS_DIR"
                ;;
        esac
    }

    dots_run_install() {
        if [[ ! -x "$DOTS_DIR/install.sh" ]]; then
            warn "no install.sh in $DOTS_DIR -- clone looks wrong, leaving it"
            return 1
        fi
        chown -R "$REAL_USER:$REAL_USER" "$DOTS_DIR" 2>/dev/null
        if as_user "$DOTS_DIR/install.sh" >/dev/null; then
            msg "dots installed (~/.bash_aliases, ~/.tmux.conf, ~/.zshrc hook)"
        else
            warn "dots install.sh reported a problem -- shell kit may be partial"
            return 1
        fi
        # Give recall something to work with on the very first shell.
        [[ -x "$DOTS_DIR/tools/backfill-index.sh" ]] \
            && as_user "$DOTS_DIR/tools/backfill-index.sh" >/dev/null 2>&1

        # Publish the lock/login image.
        #
        # The owl, deliberately, and NOT terminal/wallpaper.png -- that one is
        # the Ghost in the Shell card and belongs to the desktop. The two
        # screens you are shut out behind get the bird. They are different
        # pictures on purpose, so swapping this path back to the wallpaper would
        # look like a tidy-up and would be wrong.
        #
        # dots' install.sh composites it (owl on #282828, at screen proportions,
        # lifted clear of where the login box lands) and leaves it in
        # ~/.local/share/dots. It cannot do the next bit: the greeter runs as
        # the `lightdm` user, which cannot read this home at all, so a
        # background pointed anywhere under ~/ is silently never drawn. Copied
        # rather than symlinked for the same reason -- a link into a home it
        # cannot traverse is no better.
        #
        # This is the dots phase and not the i3 phase because this is where the
        # image exists. The i3 phase has already written both configs pointing
        # at the published path; if this phase skips, or Pillow is missing so
        # dots never generated it, both fall back to flat #282828 rather than
        # breaking.
        local owl="$USER_HOME/.local/share/dots/owl-lock.png"
        if [[ -f "$owl" ]]; then
            install -d -m 755 /usr/share/backgrounds/owlshells
            if install -m 644 "$owl" /usr/share/backgrounds/owlshells/lock.png; then
                msg "lock/login image published to /usr/share/backgrounds/owlshells/lock.png"
            else
                warn "could not publish the lock image -- greeter stays on flat colour"
            fi
        else
            warn "no owl-lock.png from dots (Pillow missing?) -- lock and greeter stay flat"
            warn "  install python3-pil and re-run: sudo $0 --only dots"
        fi
        return 0
    }

    if (( DRY_RUN )); then
        echo -e "${YELLOW}[dry-run]${NC} clone/update ${DOTS_SLUG} into ${DOTS_DIR}, then run its install.sh"
    elif ! command -v git &>/dev/null; then
        # Only reachable via --only dots on a bare box; the base phase installs
        # git long before this normally runs. Still worth a way forward.
        warn "git is not installed -- skipping dots"
        warn "  install it and retry: sudo $0 --only dots"
    elif [[ -d "$DOTS_DIR/.git" ]]; then
        msg "dots already present -- updating"
        as_user git -C "$DOTS_DIR" pull --ff-only &>/dev/null \
            && msg "dots updated" \
            || warn "could not fast-forward $DOTS_DIR (local changes?) -- installing what is there"
        dots_run_install
    elif [[ -e "$DOTS_DIR" ]]; then
        warn "$DOTS_DIR exists but is not a git checkout -- leaving it alone"
    else
        DOTS_TR=$(dots_transport) || DOTS_TR=""
        if [[ -z "$DOTS_TR" ]]; then
            warn "could not reach ${DOTS_SLUG} (tried token/ssh/gh auth, and an"
            warn "  anonymous clone) -- skipping. If it's a private fork, finish"
            warn "  it later with:"
            warn "    sudo DOTS_TOKEN=<token> $0 --only dots"
            warn "  (or restore an SSH key, or install gh and \`gh auth login\` --"
            warn "   gh ships from GitHub's apt repo, not Kali's, so it is not here)"
        elif dots_clone "$DOTS_TR"; then
            msg "cloned ${DOTS_SLUG} over ${DOTS_TR}"
            dots_run_install
        else
            warn "clone of ${DOTS_SLUG} over ${DOTS_TR} failed -- skipping (run unaffected)"
        fi
    fi
fi

# ------------------------------------------------------------------------------
# Phase: wordlists
# ------------------------------------------------------------------------------

if should_run wordlists; then
    phase "Phase: wordlists"

    # Kali ships rockyou gzipped; decompress in place, keeping the .gz.
    if [[ -f "$WORDLIST_DIR/rockyou.txt" ]]; then
        msg "rockyou.txt already present"
    elif [[ -f "$WORDLIST_DIR/rockyou.txt.gz" ]]; then
        run gunzip -k "$WORDLIST_DIR/rockyou.txt.gz" && msg "decompressed rockyou.txt"
    else
        warn "rockyou.txt(.gz) not found (is the 'wordlists' package installed?)"
    fi

    if [[ -d /usr/share/seclists ]]; then
        msg "SecLists present at /usr/share/seclists"
    else
        warn "SecLists not found -- 'apt install seclists'"
    fi
fi

# ------------------------------------------------------------------------------
# Verification
# ------------------------------------------------------------------------------

phase "Verification"

if (( DRY_RUN )); then
    msg "Dry run complete -- nothing was changed."
    exit 0
fi

check() {
    if command -v "$1" &>/dev/null; then
        echo -e "${GREEN}/${NC} $1"
    else
        echo -e "${RED}x${NC} $1"
    fi
}

echo ""
echo "Tools:"
for c in "${VERIFY_BINS_TOOLS[@]}"; do
    check "$c"
done

echo ""
echo "Desktop:"
for c in "${VERIFY_BINS_DESKTOP[@]}"; do
    check "$c"
done

echo ""
echo "Wordlists:"
[[ -f "$WORDLIST_DIR/rockyou.txt" ]] \
    && echo -e "${GREEN}/${NC} rockyou.txt" || echo -e "${RED}x${NC} rockyou.txt"
[[ -d /usr/share/seclists ]] \
    && echo -e "${GREEN}/${NC} SecLists"   || echo -e "${RED}x${NC} SecLists"

echo ""
echo "Hardening:"
if command -v ufw &>/dev/null; then
    echo "  ufw: $(ufw status 2>/dev/null | head -1)"
fi
# ssh and bluetooth are listed because this phase deliberately leaves them
# running: seeing them enabled here is the expected result, not a finding.
for u in ssh avahi-daemon cups bluetooth; do
    state=$(systemctl is-enabled "$u" 2>/dev/null || echo "n/a")
    echo "  $u: $state"
done

# Read the MAC mode back off disk rather than echoing $MAC_MODE: the summary
# runs even when the harden phase was skipped, and what's on disk is what
# NetworkManager will act on. `random` here is the first thing to check if a
# long-lived connection on this box keeps dropping.
if [[ -f "$MACCONF" ]]; then
    echo "  MAC: $(awk -F= '/^ethernet.cloned-mac-address/ {print $2}' \
                  "$MACCONF" 2>/dev/null || echo "unreadable")"
else
    echo "  MAC: stock (hardware MAC, no cloning)"
fi

# The real hardening deliverable: what is actually listening, right now. Read
# this rather than trusting the toggles above.
echo ""
echo "Listening sockets (should be loopback-only on a laptop):"
if command -v ss &>/dev/null; then
    ss -tulpnH 2>/dev/null | awk '{printf "  %-6s %-24s %s\n", $1, $5, $7}' \
        || echo "  (ss failed)"
else
    echo "  (ss not available)"
fi

cat <<BANNER

==============================================
  Deploy complete
==============================================

  Log: $LOGFILE

  Verify on the hardware -- these cannot be checked from a script:

    1. Log out. At the LightDM greeter, pick the i3 session from the
       session menu. Kali defaults to Xfce, so i3 is NOT automatic.
    2. Confirm polybar appears at the top and the battery module shows a
       percentage (it is pinned to BAT0 -- check 'ls /sys/class/power_supply'
       if it stays blank).
    3. Mod is the Windows/Super key. Mod+Return = kitty, Mod+d = dmenu,
       Mod+Escape = lock. If Super does nothing, check the keyboard has one
       and that no other grabber (a VM client, a KVM switch) is eating it.
    4. kitty is fully opaque and needs no compositor to render correctly. The
       owl behind the text is drawn by kitty itself onto its own background, so
       it survives picom being down. If windows have no shadows and i3 looks
       flat, that is the compositor, not kitty:
           pgrep -a picom
       If it is not running, start it by hand and read the error (a driver with
       no usable GLX backend is the usual one, and 'picom --backend xrender'
       is the fallback).
    5. Mod+Escape locks the screen. There is no idle timeout -- it locks on
       suspend and when you ask, and never in the middle of a job.
    6. Check monitor mode on your wireless adapter before you rely on it:
           sudo airmon-ng start wlan0

  ufw is NOT enabled, on purpose: a default-deny inbound policy lets every
  listener here (Responder, ntlmrelayx, a msfconsole handler, a python
  http.server) bind and then catch nothing. If an engagement wants a policy,
  set it deliberately -- fw-status shows where you stand, fw-open adds a rule.

  MAC cloning is off by default. --mac-stable gives a per-network MAC;
  --mac-random gives a fresh one per activation, which drops any long-lived
  connection -- including a remote-access agent's -- on every reconnect.
  On a VM, either one needs MAC spoofing enabled on the hypervisor's vSwitch
  or the guest loses the network entirely.

BANNER
