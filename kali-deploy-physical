if should_run polybar; then
    phase "Phase: polybar"

    POLYBAR_DIR="$USER_HOME/.config/polybar"

    # Font Awesome lines from the Ubuntu recipe are dropped: every module prefix
    # here is plain ASCII ("CPU ", "MEM "), so the glyph fonts were never used,
    # and asking for "Font Awesome 6" against Kali's FA4/5 package just fills the
    # polybar log with font errors.
    write_file "$POLYBAR_DIR/config.ini" <<'POLYBAR'
[colors]
; Taken from the dots prompt palette (shell/zsh/prompt.zsh) rather than from
; polybar's Tomorrow-Night default, so the bar, the terminal and the prompt read
; as one thing. The amber #F0C674 and grey #707880 that used to be here belonged
; to neither.
;
; primary is the seafoam the prompt gives a clean branch -- VINNY_BRANCH, taken
; as-is rather than lightened, so the bar's accent is a colour that already
; exists on screen instead of a near-match to one. It was the prompt's lavender
; first, which is right in a prompt where it is the only hue-distinct member and
; reads pink stretched across a bar; i3 has since taken that lavender for
; client.urgent, where being the odd one out is the job.
;
; secondary is the dim grey rather than the path's blue-grey. Those two are
; near-twins about ten degrees apart -- fine in the prompt, where the branch
; glyph always falls between them, but the focused and visible workspace
; underlines sit directly adjacent, which is the one arrangement prompt.zsh says
; they must never be in. Dropping secondary to grey leaves seafoam as the only
; accent on the bar: the focused workspace is coloured, everything else is quiet.
; It does mean secondary and disabled now carry the same value -- "not focused"
; and "not present" look alike, which is correct here; both are things the eye
; should skip.
;
; alert is pinned to the prompt's true red for the reason it is pinned there: a
; muted red against a palette this quiet whispers, and an alert is the last thing
; that should.
background = #282828
background-alt = #3A3D42
foreground = #DADADA
primary = #83A0A4
secondary = #8A8A8A
alert = #FF2D2D
disabled = #8A8A8A

[bar/main]
width = 100%
height = 24pt
radius = 0
background = ${colors.background}
foreground = ${colors.foreground}
line-size = 3pt
border-size = 0
padding-left = 0
padding-right = 1
module-margin = 1
separator = |
separator-foreground = ${colors.disabled}
font-0 = monospace;2
modules-left = i3 xwindow
modules-center = date
modules-right = wlan network cpu memory battery
cursor-click = pointer
cursor-scroll = ns-resize
enable-ipc = true

[module/i3]
type = internal/i3
pin-workspaces = true
show-urgent = true
strip-wsnumbers = true
index-sort = true
format = <label-state> <label-mode>
label-focused = %index%
label-focused-background = ${colors.background-alt}
