#!/bin/bash

# Kali Headless Security Tools Deploy Script (kali-autodeploy)
#
# A reimagining of the Ubuntu v5 recipe for a *headless* Kali box you reach
# from anywhere over Tailscale + SSH, with tmux for multiple terminal windows.
#
# Deliberately NOT installed: i3 / polybar / kitty GUI. There is no display on a
# headless box, so the graphical window manager is dropped entirely. tmux is the
# multi-window interface; zsh is carried over from v5 because it's terminal-side.
#
# Installs (all from native Kali apt repos — no /opt venv, no from-source builds):
#   nmap/ncat, binwalk, smbclient, hashcat, proxychains4, dns tools, nbtscan,
#   enum4linux(-ng), impacket-scripts, netexec, responder, mitm6, certipy-ad,
#   bloodhound.py, seclists, wordlists, java (headless), zsh+oh-my-zsh, tmux
#
# Access layer:
#   - Tailscale (WireGuard mesh; no public port exposure)
#   - Tailscale SSH as the primary auth path (identity/ACL-gated, key rotation
#     handled for you), with a hardened OpenSSH as fallback
#   - ufw: default-deny inbound, allow only over the tailscale0 interface
#
# Runtime knobs (all optional environment variables):
#   TS_AUTHKEY          reusable Tailscale auth key -> unattended join.
#                       If unset, the script falls back to interactive login.
#   TS_ADVERTISE_TAGS   e.g. "tag:server,tag:kali" -> lands the node with ACL
#                       tags automatically (scales to many boxes).
#   SSH_PUBKEY          an authorized public key to install for the OpenSSH
#                       fallback path (e.g. "ssh-ed25519 AAAA... you@host").
#   SKIP_TAILSCALE=1    don't touch Tailscale (you'll join it yourself).
#   SKIP_UFW=1          don't configure/enable the firewall.
#
# Design notes: like v5, an installer should keep going when an optional piece
# fails rather than aborting. We keep -u and pipefail but not -e, make every
# fallible step tolerant, and guard the lockout-prone steps (SSH hardening, ufw)
# so a box whose Tailscale/keys didn't come up is never cut off from itself.

set -uo pipefail

# ------------------------------------------------------------------------------
# Configuration
# ------------------------------------------------------------------------------

readonly WORDLIST_DIR="/usr/share/wordlists"

# Tailscale's apt repo is published per Debian codename. Kali rolling tracks
# Debian testing, but the 'bookworm' (Debian 12 stable) channel is the
# community-standard, compatible choice for Kali and doesn't churn.
readonly TS_DEBIAN_CODENAME="bookworm"

# Colors
readonly RED='\033[0;31m'
readonly GREEN='\033[0;32m'
readonly YELLOW='\033[1;33m'
readonly NC='\033[0m'

# ------------------------------------------------------------------------------
# Helper Functions
# ------------------------------------------------------------------------------

# warn/err go to stderr so they don't get captured by $(...) command
# substitutions (e.g. get_real_user) and so they're visible on the error path.
msg()     { echo -e "${GREEN}[+]${NC} $1"; }
warn()    { echo -e "${YELLOW}[*]${NC} $1" >&2; }
err()     { echo -e "${RED}[!]${NC} $1" >&2; }

get_real_user() {
    if [[ -n "${SUDO_USER:-}" ]] && [[ "$SUDO_USER" != "root" ]]; then
        echo "$SUDO_USER"
    else
        err "This script must be run with sudo, not as root directly"
        err "Usage: sudo $0"
        exit 1
    fi
}

get_user_home() {
    getent passwd "$1" | cut -d: -f6
}

run_as_user() {
    local user="$1"
    shift
    su - "$user" -c "$*"
}

# True if apt has an installation candidate for the package on THIS release.
# Lets us skip packages that were renamed/removed instead of aborting the batch.
apt_available() {
    local cand
    cand=$(apt-cache policy "$1" 2>/dev/null | awk '/Candidate:/ {print $2}')
    [[ -n "$cand" && "$cand" != "(none)" ]]
}

# Install a list of apt packages, falling back to one-by-one so that a single
# unavailable package doesn't take down the entire batch.
apt_install() {
    if apt-get install -y "$@"; then
        return 0
    fi
    warn "Bulk apt install failed; retrying packages individually..."
    for pkg in "$@"; do
        if apt_available "$pkg"; then
            apt-get install -y "$pkg" || warn "Could not install '$pkg' (skipping)"
        else
            warn "Package '$pkg' not available on this release (skipping)"
        fi
    done
}

# Install the FIRST package from the list that this release actually offers.
apt_install_first() {
    local label="$1"; shift
    local pkg
    for pkg in "$@"; do
        if apt_available "$pkg"; then
            if apt-get install -y "$pkg"; then
                msg "$label: installed '$pkg'"
                return 0
            fi
        fi
    done
    warn "$label: none of [$*] are available on this release (skipping)"
    return 1
}

# ------------------------------------------------------------------------------
# Pre-flight Checks
# ------------------------------------------------------------------------------

if [[ $EUID -ne 0 ]]; then
    err "This script must be run with sudo"
    exit 1
fi

# get_real_user's `exit 1` only exits the command-substitution subshell, so we
# must check its status and exit the parent ourselves (no `set -e` to do it).
REAL_USER=$(get_real_user) || exit 1
USER_HOME=$(get_user_home "$REAL_USER")

if [[ -z "$REAL_USER" || -z "$USER_HOME" ]]; then
    err "Could not determine the target user or home directory"
    exit 1
fi

msg "Deploying headless Kali toolkit for user: $REAL_USER"
msg "User home directory: $USER_HOME"

# ------------------------------------------------------------------------------
# Phase 1: System + Security Packages (apt)
# ------------------------------------------------------------------------------

msg "Updating package lists..."
apt-get update || true

msg "Installing packages from Kali repos..."
apt_install \
    curl \
    wget \
    git \
    jq \
    unzip \
    ca-certificates \
    gnupg \
    python3 \
    python3-pip \
    pipx \
    \
    zsh \
    tmux \
    openssh-server \
    ufw \
    \
    nmap \
    binwalk \
    smbclient \
    hashcat \
    proxychains4 \
    net-tools \
    dnsutils \
    dnsrecon \
    dnsenum \
    nbtscan \
    enum4linux \
    enum4linux-ng \
    \
    python3-impacket \
    impacket-scripts \
    netexec \
    responder \
    mitm6 \
    certipy-ad \
    bloodhound.py \
    \
    seclists \
    wordlists

# Java runtime (headless — no GUI deps). default-jre-headless tracks the current
# default JDK; the explicit names are only fallbacks.
apt_install_first "Java runtime (headless)" \
    default-jre-headless \
    openjdk-21-jre-headless \
    openjdk-17-jre-headless

# ------------------------------------------------------------------------------
# Phase 2: Tailscale (network layer)
# ------------------------------------------------------------------------------

if [[ "${SKIP_TAILSCALE:-0}" == "1" ]]; then
    warn "SKIP_TAILSCALE=1 set — not installing or joining Tailscale"
else
    msg "Installing Tailscale..."
    if ! command -v tailscale &>/dev/null; then
        mkdir -p /usr/share/keyrings
        # Add Tailscale's signed apt repo (bookworm channel; see note above).
        if curl -fsSL "https://pkgs.tailscale.com/stable/debian/${TS_DEBIAN_CODENAME}.noarmor.gpg" \
                -o /usr/share/keyrings/tailscale-archive-keyring.gpg \
           && curl -fsSL "https://pkgs.tailscale.com/stable/debian/${TS_DEBIAN_CODENAME}.tailscale-keyring.list" \
                -o /etc/apt/sources.list.d/tailscale.list; then
            apt-get update || true
            apt-get install -y tailscale || warn "Tailscale apt install failed"
        else
            warn "Could not add Tailscale repo; trying official install script..."
            curl -fsSL https://tailscale.com/install.sh | sh || warn "Tailscale install failed"
        fi
    fi

    # Bring the daemon up (best-effort; systemd may be absent in some environments).
    systemctl enable --now tailscaled 2>/dev/null \
        || warn "Could not enable tailscaled via systemd (start it manually if needed)"

    if command -v tailscale &>/dev/null; then
        # --ssh makes Tailscale itself the SSH auth path (identity + ACL gated).
        TS_UP_FLAGS=(--ssh --accept-dns=true)
        if [[ -n "${TS_ADVERTISE_TAGS:-}" ]]; then
            TS_UP_FLAGS+=(--advertise-tags="${TS_ADVERTISE_TAGS}")
        fi

        if [[ -n "${TS_AUTHKEY:-}" ]]; then
            msg "Joining tailnet with provided auth key (unattended)..."
            tailscale up "${TS_UP_FLAGS[@]}" --authkey="${TS_AUTHKEY}" \
                || warn "tailscale up failed (check the auth key / its expiry & tags)"
        else
            msg "No TS_AUTHKEY set — starting interactive login."
            warn "Open the URL below in a browser to authorize this machine:"
            tailscale up "${TS_UP_FLAGS[@]}" \
                || warn "tailscale up did not complete (re-run: sudo tailscale up --ssh)"
        fi

        msg "Reminder: Tailscale SSH also requires an ACL rule granting SSH to"
        msg "this node in your tailnet policy (admin console → Access Controls)."
    fi
fi

# ------------------------------------------------------------------------------
# Phase 3: OpenSSH hardening (fallback path) + install optional pubkey
# ------------------------------------------------------------------------------

msg "Hardening OpenSSH (fallback to Tailscale SSH)..."

# Install a provided public key so the OpenSSH fallback has a way in.
if [[ -n "${SSH_PUBKEY:-}" ]]; then
    SSH_DIR="$USER_HOME/.ssh"
    mkdir -p "$SSH_DIR"
    touch "$SSH_DIR/authorized_keys"
    if ! grep -qxF "$SSH_PUBKEY" "$SSH_DIR/authorized_keys"; then
        echo "$SSH_PUBKEY" >> "$SSH_DIR/authorized_keys"
        msg "Installed SSH_PUBKEY into $SSH_DIR/authorized_keys"
    fi
    chmod 700 "$SSH_DIR"
    chmod 600 "$SSH_DIR/authorized_keys"
    chown -R "$REAL_USER:$REAL_USER" "$SSH_DIR"
fi

# Decide whether it's safe to turn OFF password auth. It is safe if the user has
# an authorized key, OR if Tailscale SSH is already up (guaranteed way back in).
# Otherwise we'd risk locking the box out of itself, so we keep passwords on.
have_authorized_key=false
[[ -s "$USER_HOME/.ssh/authorized_keys" ]] && have_authorized_key=true
tailscale_up=false
tailscale status &>/dev/null && tailscale_up=true

SSHD_DROPIN="/etc/ssh/sshd_config.d/99-hardening.conf"
mkdir -p /etc/ssh/sshd_config.d

if $have_authorized_key || $tailscale_up; then
    cat > "$SSHD_DROPIN" << 'SSHD'
# Managed by kali-autodeploy — hardened OpenSSH (fallback to Tailscale SSH)
PermitRootLogin no
PasswordAuthentication no
KbdInteractiveAuthentication no
PubkeyAuthentication yes
X11Forwarding no
AllowAgentForwarding no
SSHD
    msg "OpenSSH: password auth DISABLED (key/Tailscale access confirmed)"
else
    cat > "$SSHD_DROPIN" << 'SSHD'
# Managed by kali-autodeploy — partial hardening only.
# Password auth left ENABLED because no SSH key was installed and Tailscale was
# not up at deploy time — disabling it would risk locking you out. Install a key
# (re-run with SSH_PUBKEY=...) or bring up Tailscale, then re-run to fully harden.
PermitRootLogin no
X11Forwarding no
AllowAgentForwarding no
SSHD
    warn "OpenSSH: NO key installed and Tailscale not up — leaving password auth ON"
    warn "Re-run with SSH_PUBKEY='ssh-ed25519 ...' (or after Tailscale is up) to fully harden"
fi

systemctl enable ssh 2>/dev/null || warn "Could not enable ssh service via systemd"
# Reload (not restart) so the current session is never dropped.
if sshd -t 2>/dev/null; then
    systemctl reload ssh 2>/dev/null || systemctl restart ssh 2>/dev/null \
        || warn "Could not reload sshd; apply manually"
else
    warn "sshd config test failed — NOT reloading (check $SSHD_DROPIN)"
fi

# ------------------------------------------------------------------------------
# Phase 4: Firewall (ufw) — inbound only over the tailnet
# ------------------------------------------------------------------------------

if [[ "${SKIP_UFW:-0}" == "1" ]]; then
    warn "SKIP_UFW=1 set — not configuring the firewall"
elif ! command -v ufw &>/dev/null; then
    warn "ufw not installed — skipping firewall configuration"
else
    msg "Configuring ufw (default-deny inbound; allow the tailscale0 interface)..."
    ufw default deny incoming || true
    ufw default allow outgoing || true
    ufw allow in on tailscale0 || true

    # Only ENABLE the firewall if Tailscale is up — otherwise a box whose only
    # current access is a non-tailnet SSH session could be cut off. ufw permits
    # already-established connections, but new non-tailnet logins would be denied.
    if $tailscale_up; then
        ufw --force enable || warn "Could not enable ufw"
        msg "ufw enabled — inbound allowed only over tailscale0"
    else
        warn "Tailscale not up — rules staged but ufw left DISABLED to avoid lockout"
        warn "Once on the tailnet, enable with: sudo ufw --force enable"
    fi
fi

# ------------------------------------------------------------------------------
# Phase 5: tmux configuration
# ------------------------------------------------------------------------------

msg "Configuring tmux..."

cat > "$USER_HOME/.tmux.conf" << 'TMUX'
# ~/.tmux.conf — kali-autodeploy (headless multi-window over SSH)
# Prefix stays the default Ctrl-b so every tutorial you read matches.

# Quality of life
set -g mouse on                 # click panes, drag borders, scroll with the wheel
set -g history-limit 100000     # deep scrollback for long tool output
set -g base-index 1             # windows start at 1 (matches the number row)
setw -g pane-base-index 1
set -g renumber-windows on      # keep window numbers gapless when you close one
set -g allow-rename off         # don't let programs rename your windows
set -sg escape-time 10          # snappy Esc (helps vim inside tmux)
set -g focus-events on

# True color / 256-color for a headless SSH terminal
set -g default-terminal "tmux-256color"
set -ga terminal-overrides ",*256col*:Tc"

# Intuitive splits: prefix + | (vertical), prefix + - (horizontal),
# both opening in the current pane's directory.
bind | split-window -h -c "#{pane_current_path}"
bind - split-window -v -c "#{pane_current_path}"
unbind '"'
unbind %

# Vim-style pane navigation: prefix + h/j/k/l
bind h select-pane -L
bind j select-pane -D
bind k select-pane -U
bind l select-pane -R

# Reload config: prefix + r
bind r source-file ~/.tmux.conf \; display "tmux config reloaded"

# --- Status bar (amber-on-dark, echoing the old polybar palette) ---
set -g status-interval 5
set -g status-style bg=colour235,fg=colour136
set -g status-left "#[fg=colour136,bold] #S #[default]"
set -g status-left-length 30
set -g status-right "#[fg=colour108]#(whoami)@#h #[fg=colour136]%Y-%m-%d %H:%M "
set -g status-right-length 60
setw -g window-status-current-style fg=colour136,bg=colour238,bold
setw -g window-status-current-format " #I:#W "
setw -g window-status-format " #I:#W "
TMUX

chown "$REAL_USER:$REAL_USER" "$USER_HOME/.tmux.conf"

# ------------------------------------------------------------------------------
# Phase 6: Shell configuration (Zsh + Oh My Zsh)
# ------------------------------------------------------------------------------

msg "Configuring Zsh..."

# Kali already defaults new users to zsh, but ensure it for this user.
chsh -s /usr/bin/zsh "$REAL_USER" 2>/dev/null || warn "Could not set default shell to zsh"

# Install Oh My Zsh for the user (backs up Kali's default .zshrc first).
if [[ ! -d "$USER_HOME/.oh-my-zsh" ]]; then
    [[ -f "$USER_HOME/.zshrc" ]] && cp "$USER_HOME/.zshrc" "$USER_HOME/.zshrc.kali-default"
    msg "Installing Oh My Zsh..."
    run_as_user "$REAL_USER" '
        export RUNZSH=no CHSH=no KEEP_ZSHRC=no
        sh -c "$(curl -fsSL https://raw.githubusercontent.com/ohmyzsh/ohmyzsh/master/tools/install.sh)"
    ' || {
        warn "Oh My Zsh install script failed, trying direct clone..."
        git clone --depth 1 https://github.com/ohmyzsh/ohmyzsh.git "$USER_HOME/.oh-my-zsh"
        cp "$USER_HOME/.oh-my-zsh/templates/zshrc.zsh-template" "$USER_HOME/.zshrc"
        chown -R "$REAL_USER:$REAL_USER" "$USER_HOME/.oh-my-zsh" "$USER_HOME/.zshrc"
    }
fi

if [[ -f "$USER_HOME/.zshrc" ]]; then
    cp "$USER_HOME/.zshrc" "$USER_HOME/.zshrc.backup"

    sed -i 's/ZSH_THEME="robbyrussell"/ZSH_THEME="agnoster"/' "$USER_HOME/.zshrc"
    sed -i 's/plugins=(git)/plugins=(git docker python pip nmap ssh-agent sudo tmux colored-man-pages command-not-found extract z)/' "$USER_HOME/.zshrc"

    cat >> "$USER_HOME/.zshrc" << 'ZSHRC'

# --- Security Tools Configuration (kali-autodeploy) ---

export PATH="$HOME/.local/bin:$HOME/.cargo/bin:$PATH"

# Aliases - Security
alias nse='ls /usr/share/nmap/scripts/ | grep'
alias serve='python3 -m http.server'

# Aliases - Proxychains
alias pchains='proxychains4'
alias pc='proxychains4'

# Aliases - Network
alias ports='netstat -tulanp'
alias listening='netstat -tlnp'
alias myip='curl -s ifconfig.me'
alias tsip='tailscale ip -4'          # this box's tailnet IP

# Aliases - tmux (multi-window over SSH)
alias ta='tmux attach -t'             # ta main
alias tn='tmux new -s'                # tn main
alias tl='tmux ls'
alias tk='tmux kill-session -t'       # tk main

# Wordlists (Kali paths)
export WORDLISTS="/usr/share/wordlists"
export SECLISTS="/usr/share/seclists"
export ROCKYOU="/usr/share/wordlists/rockyou.txt"

# Functions
b64e() { echo -n "$1" | base64; }
b64d() { echo -n "$1" | base64 -d; }
urlencode() { python3 -c "import urllib.parse; print(urllib.parse.quote('$1'))"; }
urldecode() { python3 -c "import urllib.parse; print(urllib.parse.unquote('$1'))"; }

# Auto-attach a persistent tmux session on interactive SSH login, so a dropped
# connection never kills your work — you reconnect straight back into it. Guards:
# only for interactive SSH shells that aren't already inside tmux. Delete this
# block if you'd rather start tmux by hand.
if [[ -n "$SSH_CONNECTION" && -z "$TMUX" && $- == *i* ]] && command -v tmux &>/dev/null; then
    tmux attach -t main 2>/dev/null || tmux new -s main
fi
ZSHRC

    chown "$REAL_USER:$REAL_USER" "$USER_HOME/.zshrc"
fi

# ------------------------------------------------------------------------------
# Phase 7: Wordlists
# ------------------------------------------------------------------------------

msg "Preparing wordlists..."

# Kali ships rockyou gzipped; decompress it in place (keep the .gz).
if [[ -f "$WORDLIST_DIR/rockyou.txt.gz" && ! -f "$WORDLIST_DIR/rockyou.txt" ]]; then
    gunzip -k "$WORDLIST_DIR/rockyou.txt.gz" && msg "Decompressed rockyou.txt"
elif [[ -f "$WORDLIST_DIR/rockyou.txt" ]]; then
    msg "rockyou.txt already present"
else
    warn "rockyou.txt(.gz) not found (is the 'wordlists' package installed?)"
fi

# ------------------------------------------------------------------------------
# Verification
# ------------------------------------------------------------------------------

echo ""
echo "=============================================="
echo "  Deploy Complete (headless Kali)"
echo "=============================================="
echo ""
echo "User: $REAL_USER"
echo ""

check() {
    if command -v "$1" &>/dev/null; then
        echo -e "${GREEN}✓${NC} $1"
    else
        echo -e "${RED}✗${NC} $1"
    fi
}

echo "Security tools:"
check nmap
check ncat
check binwalk
check smbclient
check hashcat
check proxychains4
check enum4linux
check netexec
check responder
check mitm6
check certipy
check bloodhound-python
check impacket-ntlmrelayx

echo ""
echo "Access layer:"
check tmux
check zsh
check sshd
check tailscale
if command -v tailscale &>/dev/null; then
    if tailscale status &>/dev/null; then
        echo -e "  ${GREEN}Tailscale IP:${NC} $(tailscale ip -4 2>/dev/null | head -1)"
    else
        echo -e "  ${YELLOW}Tailscale installed but not yet logged in — run: sudo tailscale up --ssh${NC}"
    fi
fi
if command -v ufw &>/dev/null; then
    echo -e "  ufw: $(ufw status 2>/dev/null | head -1)"
fi

echo ""
echo "Wordlists:"
[[ -f "$WORDLIST_DIR/rockyou.txt" ]] && echo -e "${GREEN}✓${NC} rockyou.txt" || echo -e "${RED}✗${NC} rockyou.txt"
[[ -d "$SECLISTS" || -d "$WORDLIST_DIR/seclists" ]] && echo -e "${GREEN}✓${NC} SecLists" || echo -e "${RED}✗${NC} SecLists"

echo ""
echo "=============================================="
echo "  How to connect"
echo "=============================================="
echo ""
echo "From any device on your tailnet:"
echo "  tailscale ssh $REAL_USER@<this-hostname>     # Tailscale SSH (primary)"
echo "  ssh $REAL_USER@<tailscale-ip>                # OpenSSH fallback"
echo ""
echo "Then, for multiple terminal windows:"
echo "  tmux new -s main       # start (or 'ta main' to re-attach after a drop)"
echo "  Ctrl-b c   new window     Ctrl-b n/p  next/prev window"
echo "  Ctrl-b |   split vert      Ctrl-b -   split horiz"
echo "  Ctrl-b d   detach (leaves everything running on the box)"
echo ""
echo "Your shell auto-attaches to a 'main' tmux session on SSH login."
echo "See TMUX-TAILSCALE-CHEATSHEET.md for the full reference."
echo ""
