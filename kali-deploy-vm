#!/bin/bash

# Kali VM Deploy Script (kali-deploy-vm)
#
# For Kali running as a guest VM -- Hyper-V specifically -- that you reach with
# a remote-desktop agent (ScreenConnect / ConnectWise Control) rather than by
# sitting at it.
#
# This is deliberately NOT kali-deploy-physical with the laptop bits removed.
# A guest reached over a screen-scraping remote agent has different constraints
# than a laptop you carry, and three of them are load-bearing:
#
#   1. No compositor. A Hyper-V guest has no hardware GLX -- Mesa falls back to
#      llvmpipe, and `picom --backend glx` fails after it has already mapped the
#      composite overlay window. The overlay is full-screen, opaque, and (because
#      picom never got far enough to make it input-transparent) eats every
#      keystroke. i3 is fine underneath and really did spawn your terminal; you
#      just cannot see or reach it. That is the "terminals don't render and I
#      can't type into them" failure, and it is why this script starts no
#      compositor at all. See --compositor if you want one anyway.
#
#   2. No idle lock, no DPMS blanking. On a remote box a blanked screen is
#      indistinguishable from a hung one, and an idle lock you did not ask for
#      means typing a password down a laggy link to get back to a session you
#      never left. Manual lock is still bound ($mod+Escape).
#
#   3. Nothing that assumes hardware. No battery module, no backlight keys --
#      a Hyper-V guest has neither, and polybar pinned to a BAT0 that does not
#      exist is a dead module you look at all day. These are PROBED, not
#      assumed, so this script is still correct on a laptop.
#
# Tools are NOT installed. A stock Kali image already ships kali-linux-default;
# this script is configuration only. Use kali-deploy-physical if you want the
# kali-tools-* metapackage set.
#
# Usage:
#   sudo ./kali-deploy-vm [options]
#
#   --dry-run          show what would happen; change nothing
#   --autologin        log the user straight into i3 with no greeter. Off by
#                      default -- see the desktop phase for the tradeoff.
#   --compositor <b>   start picom with backend <b> (xrender|glx|egl).
#                      Default: none. xrender is the only one that works on a
#                      guest with no hardware GL.
#   --skip <phase>     skip a phase (repeatable)
#   --only <phase>     run only these phases (repeatable)
#   --list-phases      print phase names and exit
#   --print-packages   print every package this script can install
#   --print-checked-binaries
#                      print every binary the verification pass ticks
#   -h, --help         this message
#
# Environment:
#   SC_URL             ScreenConnect ClientSetup URL from your instance, e.g.
#                      https://<you>.screenconnect.com/Bin/ConnectWiseControl.ClientSetup.deb?e=Access&y=Guest&t=
#                      Copy it out of the "Build Installer" dialog -- it carries
#                      the instance fingerprint, so a generic URL will not work.
#   SC_DEB             path to an already-downloaded .deb. Takes precedence over
#                      SC_URL. Use this on a box with no route to the instance.
#
#   With neither set the screenconnect phase SKIPS and prints what to do. It is
#   never a reason for the run to fail.
#
# Phases: base hyperv desktop i3 polybar kitty shell screenconnect
#
# Design notes: same rules as the other two scripts in this repo (see SPEC.md).
# No `set -e` -- an installer must degrade rather than abort, because a run that
# dies halfway costs a reimage. Every phase is idempotent, so a failure is
# recoverable by re-running rather than reinstalling. A full transcript goes to
# /var/log.

set -uo pipefail

# ------------------------------------------------------------------------------
# Configuration
# ------------------------------------------------------------------------------

# The desktop. kali-desktop-i3 is a complete, curated desktop -- i3, xorg,
# lightdm, and kali-desktop-core -- with the i3 session registered with the
# display manager. Naming individual pieces instead is how you discover that
# kali-desktop-i3 depends on betterlockscreen, which depends on i3lock-color,
# which both Conflicts and Provides i3lock -- so asking for `i3lock` by name
# makes the whole set unresolvable. Don't.
DESKTOP_PKGS=(
    kali-desktop-i3
    polybar
    kitty

    # The fallback terminal, and the reason this list has one at all. kitty is
    # a GPU terminal: it wants OpenGL 3.3, which on this guest means llvmpipe.
    # That works, but it is the single most likely thing to not work, and a
    # tiling WM whose only terminal binding is broken is a box you cannot use.
    # xterm needs nothing but X and is bound to $mod+Shift+Return.
    xterm

    # glxinfo. Not cosmetic here -- it is how the i3 phase decides whether a
    # compositor could work at all, and how you diagnose this box later.
    mesa-utils

    # xset, xrandr, xhost. The i3 config drives xset directly to kill DPMS
    # blanking, and xrandr is how you fix the resolution from inside the guest.
    x11-xserver-utils

    autotiling
)

# Hyper-V integration services. hyperv-daemons is a metapackage over the KVP,
# VSS and fcopy daemons: KVP is what makes the host's "Networking" tab show the
# guest's real IP, VSS is what makes host-side checkpoints consistent instead of
# crash-state. Neither is required to boot, both are why the guest behaves like
# a managed VM rather than a black box.
HYPERV_PKGS=(
    hyperv-daemons
)

# ScreenConnect's agent is not statically linked against X. The .deb declares
# most of this, but declaring is not installing on a box where apt has to
# resolve it -- and the failure mode is an agent that installs cleanly, starts,
# and shows a black screen because it cannot open the display. Probed
# individually; libicu in particular is version-suffixed and churns.
SC_DEPS=(
    libx11-6 libxext6 libxrandr2 libxtst6 libxinerama1 libxcursor1 libxi6
    libxdamage1 libxfixes3 libglib2.0-0
)

readonly ALL_PHASES=(base hyperv desktop i3 polybar kitty shell screenconnect)

# Binaries the verification pass ticks. BINARY names, not package names. The
# rule from SPEC.md applies: a tick for something nothing installs is worse than
# no tick, because it trains you to skim past red.
VERIFY_BINS_DESKTOP=(
    i3 polybar kitty xterm dmenu_run Xorg xset xrandr glxinfo autotiling
)

# Colors
readonly RED='\033[0;31m'
readonly GREEN='\033[0;32m'
readonly YELLOW='\033[1;33m'
readonly BLUE='\033[0;34m'
readonly NC='\033[0m'

DRY_RUN=0
AUTOLOGIN=0
COMPOSITOR=""
SKIP_PHASES=()
ONLY_PHASES=()

# ------------------------------------------------------------------------------
# Helper Functions
# ------------------------------------------------------------------------------

# warn/err go to stderr so they don't get captured by $(...) command
# substitutions and so they're visible on the error path.
msg()   { echo -e "${GREEN}[+]${NC} $1"; }
warn()  { echo -e "${YELLOW}[*]${NC} $1" >&2; }
err()   { echo -e "${RED}[!]${NC} $1" >&2; }
phase() { echo -e "\n${BLUE}=== $1 ===${NC}"; }

# Help text is the header comment block itself, read structurally rather than by
# line number so editing the header can't leak code into --help.
usage() {
    awk 'NR>2 { if (/^#/) { sub(/^# ?/, ""); print } else { exit } }' "$0"
    exit 0
}

get_real_user() {
    if [[ -n "${SUDO_USER:-}" ]] && [[ "$SUDO_USER" != "root" ]]; then
        echo "$SUDO_USER"
    else
        err "This script must be run with sudo, not as root directly"
        err "Usage: sudo $0"
        exit 1
    fi
}

get_user_home() { getent passwd "$1" | cut -d: -f6; }

# Every mutating command goes through run() so --dry-run is honoured in one
# place rather than at every call site.
run() {
    if (( DRY_RUN )); then
        echo -e "${YELLOW}[dry-run]${NC} $*"
        return 0
    fi
    "$@"
}

# Write a heredoc to a file, honouring --dry-run. Reads content from stdin.
write_file() {
    local dst="$1" mode="${2:-}"
    if (( DRY_RUN )); then
        echo -e "${YELLOW}[dry-run]${NC} write $dst"
        cat >/dev/null
        return 0
    fi
    mkdir -p "$(dirname "$dst")"
    cat > "$dst" || { err "could not write $dst"; return 1; }
    [[ -n "$mode" ]] && chmod "$mode" "$dst"
    return 0
}

# Back up a file ONCE, the first time we are about to replace it. Copying on
# every run means the second run overwrites the backup with what the first run
# generated -- so the original is recoverable exactly once, which is to say not
# when you actually need it.
backup_once() {
    local f="$1"
    [[ -f "$f" && ! -f "$f.backup" ]] || return 0
    run cp "$f" "$f.backup" && msg "backed up $(basename "$f") to $(basename "$f").backup"
}

should_run() {
    local p="$1" x
    if (( ${#ONLY_PHASES[@]} )); then
        for x in "${ONLY_PHASES[@]}"; do [[ "$x" == "$p" ]] && return 0; done
        return 1
    fi
    for x in "${SKIP_PHASES[@]}"; do [[ "$x" == "$p" ]] && return 1; done
    return 0
}

is_phase() {
    local p="$1" x
    for x in "${ALL_PHASES[@]}"; do [[ "$x" == "$p" ]] && return 0; done
    return 1
}

# True if apt has an installation candidate for the package on THIS system, so
# a renamed or dropped package is a clean skip rather than a dead batch.
apt_available() {
    local cand
    cand=$(apt-cache policy "$1" 2>/dev/null | awk '/Candidate:/ {print $2}')
    [[ -n "$cand" && "$cand" != "(none)" ]]
}

# Install a list, falling back to one-by-one so a single unavailable package
# can't take the whole batch with it.
apt_install() {
    (( $# )) || return 0
    if (( DRY_RUN )); then
        echo -e "${YELLOW}[dry-run]${NC} apt-get install -y $*"
        return 0
    fi
    if apt-get install -y "$@"; then
        return 0
    fi
    warn "Bulk apt install failed; retrying packages individually..."
    local pkg
    for pkg in "$@"; do
        if apt_available "$pkg"; then
            apt-get install -y "$pkg" || warn "Could not install '$pkg' (skipping)"
        else
            warn "Package '$pkg' not available on this system (skipping)"
        fi
    done
}

check() {
    if command -v "$1" &>/dev/null; then
        echo -e "${GREEN}  ok${NC}   $1"
    else
        echo -e "${RED}  MISS${NC} $1"
    fi
}

# ------------------------------------------------------------------------------
# Argument parsing
# ------------------------------------------------------------------------------

while (( $# )); do
    case "$1" in
        --dry-run)      DRY_RUN=1; shift ;;
        --autologin)    AUTOLOGIN=1; shift ;;
        --compositor)   [[ -n "${2:-}" ]] || { err "--compositor needs a backend"; exit 1; }
                        case "$2" in
                            xrender|glx|egl) COMPOSITOR="$2" ;;
                            *) err "unknown backend: $2 (want xrender, glx or egl)"; exit 1 ;;
                        esac
                        shift 2 ;;
        --skip)         [[ -n "${2:-}" ]] || { err "--skip needs a phase"; exit 1; }
                        SKIP_PHASES+=("$2"); shift 2 ;;
        --only)         [[ -n "${2:-}" ]] || { err "--only needs a phase"; exit 1; }
                        ONLY_PHASES+=("$2"); shift 2 ;;
        --list-phases)  printf '%s\n' "${ALL_PHASES[@]}"; exit 0 ;;
        --print-packages)
                        printf '%s\n' "${DESKTOP_PKGS[@]}" "${HYPERV_PKGS[@]}" \
                                      "${SC_DEPS[@]}"; exit 0 ;;
        --print-checked-binaries)
                        printf '%s\n' "${VERIFY_BINS_DESKTOP[@]}"; exit 0 ;;
        -h|--help)      usage ;;
        *)              err "unknown option: $1"; err "try --help"; exit 1 ;;
    esac
done

for p in "${SKIP_PHASES[@]}" "${ONLY_PHASES[@]}"; do
    is_phase "$p" || { err "unknown phase: $p"; err "valid: ${ALL_PHASES[*]}"; exit 1; }
done

# ------------------------------------------------------------------------------
# Pre-flight Checks
# ------------------------------------------------------------------------------

if [[ $EUID -ne 0 ]]; then
    err "This script must be run with sudo"
    exit 1
fi

# get_real_user's `exit 1` only leaves the command-substitution subshell, so the
# status has to be checked here -- there is no `set -e` to do it.
REAL_USER=$(get_real_user) || exit 1
USER_HOME=$(get_user_home "$REAL_USER")

if [[ -z "$REAL_USER" || -z "$USER_HOME" ]]; then
    err "Could not determine the target user or home directory"
    exit 1
fi

LOGFILE="/var/log/kali-deploy-vm-$(date +%Y%m%d-%H%M%S).log"
if (( ! DRY_RUN )); then
    exec > >(tee -a "$LOGFILE") 2>&1
fi

phase "Pre-flight"
msg "User:      $REAL_USER ($USER_HOME)"
(( DRY_RUN )) && msg "Mode:      DRY RUN (nothing will be changed)" \
              || msg "Log:       $LOGFILE"

# Distro. Advisory, not fatal. /etc/os-release on kali-rolling has ID=kali but
# NO VERSION_ID, so never branch on version -- under `set -u` that is a crash.
distro_id="$(. /etc/os-release 2>/dev/null && echo "${ID:-unknown}")"
if [[ "$distro_id" != "kali" ]]; then
    warn "This does not look like Kali (ID=$distro_id) -- kali-desktop-i3 will not resolve."
    warn "Continuing anyway; every package is probed before install."
else
    msg "Distro:    Kali"
fi

# Virtualisation. Probed, not assumed: this script is correct on bare metal too,
# it just has less to do. systemd-detect-virt reports "microsoft" under Hyper-V;
# the DMI fallback covers a container//chroot with no systemd to ask.
VIRT="none"
if command -v systemd-detect-virt &>/dev/null; then
    VIRT=$(systemd-detect-virt 2>/dev/null || echo none)
fi
if [[ "$VIRT" == "none" && -r /sys/class/dmi/id/sys_vendor ]]; then
    grep -qi microsoft /sys/class/dmi/id/sys_vendor 2>/dev/null && VIRT="microsoft"
fi

IS_HYPERV=0
[[ "$VIRT" == "microsoft" ]] && IS_HYPERV=1

if (( IS_HYPERV )); then
    msg "Platform:  Hyper-V guest"
else
    msg "Platform:  $VIRT"
    warn "Not a Hyper-V guest -- the hyperv phase will skip."
fi

# Hardware probes. These drive the polybar and i3 configs below, so that a
# module or a keybinding only exists when the thing it drives does.
HAS_BATTERY=0
[[ -d /sys/class/power_supply/BAT0 ]] && HAS_BATTERY=1
HAS_WIFI=0
compgen -G "/sys/class/net/*/wireless" >/dev/null 2>&1 && HAS_WIFI=1
HAS_BACKLIGHT=0
compgen -G "/sys/class/backlight/*" >/dev/null 2>&1 && HAS_BACKLIGHT=1

msg "Hardware:  battery=$HAS_BATTERY wifi=$HAS_WIFI backlight=$HAS_BACKLIGHT"

if [[ -n "$COMPOSITOR" ]]; then
    msg "Compositor: picom --backend $COMPOSITOR (explicitly requested)"
    [[ "$COMPOSITOR" == "glx" ]] && (( IS_HYPERV )) && {
        warn "glx on a Hyper-V guest is the exact combination that produces an"
        warn "  opaque, input-eating overlay. You asked for it; proceeding."
    }
else
    msg "Compositor: none (see --compositor)"
fi

(( ${#SKIP_PHASES[@]} )) && msg "Skipping:  ${SKIP_PHASES[*]}"
(( ${#ONLY_PHASES[@]} )) && msg "Only:      ${ONLY_PHASES[*]}"

# ------------------------------------------------------------------------------
# Phase: base -- apt update / full-upgrade
# ------------------------------------------------------------------------------

if should_run base; then
    phase "Phase: base"

    export DEBIAN_FRONTEND=noninteractive

    msg "Updating package lists..."
    run apt-get update || warn "apt-get update reported errors (continuing)"

    # Kali is a rolling release: `upgrade` can hold packages back and leave a
    # partially-upgraded system. full-upgrade is the supported path.
    msg "Full-upgrading (rolling release; 'upgrade' is not safe here)..."
    run apt-get -y full-upgrade || warn "full-upgrade reported errors (continuing)"
fi

# ------------------------------------------------------------------------------
# Phase: hyperv -- integration services
# ------------------------------------------------------------------------------

if should_run hyperv; then
    phase "Phase: hyperv"

    if (( ! IS_HYPERV )); then
        msg "not a Hyper-V guest -- nothing to do"
    else
        apt_install "${HYPERV_PKGS[@]}"

        # These are socket-activated against /dev/vmbus devices that only exist
        # on a real Hyper-V guest, so enabling them anywhere else is noise. Unit
        # names differ across releases; try both spellings and don't complain
        # when one is absent, because only one of them ever exists.
        for unit in hv-kvp-daemon hv_kvp_daemon hv-vss-daemon hv_vss_daemon; do
            if systemctl list-unit-files "${unit}.service" &>/dev/null \
               && systemctl cat "${unit}.service" &>/dev/null; then
                if run systemctl enable --now "${unit}.service" 2>/dev/null; then
                    msg "enabled ${unit}.service"
                else
                    warn "could not enable ${unit}.service"
                fi
            fi
        done

        # Resolution is a HOST-side setting on a Gen 2 VM. The guest driver
        # (hyperv_drm) takes its mode from the host's video config and xrandr
        # cannot add modes it was never offered, so there is nothing useful to
        # do from in here -- but there IS something to do from out there, and
        # it is worth saying once rather than leaving you to find it.
        msg "Resolution is set host-side. From an elevated PowerShell prompt:"
        msg "  Set-VMVideo -VMName <name> -HorizontalResolution 1920 \\"
        msg "              -VerticalResolution 1080 -ResolutionType Single"
        msg "  (VM must be off. Gen 2 only; Gen 1 uses the video BIOS instead.)"
    fi
fi

# ------------------------------------------------------------------------------
# Phase: desktop -- i3 desktop, display manager, fallback terminal
# ------------------------------------------------------------------------------

if should_run desktop; then
    phase "Phase: desktop"

    export DEBIAN_FRONTEND=noninteractive
    apt_install "${DESKTOP_PKGS[@]}"

    # Autologin. Off by default, and the default is the considered one: with a
    # greeter, an unattended box that reboots comes back to a LOCKED login
    # screen that ScreenConnect can still show you, so you lose nothing but a
    # password prompt. With autologin it comes back to an unlocked desktop with
    # your keys, your loot and your shell history, reachable by anyone who
    # reaches the agent. That is a real tradeoff on a pentest box and not one to
    # make silently on someone's behalf.
    #
    # It is still offered because the failure it prevents is real: some agent
    # configurations only attach to an active user session, and a greeter is
    # not one.
    if (( AUTOLOGIN )); then
        LIGHTDM_CONF="/etc/lightdm/lightdm.conf.d/60-autologin.conf"
        write_file "$LIGHTDM_CONF" <<AUTOLOGIN_CONF
# Written by kali-deploy-vm --autologin
# Delete this file to get the greeter back.
[Seat:*]
autologin-user=$REAL_USER
autologin-user-timeout=0
user-session=i3
AUTOLOGIN_CONF
        # lightdm's autologin needs the user in the autologin group on some
        # configurations and it is harmless where it isn't.
        run groupadd -f autologin
        run gpasswd -a "$REAL_USER" autologin >/dev/null 2>&1 || true
        msg "autologin enabled for $REAL_USER (session: i3)"
        warn "the box now boots to an unlocked desktop -- see the phase comment"
    else
        msg "autologin not enabled (greeter will be shown; use --autologin to change)"
    fi

    # Make sure the display manager actually comes up on boot. On a fresh netinst
    # with no desktop task selected, lightdm installs but is not the default
    # target's business -- and a guest that boots to a TTY gives the remote agent
    # nothing to capture at all.
    if systemctl list-unit-files lightdm.service &>/dev/null \
       && systemctl cat lightdm.service &>/dev/null; then
        if run systemctl enable lightdm.service 2>/dev/null; then
            msg "lightdm enabled at boot"
        else
            warn "could not enable lightdm"
        fi
        if run systemctl set-default graphical.target >/dev/null 2>&1; then
            msg "default target set to graphical"
        else
            warn "could not set graphical.target"
        fi
    else
        warn "no lightdm unit -- the guest may boot to a TTY with nothing to capture"
    fi
fi

# ------------------------------------------------------------------------------
# Phase: i3 -- the config, built from the probes above
# ------------------------------------------------------------------------------

if should_run i3; then
    phase "Phase: i3"

    I3_DIR="$USER_HOME/.config/i3"
    backup_once "$I3_DIR/config"

    # The static body. Everything conditional is appended afterwards, so that
    # what is in this heredoc is true on every box the script runs on.
    write_file "$I3_DIR/config" <<'I3CONFIG'
# i3 config -- kali-deploy-vm
#
# Mod is Super/Windows (Mod4). Hyper-V's VMConnect does forward Super to the
# guest, so this works -- but if you ever run this under a client that grabs it
# (some RDP clients do, depending on their keyboard-passthrough setting), change
# the line below to Mod1 and every binding follows. That is the one edit.
set $mod Mod4

font pango:monospace 8

default_border pixel 2
default_floating_border pixel 2

# Greys off the same dark palette as the terminal, rather than i3's built-in
# blue. The text field only shows in stacking/tabbed layouts, which draw
# titlebars regardless of default_border.
#                       border  bground text    indicator child_border
client.focused          #5c5f66 #3a3d42 #dadada #7f838a   #5c5f66
client.urgent           #b2a1c0 #3a3d42 #dadada #b2a1c0   #b2a1c0

# Terminal. kitty first, xterm as the escape hatch -- kitty wants OpenGL 3.3,
# which on a guest means llvmpipe, and if that ever fails to initialise you need
# a terminal that asks nothing of the GPU to fix it from.
bindsym $mod+Return exec kitty
bindsym $mod+Shift+Return exec xterm

bindsym $mod+Shift+q kill
bindsym $mod+d exec dmenu_run

# Focus
bindsym $mod+h focus left
bindsym $mod+j focus down
bindsym $mod+k focus up
bindsym $mod+l focus right
bindsym $mod+Left focus left
bindsym $mod+Down focus down
bindsym $mod+Up focus up
bindsym $mod+Right focus right

# Move
bindsym $mod+Shift+h move left
bindsym $mod+Shift+j move down
bindsym $mod+Shift+k move up
bindsym $mod+Shift+l move right
bindsym $mod+Shift+Left move left
bindsym $mod+Shift+Down move down
bindsym $mod+Shift+Up move up
bindsym $mod+Shift+Right move right

# Split / fullscreen / layout
bindsym $mod+b split h
bindsym $mod+v split v
bindsym $mod+f fullscreen toggle
bindsym $mod+s layout stacking
bindsym $mod+w layout tabbed
bindsym $mod+e layout toggle split
bindsym $mod+Shift+space floating toggle
bindsym $mod+space focus mode_toggle
bindsym $mod+a focus parent

# Workspaces
set $ws1 "1"
set $ws2 "2"
set $ws3 "3"
set $ws4 "4"
set $ws5 "5"
set $ws6 "6"
set $ws7 "7"
set $ws8 "8"
set $ws9 "9"
set $ws10 "10"

bindsym $mod+1 workspace number $ws1
bindsym $mod+2 workspace number $ws2
bindsym $mod+3 workspace number $ws3
bindsym $mod+4 workspace number $ws4
bindsym $mod+5 workspace number $ws5
bindsym $mod+6 workspace number $ws6
bindsym $mod+7 workspace number $ws7
bindsym $mod+8 workspace number $ws8
bindsym $mod+9 workspace number $ws9
bindsym $mod+0 workspace number $ws10

bindsym $mod+Shift+1 move container to workspace number $ws1
bindsym $mod+Shift+2 move container to workspace number $ws2
bindsym $mod+Shift+3 move container to workspace number $ws3
bindsym $mod+Shift+4 move container to workspace number $ws4
bindsym $mod+Shift+5 move container to workspace number $ws5
bindsym $mod+Shift+6 move container to workspace number $ws6
bindsym $mod+Shift+7 move container to workspace number $ws7
bindsym $mod+Shift+8 move container to workspace number $ws8
bindsym $mod+Shift+9 move container to workspace number $ws9
bindsym $mod+Shift+0 move container to workspace number $ws10

bindsym $mod+Shift+c reload
bindsym $mod+Shift+r restart
bindsym $mod+Shift+e exec "i3-nagbar -t warning -m 'Exit i3?' -B 'Yes' 'i3-msg exit'"

mode "resize" {
    bindsym h resize shrink width 10 px or 10 ppt
    bindsym j resize grow height 10 px or 10 ppt
    bindsym k resize shrink height 10 px or 10 ppt
    bindsym l resize grow width 10 px or 10 ppt
    bindsym Left resize shrink width 10 px or 10 ppt
    bindsym Down resize grow height 10 px or 10 ppt
    bindsym Up resize shrink height 10 px or 10 ppt
    bindsym Right resize grow width 10 px or 10 ppt
    bindsym Return mode "default"
    bindsym Escape mode "default"
    bindsym $mod+r mode "default"
}
bindsym $mod+r mode "resize"

# Manual lock only. No xss-lock, no idle timeout: see the header for why an
# unasked-for lock on a remote box is a liability rather than a protection.
bindsym $mod+Escape exec --no-startup-id i3lock -c 282828

# Kill screen blanking and DPMS. Over a screen-scraping agent a blanked display
# is indistinguishable from a hung one, and "is the VM dead?" is a question you
# should never have to ask because of a screensaver.
exec_always --no-startup-id xset s off -dpms

# Solid background rather than an image. feh is not in this script's package set
# on purpose: a wallpaper is pixels the remote agent has to encode and ship to
# you for no benefit. Change the colour here, or run feh yourself if you'd
# rather have the picture.
exec_always --no-startup-id xsetroot -solid "#282828"

# Polybar
exec_always --no-startup-id $HOME/.config/polybar/launch.sh

# Automatic split direction. i3 has no rule for this -- for_window matches
# window properties and never a window count -- so it takes an IPC client.
# autotiling sets the split on the focused window from its shape, and --limit 2
# caps nesting at two levels, which turns the default inward spiral into a real
# master/stack: window one holds the left half at full height and everything
# after it stacks down the right column.
#
# Guarded on the binary existing, because this phase is allowed to run against a
# box where the desktop phase was skipped, and i3 logging a failed exec on every
# restart is noise you will eventually stop reading.
#
# flock is the single-instance guard -- autotiling has none of its own, and the
# lock is held for the process lifetime so a second copy exits instead of piling
# up behind a restart. pkill is the usual advice and the wrong tool: every -f
# pattern that matches autotiling also matches the shell i3 starts it from, so
# it kills its own replacement.
exec_always --no-startup-id command -v autotiling >/dev/null && flock -n $XDG_RUNTIME_DIR/autotiling.lock autotiling --limit 2
I3CONFIG

    # Backlight keys, only where there is a backlight to drive. brightnessctl
    # writes /sys/class/backlight/<dev>/brightness, which udev makes writable by
    # the `video` group -- so no sudo and no setuid helper. -n keeps the floor at
    # 1: without it, holding the key blacks the panel out entirely and the way
    # back is a keypress you can no longer see to aim.
    if (( HAS_BACKLIGHT )) && (( ! DRY_RUN )); then
        cat >> "$I3_DIR/config" <<'BACKLIGHT'

# Brightness (a backlight was detected at deploy time)
bindsym XF86MonBrightnessUp   exec --no-startup-id brightnessctl -n set 5%+
bindsym XF86MonBrightnessDown exec --no-startup-id brightnessctl -n set 5%-
BACKLIGHT
        msg "backlight detected -- brightness keys bound"
    else
        msg "no backlight -- brightness keys omitted"
    fi

    # Compositor, only if explicitly asked for. picom 13 dropped its implicit
    # backend fallback and Kali's /etc/xdg/picom.conf sets none, so a bare
    # `picom` hard-fails with "Backend not specified" -- the backend must be on
    # the line. Foreground under flock rather than `picom -b`: -b daemonises,
    # the parent exits, and flock releases the lock the moment it does, which
    # would leave the guard guarding nothing.
    if [[ -n "$COMPOSITOR" ]] && (( ! DRY_RUN )); then
        cat >> "$I3_DIR/config" <<COMPOSITOR_CONF

# Compositor (requested with --compositor $COMPOSITOR)
exec_always --no-startup-id flock -n \$XDG_RUNTIME_DIR/picom.lock picom --backend $COMPOSITOR
COMPOSITOR_CONF
        apt_install picom
        msg "picom --backend $COMPOSITOR added to the i3 config"
    fi

    run chown -R "$REAL_USER:$REAL_USER" "$I3_DIR"
    msg "i3 config written to $I3_DIR/config"
fi

# ------------------------------------------------------------------------------
# Phase: polybar -- modules built from the same probes
# ------------------------------------------------------------------------------

if should_run polybar; then
    phase "Phase: polybar"

    POLYBAR_DIR="$USER_HOME/.config/polybar"

    # modules-right is assembled rather than fixed. A battery module pinned to a
    # BAT0 that does not exist renders as a permanent blank, and a wireless
    # module on a box with no radio renders as a permanent "wlan down" -- both
    # are things you look at every day and learn to ignore, which is exactly the
    # habit a status bar must not teach.
    modules_right="network cpu memory"
    (( HAS_WIFI ))    && modules_right="wlan $modules_right"
    (( HAS_BATTERY )) && modules_right="$modules_right battery"
    msg "polybar modules-right: $modules_right"

    write_file "$POLYBAR_DIR/config.ini" <<POLYBAR
[colors]
; The dots prompt palette, so the bar, the terminal and the prompt read as one
; thing. primary is the seafoam the prompt gives a clean branch, taken as-is
; rather than lightened -- the bar's accent is then a colour that already exists
; on screen instead of a near-match to one.
;
; secondary and disabled deliberately carry the same value: "not focused" and
; "not present" should both be things the eye skips, which leaves seafoam as the
; only accent on the bar.
background = #282828
background-alt = #3A3D42
foreground = #DADADA
primary = #83A0A4
secondary = #8A8A8A
alert = #FF2D2D
disabled = #8A8A8A

[bar/main]
width = 100%
height = 24pt
radius = 0
background = \${colors.background}
foreground = \${colors.foreground}
line-size = 3pt
border-size = 0
padding-left = 0
padding-right = 1
module-margin = 1
separator = |
separator-foreground = \${colors.disabled}
; Plain monospace and ASCII module prefixes ("CPU ", "MEM "). No Font Awesome:
; every prefix here is ASCII, so the glyph fonts were never used, and asking for
; a face that isn't installed just fills the polybar log with font errors.
font-0 = monospace;2
modules-left = i3 xwindow
modules-center = date
modules-right = $modules_right
cursor-click = pointer
cursor-scroll = ns-resize
enable-ipc = true

[module/i3]
type = internal/i3
pin-workspaces = true
show-urgent = true
strip-wsnumbers = true
index-sort = true
format = <label-state> <label-mode>
label-focused = %index%
label-focused-background = \${colors.background-alt}
label-focused-underline = \${colors.primary}
label-focused-padding = 1
label-unfocused = %index%
label-unfocused-padding = 1
label-visible = %index%
label-visible-underline = \${colors.secondary}
label-visible-padding = 1
label-urgent = %index%
label-urgent-background = \${colors.alert}
label-urgent-padding = 1

[module/xwindow]
type = internal/xwindow
label = %title:0:60:...%

[module/cpu]
type = internal/cpu
interval = 2
format-prefix = "CPU "
format-prefix-foreground = \${colors.primary}
label = %percentage:2%%

[module/memory]
type = internal/memory
interval = 2
format-prefix = "MEM "
format-prefix-foreground = \${colors.primary}
label = %percentage_used:2%%

[module/network]
type = internal/network
interface-type = wired
interval = 3.0
format-connected = <label-connected>
format-connected-prefix = "ETH "
format-connected-prefix-foreground = \${colors.primary}
label-connected = %ifname% %local_ip%
format-disconnected =

[module/wlan]
type = internal/network
interface-type = wireless
interval = 3.0
format-connected = <label-connected>
format-connected-prefix = "WLAN "
format-connected-prefix-foreground = \${colors.primary}
label-connected = %essid% %local_ip%
format-disconnected = <label-disconnected>
label-disconnected = wlan down
label-disconnected-foreground = \${colors.disabled}

[module/battery]
type = internal/battery
battery = BAT0
adapter = AC
full-at = 98
format-charging = <label-charging>
format-charging-prefix = "BAT+ "
format-charging-prefix-foreground = \${colors.secondary}
label-charging = %percentage%%
format-discharging = <label-discharging>
format-discharging-prefix = "BAT "
format-discharging-prefix-foreground = \${colors.primary}
label-discharging = %percentage%%
format-full-prefix = "FULL "
format-full-prefix-foreground = \${colors.secondary}
label-full = %percentage%%

[module/date]
type = internal/date
interval = 1
date = %Y-%m-%d %H:%M:%S
date-alt = %A, %B %d, %Y %H:%M:%S
label = %date%
label-foreground = \${colors.primary}

[settings]
screenchange-reload = true
; No pseudo-transparency: there is no compositor, and asking polybar to fake it
; means it re-reads the root pixmap on every redraw for an effect nobody sees.
pseudo-transparency = false
POLYBAR

    write_file "$POLYBAR_DIR/launch.sh" 755 <<'LAUNCH'
#!/bin/bash
killall -q polybar
while pgrep -u $UID -x polybar >/dev/null; do sleep 1; done
polybar main &
LAUNCH

    run chown -R "$REAL_USER:$REAL_USER" "$POLYBAR_DIR"
    msg "polybar config written to $POLYBAR_DIR/config.ini"
fi

# ------------------------------------------------------------------------------
# Phase: kitty
# ------------------------------------------------------------------------------

if should_run kitty; then
    phase "Phase: kitty"

    KITTY_DIR="$USER_HOME/.config/kitty"

    # kitten themes writes *-theme.auto.conf when a theme is confirmed
    # interactively, and kitty loads it AFTER kitty.conf with no include line
    # needed -- so a theme picked in a previous session silently outlives this
    # deploy and wins over every colour below. Cleared so kitty.conf is the only
    # thing setting colours, every run.
    run rm -f "$KITTY_DIR/dark-theme.auto.conf" "$KITTY_DIR/light-theme.auto.conf" \
              "$KITTY_DIR/current-theme.conf"

    write_file "$KITTY_DIR/kitty.conf" <<'KITTY'
# kitty -- kali-deploy-vm
#
# Plain monospace, not a Nerd Font: this script does not fetch fonts, so asking
# for a face that isn't installed means kitty falls back and logs a warning on
# every launch. Install one and change this line if you want glyphs.
font_family      monospace
font_size        11.0
shell            /usr/bin/zsh
shell_integration enabled
enable_audio_bell no

# Fully opaque, and this is not a preference. Transparency requires a
# compositor to resolve, and this box runs none -- background_opacity below 1.0
# with nothing compositing gives you a window showing whatever stale garbage is
# in the framebuffer behind it, which reads as "kitty doesn't render".
background_opacity 1.0

# vsync off. sync_to_monitor makes kitty block until the next vertical refresh,
# which on llvmpipe -- software rendering, which is all a Hyper-V guest has --
# means blocking on a refresh signal derived from a display that isn't real.
# The symptom is a terminal that paints late, paints partially, or appears to
# hang on the first frame. This is the single most important line in this file
# for a VM, and it is why this is not just a copy of the physical script's.
sync_to_monitor  no

# Repaint/input delays relaxed from kitty's 10/3ms defaults. Those are tuned for
# a local GPU; on software rendering behind a remote agent they mean redrawing
# frames nobody will ever see, which costs you CPU in the guest and bandwidth on
# the wire. 20ms is still well inside "feels instant" for a terminal.
repaint_delay    20
input_delay      5

# Neowave Mocha -- the box's own scheme, grounded on #282828 exactly, which is
# what the polybar background and the prompt's contrast figures are computed
# against. Applied directly rather than left to `kitten themes` because that
# kitten only writes to disk once a selection is confirmed with Enter, which is
# a manual step a redeploy cannot drive.
foreground              #cdd6f4
background              #282828
selection_foreground    none
selection_background    #3f3f3f
cursor                  #89dceb
cursor_text_color       #282828

#: black
color0                  #45475a
color8                  #585b70
#: red
color1                  #f38ba8
color9                  #eba0ac
#: green
color2                  #a6e3a1
color10                 #94e2d5
#: yellow
color3                  #fab387
color11                 #f9e2af
#: blue
color4                  #89dceb
color12                 #74c7ec
#: magenta
color5                  #cba6f7
color13                 #f5c2e7
#: cyan
color6                  #94e2d5
color14                 #89dceb
#: white
color7                  #bac2de
color15                 #cdd6f4

active_border_color     #cba6f7
inactive_border_color   #3f3f3f
bell_border_color       #fab387

active_tab_foreground   #282828
active_tab_background   #cba6f7
inactive_tab_foreground #bac2de
inactive_tab_background #3f3f3f

scrollback_lines 10000
open_url_with    default
detect_urls      yes

# Live font-size adjustment. Worth more than usual here: the guest's resolution
# is whatever the host handed it, and that is often not what you'd have picked.
map ctrl+shift+equal         change_font_size all +1.0
map ctrl+shift+plus          change_font_size all +1.0
map ctrl+shift+kp_add        change_font_size all +1.0
map ctrl+shift+minus         change_font_size all -1.0
map ctrl+shift+kp_subtract   change_font_size all -1.0
map ctrl+shift+backspace     change_font_size all 0
KITTY

    run chown -R "$REAL_USER:$REAL_USER" "$KITTY_DIR"
    msg "kitty config written to $KITTY_DIR/kitty.conf"
fi

# ------------------------------------------------------------------------------
# Phase: shell -- append to Kali's zsh, don't replace it
# ------------------------------------------------------------------------------

if should_run shell; then
    phase "Phase: shell"

    ZSHRC="$USER_HOME/.zshrc"

    # Kali ships a tuned zsh. Appending a marker-guarded block beats installing a
    # framework over the top: faster startup, cleanly removable, and no `sed`
    # against a template that may not be there. v4 shipped exactly that bug --
    # its theme and plugin edits silently no-opped whenever the expected template
    # was absent.
    MARKER="# >>> kali-deploy-vm >>>"

    if [[ -f "$ZSHRC" ]] && grep -qF "$MARKER" "$ZSHRC" 2>/dev/null; then
        msg "zshrc block already present -- leaving it alone"
    elif (( DRY_RUN )); then
        echo -e "${YELLOW}[dry-run]${NC} append deploy block to $ZSHRC"
    else
        backup_once "$ZSHRC"
        cat >> "$ZSHRC" <<'ZSHBLOCK'

# >>> kali-deploy-vm >>>
# Marker-guarded. Delete from here to the closing marker to remove it cleanly.

export PATH="$HOME/.local/bin:$PATH"

# Diagnostics for this box specifically. When the desktop misbehaves on a guest
# it is almost always the graphics stack, and these are the three commands worth
# running before anything else -- collected here so they are on the box rather
# than in a wiki you cannot reach from the box.
alias gfx='glxinfo -B 2>/dev/null | grep -Ei "renderer|opengl version|direct rendering" || echo "glxinfo missing: apt install mesa-utils"'
alias i3log='cat $(ls -t /tmp/i3-log-* 2>/dev/null | head -1) 2>/dev/null || echo "no i3 log"'
alias barlog='journalctl --user -u polybar -n 50 --no-pager 2>/dev/null || echo "polybar not run under systemd; check ~/.config/polybar"'

# The way out of a wedged compositor, as one word. Kept because the failure it
# fixes leaves you unable to read the documentation that would tell you to run
# it -- you get here from a TTY, from memory.
alias unstick='pkill picom; i3-msg restart'

alias serve='python3 -m http.server'
alias ports='ss -tulpn'
alias myip='ip -brief addr'
alias extip='curl -s ifconfig.me; echo'
# <<< kali-deploy-vm <<<
ZSHBLOCK
        chown "$REAL_USER:$REAL_USER" "$ZSHRC"
        msg "appended deploy block to $ZSHRC"
    fi
fi

# ------------------------------------------------------------------------------
# Phase: screenconnect -- the access layer
# ------------------------------------------------------------------------------

if should_run screenconnect; then
    phase "Phase: screenconnect"

    # The one declared exception to "everything comes from the distribution's
    # own archive", and it earns the exception the same way Tailscale does in
    # kali-deploy-remote: it is not packaged anywhere else and it is the entire
    # access layer. Unlike Tailscale there is no apt repo to add -- the .deb is
    # generated per-instance and carries the instance fingerprint, which is why
    # this needs a URL from you rather than a constant in the script.
    if [[ -z "${SC_DEB:-}" && -z "${SC_URL:-}" ]]; then
        warn "neither SC_DEB nor SC_URL is set -- skipping the agent"
        warn ""
        warn "  In your ScreenConnect instance: Access -> Build Installer -> Linux,"
        warn "  copy the .deb URL, then re-run just this phase:"
        warn ""
        warn "    sudo SC_URL='<paste>' $0 --only screenconnect"
        warn ""
        warn "  The rest of this deploy is unaffected -- the desktop is already up."
    else
        # Deps first. The .deb declares most of these, but declaring is not
        # installing, and the failure mode of a missing X library is an agent
        # that installs cleanly, starts cleanly, and shows you a black screen
        # because it could never open the display.
        msg "installing X libraries the agent links against..."
        sc_deps_present=()
        for pkg in "${SC_DEPS[@]}"; do
            if apt_available "$pkg"; then
                sc_deps_present+=("$pkg")
            else
                warn "  '$pkg' has no candidate (name may have changed) -- skipping"
            fi
        done
        apt_install "${sc_deps_present[@]}"

        # libicu is version-suffixed (libicu72, libicu76, ...) and the number
        # moves with every Debian import, so it cannot be named as a constant.
        # Resolve whatever this box actually offers.
        icu=$(apt-cache search --names-only '^libicu[0-9]+$' 2>/dev/null \
              | awk '{print $1}' | sort -V | tail -1)
        if [[ -n "$icu" ]]; then
            msg "resolved ICU runtime: $icu"
            apt_install "$icu"
        else
            warn "no libicuNN found -- a .NET-based agent build may not start"
        fi

        # Acquire the package.
        SC_PKG=""
        if [[ -n "${SC_DEB:-}" ]]; then
            if [[ -f "$SC_DEB" ]]; then
                SC_PKG="$SC_DEB"
                msg "using local package: $SC_PKG"
            else
                err "SC_DEB points at '$SC_DEB', which is not a file"
            fi
        else
            SC_TMP=$(mktemp -d)
            SC_PKG="$SC_TMP/connectwisecontrol.deb"
            msg "downloading the agent..."
            # --fail so an HTML error page is an error and not a 200-byte .deb
            # that dpkg then rejects with something unrelated to the real cause.
            if (( DRY_RUN )); then
                echo -e "${YELLOW}[dry-run]${NC} curl -fsSL \"\$SC_URL\" -o $SC_PKG"
                SC_PKG=""
            elif ! curl -fsSL --retry 3 --retry-delay 2 "$SC_URL" -o "$SC_PKG"; then
                err "download failed -- check SC_URL and that this box can reach the instance"
                err "  the URL expires; re-copy it from Build Installer if it is old"
                SC_PKG=""
            fi
        fi

        # Install. `apt-get install ./file.deb` rather than `dpkg -i` so apt
        # resolves the package's own declared dependencies instead of leaving a
        # half-configured package for the next apt run to trip over.
        if [[ -n "$SC_PKG" ]]; then
            if (( DRY_RUN )); then
                echo -e "${YELLOW}[dry-run]${NC} apt-get install -y $SC_PKG"
            elif apt-get install -y "$SC_PKG"; then
                msg "agent installed"
            else
                err "agent install failed -- see the log at $LOGFILE"
            fi
        fi

        [[ -n "${SC_TMP:-}" ]] && run rm -rf "$SC_TMP"

        # Report what actually exists rather than claiming success. The unit is
        # named after the instance, so it cannot be matched by a fixed string.
        if (( ! DRY_RUN )); then
            sc_unit=$(systemctl list-units --type=service --all --no-legend 2>/dev/null \
                      | awk '{print $1}' | grep -i 'connectwise\|screenconnect' | head -1)
            if [[ -n "$sc_unit" ]]; then
                msg "agent service: $sc_unit"
                if systemctl is-active --quiet "$sc_unit"; then
                    msg "  active"
                else
                    warn "  installed but not active -- systemctl status $sc_unit"
                fi
            else
                warn "no ConnectWise/ScreenConnect service found after install"
            fi
        fi
    fi
fi

# ------------------------------------------------------------------------------
# Verification
# ------------------------------------------------------------------------------

phase "Verification"

if (( DRY_RUN )); then
    msg "dry run -- nothing was changed, nothing to verify"
    exit 0
fi

echo "Binaries:"
for b in "${VERIFY_BINS_DESKTOP[@]}"; do check "$b"; done

echo
echo "Graphics:"
# This is the check that matters on this platform, so it is not buried in the
# binary list. llvmpipe is EXPECTED here and is not a problem by itself -- it is
# only a problem for a compositor, which is why this script starts none.
if command -v glxinfo &>/dev/null; then
    glxinfo -B 2>/dev/null | grep -Ei 'renderer|OpenGL version|direct rendering' \
        | sed 's/^/  /' || echo "  glxinfo produced nothing (no X display from here?)"
else
    echo "  glxinfo not installed"
fi

echo
echo "Services:"
for u in lightdm hv-kvp-daemon hv_kvp_daemon; do
    if systemctl list-unit-files "${u}.service" &>/dev/null \
       && systemctl cat "${u}.service" &>/dev/null; then
        state=$(systemctl is-enabled "${u}.service" 2>/dev/null || echo unknown)
        echo "  ${u}.service: $state"
    fi
done

echo
echo "Listening sockets (read this, don't trust the toggles):"
ss -tulpn 2>/dev/null | sed 's/^/  /' || echo "  ss unavailable"

echo
phase "What this script could not verify"
cat <<'CHECKLIST'
Only observable from inside a real session on the real host:

  [ ] i3 actually starts. Log out to the greeter, pick "i3" from the session
      menu (top-right cog) if it isn't already the default, log back in.

  [ ] $mod+Return opens kitty AND you can type into it. If a window appears but
      stays blank or won't take input, the graphics stack is the suspect --
      run `gfx` (aliased by the shell phase) and try $mod+Shift+Return for xterm.

  [ ] Resolution is what you wanted. It comes from the host on a Gen 2 VM:
      Set-VMVideo -VMName <name> -HorizontalResolution 1920
                  -VerticalResolution 1080 -ResolutionType Single
      (VM off, elevated PowerShell.)

  [ ] ScreenConnect shows the desktop rather than a black rectangle. A black
      rectangle with a working session underneath means the agent cannot reach
      the X display -- check which display it attached to before assuming the
      desktop is broken.

  [ ] Keyboard passthrough. If Super does nothing through your remote client,
      change `set $mod Mod4` to Mod1 in ~/.config/i3/config; every binding in
      the file follows that one line.

If you ever land in a black, unresponsive screen: Ctrl+Alt+F3 for a TTY, log
in, run `unstick`, then Ctrl+Alt+F7 (or F1) to go back.
CHECKLIST

echo
msg "Done. Full transcript: $LOGFILE"
