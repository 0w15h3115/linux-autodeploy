#!/bin/bash

# Ubuntu Security Tools Installation Script (v5)
# Installs: nmap, ncat, binwalk, impacket, netexec, certipy, responder,
#           smbclient, hashcat, i3, polybar, zsh, oh-my-zsh, kitty,
#           proxychains, java, dnstools, bloodhound, mitm6,
#           enum4linux, wordlists
#
# v5 changes: an installer should keep going when an optional component fails
# rather than aborting the whole run. We drop `set -e` (keep -u and pipefail),
# make every fallible step tolerant, install apt packages resiliently, and fix
# several hard-failures from v4 (missing keyrings dir, setcap on a symlink,
# rockyou gunzip, openjdk-8-jre, BloodHound asset type, redundant pipx pip).

set -uo pipefail

# ------------------------------------------------------------------------------
# Configuration
# ------------------------------------------------------------------------------

readonly SECURITY_VENV="/opt/security-tools-venv"
readonly WORDLIST_DIR="/usr/share/wordlists"
readonly BLOODHOUND_DIR="/opt/BloodHound"

# Colors
readonly RED='\033[0;31m'
readonly GREEN='\033[0;32m'
readonly YELLOW='\033[1;33m'
readonly NC='\033[0m'

# ------------------------------------------------------------------------------
# Helper Functions
# ------------------------------------------------------------------------------

# warn/err go to stderr so they don't get captured by $(...) command
# substitutions (e.g. get_real_user) and so they're visible on the error path.
msg()     { echo -e "${GREEN}[+]${NC} $1"; }
warn()    { echo -e "${YELLOW}[*]${NC} $1" >&2; }
err()     { echo -e "${RED}[!]${NC} $1" >&2; }

get_real_user() {
    if [[ -n "${SUDO_USER:-}" ]] && [[ "$SUDO_USER" != "root" ]]; then
        echo "$SUDO_USER"
    else
        err "This script must be run with sudo, not as root directly"
        err "Usage: sudo $0"
        exit 1
    fi
}

get_user_home() {
    getent passwd "$1" | cut -d: -f6
}

run_as_user() {
    local user="$1"
    shift
    su - "$user" -c "$*"
}

# True if apt has an installation candidate for the package on THIS release.
# Lets us skip packages that were renamed/removed in a newer Ubuntu instead of
# letting one missing name abort everything.
apt_available() {
    local cand
    cand=$(apt-cache policy "$1" 2>/dev/null | awk '/Candidate:/ {print $2}')
    [[ -n "$cand" && "$cand" != "(none)" ]]
}

# Install a list of apt packages, falling back to one-by-one so that a single
# unavailable package doesn't take down the entire batch. In the fallback we
# probe availability first so a removed/renamed package is a clean skip.
apt_install() {
    if apt-get install -y "$@"; then
        return 0
    fi
    warn "Bulk apt install failed; retrying packages individually..."
    for pkg in "$@"; do
        if apt_available "$pkg"; then
            apt-get install -y "$pkg" || warn "Could not install '$pkg' (skipping)"
        else
            warn "Package '$pkg' not available on this release (skipping)"
        fi
    done
}

# Install the FIRST package from the list that this release actually offers.
# Use for version-floating names so you never have to pin one, e.g.:
#   apt_install_first "Java runtime" default-jre openjdk-21-jre openjdk-17-jre
# default-jre is a meta-package that always tracks the current default JDK, so
# putting it first means Ubuntu picks the right version for you automatically.
apt_install_first() {
    local label="$1"; shift
    local pkg
    for pkg in "$@"; do
        if apt_available "$pkg"; then
            if apt-get install -y "$pkg"; then
                msg "$label: installed '$pkg'"
                return 0
            fi
        fi
    done
    warn "$label: none of [$*] are available on this release (skipping)"
    return 1
}

# ------------------------------------------------------------------------------
# Pre-flight Checks
# ------------------------------------------------------------------------------

if [[ $EUID -ne 0 ]]; then
    err "This script must be run with sudo"
    exit 1
fi

# get_real_user's `exit 1` only exits the command-substitution subshell, so we
# must check its status and exit the parent ourselves (no `set -e` to do it).
REAL_USER=$(get_real_user) || exit 1
USER_HOME=$(get_user_home "$REAL_USER")

if [[ -z "$REAL_USER" || -z "$USER_HOME" ]]; then
    err "Could not determine the target user or home directory"
    exit 1
fi

msg "Installing security tools for user: $REAL_USER"
msg "User home directory: $USER_HOME"

# ------------------------------------------------------------------------------
# Phase 1: System Packages (apt)
# ------------------------------------------------------------------------------

msg "Updating package lists..."
apt-get update || true

# Ensure the 'universe' component is enabled — many of these tools (enum4linux,
# dnsrecon, nbtscan, polybar...) live there, and a minimal install may not have
# it. add-apt-repository is provided by software-properties-common.
if ! apt-cache policy 2>/dev/null | grep -q universe; then
    msg "Enabling 'universe' repository component..."
    apt-get install -y software-properties-common || true
    add-apt-repository -y universe 2>/dev/null || warn "Could not enable universe automatically"
    apt-get update || true
fi

msg "Installing system packages..."
apt_install \
    build-essential \
    curl \
    wget \
    git \
    jq \
    unzip \
    ca-certificates \
    gnupg \
    \
    python3 \
    python3-pip \
    python3-venv \
    python3-dev \
    python3-setuptools \
    pipx \
    \
    nmap \
    ncat \
    iputils-ping \
    binwalk \
    smbclient \
    hashcat \
    proxychains4 \
    net-tools \
    dnsutils \
    dnsrecon \
    nbtscan \
    adcli \
    enum4linux \
    \
    xorg \
    xinit \
    x11-xserver-utils \
    i3 \
    i3status \
    i3lock \
    xss-lock \
    dmenu \
    polybar \
    \
    zsh \
    kitty \
    tmux \
    \
    libssl-dev \
    libffi-dev \
    libpcap-dev \
    libgmp3-dev \
    libxml2-dev \
    libxslt1-dev \
    zlib1g-dev \
    \
    fonts-powerline \
    fonts-font-awesome \
    \
    ocl-icd-libopencl1 \
    opencl-headers \
    libcap2-bin

# Java runtime — version-independent. default-jre tracks the current default
# JDK on every release; the explicit openjdk-* names are only fallbacks in case
# the meta-package is ever unavailable. No rewrite needed when Ubuntu bumps Java.
apt_install_first "Java runtime" \
    default-jre \
    openjdk-21-jre \
    openjdk-17-jre \
    openjdk-11-jre

# Install certipy from apt if available
apt-get install -y python3-certipy 2>/dev/null || warn "python3-certipy not in apt, will install via pip"

# Install ldapdomaindump from apt
apt-get install -y python3-ldapdomaindump 2>/dev/null || true

# ------------------------------------------------------------------------------
# Phase 2: Neo4j (for BloodHound)
# ------------------------------------------------------------------------------

msg "Installing Neo4j..."
if ! command -v neo4j &>/dev/null; then
    # /etc/apt/keyrings does not exist by default on Ubuntu — create it first.
    mkdir -p /etc/apt/keyrings
    wget -O - https://debian.neo4j.com/neotechnology.gpg.key | gpg --dearmor -o /etc/apt/keyrings/neo4j.gpg
    echo 'deb [signed-by=/etc/apt/keyrings/neo4j.gpg] https://debian.neo4j.com stable latest' \
        > /etc/apt/sources.list.d/neo4j.list
    apt-get update
    apt-get install -y neo4j || warn "Neo4j install failed"
fi

# Enable + set initial password (best-effort; systemctl is absent under WSL/containers).
# neo4j 5.x uses `neo4j-admin dbms set-initial-password`, 4.x uses `neo4j-admin set-initial-password`.
systemctl enable neo4j 2>/dev/null || warn "Could not enable neo4j service (no systemd?)"
neo4j-admin dbms set-initial-password bloodhound 2>/dev/null \
    || neo4j-admin set-initial-password bloodhound 2>/dev/null \
    || warn "Could not set Neo4j initial password automatically"
msg "Neo4j default credentials: neo4j / bloodhound"

# ------------------------------------------------------------------------------
# Phase 4: Security Tools Virtual Environment (as user)
# ------------------------------------------------------------------------------

msg "Creating security tools virtual environment..."

# Create venv directory with correct ownership from the start
mkdir -p "$SECURITY_VENV"
chown "$REAL_USER:$REAL_USER" "$SECURITY_VENV"

# Create and populate venv as the actual user.
# --copies makes bin/python3 a real binary instead of a symlink, which is
# required for setcap below (setcap refuses to operate on a symlink).
run_as_user "$REAL_USER" "
    python3 -m venv --copies '$SECURITY_VENV'
    source '$SECURITY_VENV/bin/activate'

    pip install --upgrade pip
    pip install wheel

    # Core security tools
    pip install impacket
    pip install certipy-ad
    pip install netifaces
    pip install aioquic

    # AD enumeration and attack tools
    pip install bloodhound
    pip install mitm6

    deactivate
"

# Allow venv python to bind privileged ports and use raw sockets (needed for
# ntlmrelayx port 445/80 and mitm6 raw IPv6 sockets) without requiring sudo.
# setcap needs a real file: resolve through any remaining symlink just in case.
VENV_PYTHON=$(readlink -f "$SECURITY_VENV/bin/python3")
if setcap 'cap_net_bind_service=+eip cap_net_raw=+eip' "$VENV_PYTHON" 2>/dev/null; then
    msg "Set capabilities on venv python3 (ntlmrelayx/mitm6 can run without sudo)"
else
    warn "Could not set capabilities on $VENV_PYTHON (run privileged tools with sudo)"
fi

# Install Responder
msg "Installing Responder..."
if [[ -d /tmp/Responder ]]; then
    rm -rf /tmp/Responder
fi

if git clone --depth 1 https://github.com/lgandx/Responder.git /tmp/Responder; then
    run_as_user "$REAL_USER" "
        source '$SECURITY_VENV/bin/activate'
        pip install -r /tmp/Responder/requirements.txt
        deactivate
    "

    cp -r /tmp/Responder "$SECURITY_VENV/responder"
    chown -R "$REAL_USER:$REAL_USER" "$SECURITY_VENV/responder"
    chmod +x "$SECURITY_VENV/responder/Responder.py"
    rm -rf /tmp/Responder

    # Disable SMB and HTTP servers in Responder config (avoid conflicts with
    # ntlmrelayx which needs to handle those protocols itself)
    RESPONDER_CONF="$SECURITY_VENV/responder/Responder.conf"
    if [[ -f "$RESPONDER_CONF" ]]; then
        sed -i 's/^SMB = On/SMB = Off/' "$RESPONDER_CONF"
        sed -i 's/^HTTP = On/HTTP = Off/' "$RESPONDER_CONF"
        msg "Responder: disabled SMB and HTTP servers in config"
    fi
else
    warn "Responder clone failed; skipping (install manually from https://github.com/lgandx/Responder)"
fi

# ------------------------------------------------------------------------------
# Phase 5: User Tools (pipx)
# ------------------------------------------------------------------------------

msg "Setting up pipx tools for $REAL_USER..."

# Install Rust first (required for NetExec)
if ! run_as_user "$REAL_USER" "command -v rustc" &>/dev/null; then
    msg "Installing Rust..."
    run_as_user "$REAL_USER" "curl --proto '=https' --tlsv1.2 -sSf https://sh.rustup.rs | sh -s -- -y"
fi

# Setup pipx and install tools
run_as_user "$REAL_USER" "
    export PATH=\"\$HOME/.cargo/bin:\$HOME/.local/bin:\$PATH\"

    # pipx is installed via apt in Phase 1; just make sure its bin dir is on PATH.
    pipx ensurepath || python3 -m pipx ensurepath || true

    pipx install impacket || true
    pipx install 'git+https://github.com/Pennyw0rth/NetExec' || echo 'NetExec install failed - may need manual install'
"

# ------------------------------------------------------------------------------
# Phase 6: BloodHound GUI
# ------------------------------------------------------------------------------

msg "Installing BloodHound GUI..."
mkdir -p "$BLOODHOUND_DIR"

# Legacy BloodHound ships the Linux GUI as a .zip asset (not an AppImage).
BH_ZIP_URL=$(curl -s https://api.github.com/repos/BloodHoundAD/BloodHound/releases/latest \
    | jq -r '.assets[] | select(.name | test("BloodHound-linux-x64.*\\.zip")) | .browser_download_url' \
    | head -1)

if [[ -n "$BH_ZIP_URL" ]]; then
    if wget -q --show-progress -O /tmp/bloodhound-linux.zip "$BH_ZIP_URL" \
        && unzip -o -q /tmp/bloodhound-linux.zip -d "$BLOODHOUND_DIR"; then
        rm -f /tmp/bloodhound-linux.zip

        # Find the BloodHound executable inside the extracted directory.
        BH_BIN=$(find "$BLOODHOUND_DIR" -maxdepth 2 -type f -name 'BloodHound' | head -1)
        if [[ -n "$BH_BIN" ]]; then
            chmod +x "$BH_BIN"
            chown -R "$REAL_USER:$REAL_USER" "$BLOODHOUND_DIR"

            # Create system-wide launcher pointing at the extracted binary.
            cat > /usr/local/bin/bloodhound-gui << EOF
#!/bin/bash
exec "$BH_BIN" --no-sandbox "\$@"
EOF
            chmod +x /usr/local/bin/bloodhound-gui
            msg "BloodHound GUI installed ($BH_BIN)"
        else
            warn "BloodHound archive extracted but no 'BloodHound' binary found"
        fi
    else
        warn "Failed to download/extract BloodHound GUI"
    fi
else
    warn "Could not fetch BloodHound release URL - download manually from:"
    warn "https://github.com/BloodHoundAD/BloodHound/releases/latest"
fi

# ------------------------------------------------------------------------------
# Phase 7: Wrapper Scripts
# ------------------------------------------------------------------------------

msg "Creating wrapper scripts..."

# Responder wrapper
cat > /usr/local/bin/responder << 'EOF'
#!/bin/bash
source /opt/security-tools-venv/bin/activate
cd /opt/security-tools-venv/responder
exec python3 Responder.py "$@"
EOF
chmod +x /usr/local/bin/responder

# Certipy wrapper (venv version)
cat > /usr/local/bin/certipy-venv << 'EOF'
#!/bin/bash
source /opt/security-tools-venv/bin/activate
exec certipy "$@"
EOF
chmod +x /usr/local/bin/certipy-venv

# mitm6 wrapper
cat > /usr/local/bin/mitm6 << 'EOF'
#!/bin/bash
source /opt/security-tools-venv/bin/activate
exec mitm6 "$@"
EOF
chmod +x /usr/local/bin/mitm6

# bloodhound-python wrapper
cat > /usr/local/bin/bloodhound-python << 'EOF'
#!/bin/bash
source /opt/security-tools-venv/bin/activate
exec bloodhound-python "$@"
EOF
chmod +x /usr/local/bin/bloodhound-python

# Create symlinks for pipx tools if they exist
USER_LOCAL_BIN="$USER_HOME/.local/bin"
if [[ -d "$USER_LOCAL_BIN" ]]; then
    for tool in netexec nxc; do
        if [[ -f "$USER_LOCAL_BIN/$tool" ]]; then
            ln -sf "$USER_LOCAL_BIN/$tool" "/usr/local/bin/$tool"
            msg "Created symlink for $tool"
        fi
    done
fi

# ------------------------------------------------------------------------------
# Phase 8: Wordlists
# ------------------------------------------------------------------------------

msg "Setting up wordlists..."
mkdir -p "$WORDLIST_DIR"

# rockyou
if [[ ! -f "$WORDLIST_DIR/rockyou.txt" ]]; then
    msg "Downloading rockyou.txt..."
    # Primary source serves the file as plain text (already uncompressed).
    if wget -q --show-progress \
        -O "$WORDLIST_DIR/rockyou.txt" \
        "https://github.com/brannondorsey/naive-hashcat/releases/download/data/rockyou.txt" \
        2>/dev/null && [[ -s "$WORDLIST_DIR/rockyou.txt" ]]; then
        msg "rockyou.txt installed"
    # Fallback source is bzip2-compressed.
    elif wget -q --show-progress \
        -O "$WORDLIST_DIR/rockyou.txt.bz2" \
        "https://download.g0tmi1k.com/wordlists/large/rockyou.txt.bz2" \
        2>/dev/null && [[ -s "$WORDLIST_DIR/rockyou.txt.bz2" ]]; then
        bunzip2 -f "$WORDLIST_DIR/rockyou.txt.bz2" && msg "rockyou.txt installed"
    else
        rm -f "$WORDLIST_DIR/rockyou.txt" "$WORDLIST_DIR/rockyou.txt.bz2"
        warn "Could not download rockyou.txt automatically"
        warn "Download manually: https://github.com/danielmiessler/SecLists/blob/master/Passwords/Leaked-Databases/rockyou.txt.tar.gz"
    fi
else
    msg "rockyou.txt already present, skipping"
fi

# SecLists
if [[ ! -d "$WORDLIST_DIR/seclists" ]]; then
    msg "Cloning SecLists (this may take a while)..."
    git clone --depth 1 https://github.com/danielmiessler/SecLists.git "$WORDLIST_DIR/seclists"
    msg "SecLists installed at $WORDLIST_DIR/seclists"
else
    msg "SecLists already present, skipping"
fi

# o+rX (capital X) adds execute only to directories, so other users can both
# read the wordlists and traverse SecLists' subdirectories.
chmod -R o+rX "$WORDLIST_DIR"

# ------------------------------------------------------------------------------
# Phase 9: Shell Configuration (Zsh + Oh My Zsh)
# ------------------------------------------------------------------------------

msg "Configuring Zsh..."

chsh -s /usr/bin/zsh "$REAL_USER" || warn "Could not change default shell to zsh for $REAL_USER"

# Install Oh My Zsh for user
if [[ ! -d "$USER_HOME/.oh-my-zsh" ]]; then
    msg "Installing Oh My Zsh..."
    # KEEP_ZSHRC=no lets the installer write its default .zshrc template, which
    # the sed/append steps below depend on (they target robbyrussell/plugins=(git)).
    # Any pre-existing .zshrc is preserved by the installer as .zshrc.pre-oh-my-zsh.
    run_as_user "$REAL_USER" '
        export RUNZSH=no CHSH=no KEEP_ZSHRC=no
        sh -c "$(curl -fsSL https://raw.githubusercontent.com/ohmyzsh/ohmyzsh/master/tools/install.sh)"
    ' || {
        warn "Oh My Zsh install script failed, trying direct clone..."
        git clone --depth 1 https://github.com/ohmyzsh/ohmyzsh.git "$USER_HOME/.oh-my-zsh"
        cp "$USER_HOME/.oh-my-zsh/templates/zshrc.zsh-template" "$USER_HOME/.zshrc"
        chown -R "$REAL_USER:$REAL_USER" "$USER_HOME/.oh-my-zsh" "$USER_HOME/.zshrc"
    }
fi

# Configure .zshrc
if [[ -f "$USER_HOME/.zshrc" ]]; then
    cp "$USER_HOME/.zshrc" "$USER_HOME/.zshrc.backup"

    # Set theme
    sed -i 's/ZSH_THEME="robbyrussell"/ZSH_THEME="agnoster"/' "$USER_HOME/.zshrc"

    # Set plugins
    sed -i 's/plugins=(git)/plugins=(git docker python pip ssh-agent sudo tmux colored-man-pages command-not-found z)/' "$USER_HOME/.zshrc"

    # Add custom configuration
    cat >> "$USER_HOME/.zshrc" << 'ZSHRC'

# --- Security Tools Configuration ---

# PATH — venv/bin is placed LAST so the security tools' entrypoints are on PATH
# without the venv shadowing the system python3/pip in interactive shells.
export PATH="$HOME/.local/bin:$HOME/.cargo/bin:/snap/bin:$PATH:/opt/security-tools-venv/bin"

# Aliases - Security
alias nse='ls /usr/share/nmap/scripts/ | grep'
alias serve='python3 -m http.server'
alias activate-security='source /opt/security-tools-venv/bin/activate'
alias sec-env='source /opt/security-tools-venv/bin/activate'

# Aliases - Proxychains
alias pchains='proxychains4'
alias pc='proxychains4'

# Aliases - Network
alias ports='netstat -tulanp'
alias listening='netstat -tlnp'
alias myip='curl -s ifconfig.me'

# Wordlists
export WORDLISTS="/usr/share/wordlists"
export SECLISTS="/usr/share/wordlists/seclists"
export ROCKYOU="/usr/share/wordlists/rockyou.txt"

# Functions
b64e() { echo -n "$1" | base64; }
b64d() { echo -n "$1" | base64 -d; }
urlencode() { python3 -c "import urllib.parse; print(urllib.parse.quote('$1'))"; }
urldecode() { python3 -c "import urllib.parse; print(urllib.parse.unquote('$1'))"; }
ZSHRC

    chown "$REAL_USER:$REAL_USER" "$USER_HOME/.zshrc"
fi

# ------------------------------------------------------------------------------
# Phase 10: i3 Configuration
# ------------------------------------------------------------------------------

msg "Configuring i3..."

I3_DIR="$USER_HOME/.config/i3"
mkdir -p "$I3_DIR"

cat > "$I3_DIR/config" << 'I3CONFIG'
