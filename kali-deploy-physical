#!/bin/bash

# Kali Physical Deploy Script (kali-deploy-physical)
# Tools come from Kali's own kali-tools-* metapackages
# Installs:
#   - kali-tools-* metapackages (see TOOL_METAS below -- edit to taste)
#   - kali-desktop-i3 (i3 + xorg + kali-desktop-core, session registered with
#     the display manager) plus polybar and kitty
#   - the v5 i3 / polybar / kitty configs
#
# Caveat: the i3 config execs picom with --backend glx hardcoded (picom 13
# has no implicit backend fallback). Verified on Intel Iris Xe (i915) 2026-08-01,
# but not probed -- a box with no usable GLX needs the picom line in the i3
# phase changed to --backend xrender by hand. Not egl: picom 13 still reports
# "the egl backend is still experimental, use with care" at startup.
#
# The i3 phase also writes ~/.config/picom/picom.conf, derived from Kali's.
# Kali's ships options picom 13 deprecated, and picom raises a GUI warning
# dialog for them on every session start -- see the phase for why this is a
# derived copy and not an edit or a fresh config.
#
# Hardening (Phase 4) is deliberately thin. This is a pentest box: a
# default-deny inbound firewall silently eats every reverse shell and every
# Responder capture, MAC cloning gets a VM's traffic dropped by the vSwitch, and
# disabling bluetoothd disables the BT tooling with it. So the phase leaves sshd
# and bluetoothd running, makes sure ufw is NOT default-deny (disabling it if an
# earlier run turned it on), and turns avahi/cups off -- that last one for the
# port conflict, since Responder needs UDP 5353 free, rather than for hardening.
#
# MAC cloning is off unless asked for:
#   --mac-stable   a per-connection-profile MAC. A given network sees the same
#                  address every time, so the DHCP lease survives a reconnect.
#   --mac-random   a fresh MAC per activation. Every reconnect is a new lease
#                  and a new IP, tearing down any long-lived outbound TCP
#                  session on the box -- this shipped as the default once, and
#                  it is why the ScreenConnect relay kept dying with "the
#                  network connection has been disconnected".
#
# Neither is safe unguarded on a VM. A hypervisor's virtual switch forwards only
# frames whose source MAC it handed out -- Hyper-V calls this "Enable MAC
# address spoofing" and ships it off -- so any cloned MAC blackholes the guest,
# stable and random alike, and stays that way across reboots because every boot
# re-applies it. Both flags warn before doing it. Re-running without them
# removes a config an earlier run left behind, which is the fix for a box
# already in that state.
#
# Usage:
#   sudo ./kali-deploy-physical [options]
#
#   --dry-run          show what would happen; change nothing
#   --mac-stable       clone a per-network MAC (off by default)
#   --mac-random       clone a fresh MAC per activation (off by default;
#                      breaks long-lived connections -- see above)
#   --skip <phase>     skip a phase (repeatable)
#   --only <phase>     run only these phases (repeatable)
#   --list-phases      print phase names and exit
#   --print-packages   print every package this script can install
#   --print-checked-binaries
#                      print every binary the verification pass ticks
#   -h, --help         this message
#
# Environment:
#   DOTS_TOKEN         GitHub token, only needed for a private fork. Without it
#                      the dots phase falls back to an SSH key, then `gh auth`,
#                      then a plain anonymous clone, then skips (the rest of
#                      the run is unaffected).
#   DOTS_REPO          owner/name of the shell kit (default owlshells/dots)
#
# Phases: base tools desktop harden i3 polybar kitty shell dots wordlists
#
# Design notes: an installer should keep going when an optional piece fails
# rather than aborting -- you should never have to reinstall the OS because one
# package went missing. We keep -u and pipefail but NOT -e, make every fallible
# step tolerant, and re-running the script is always safe (every phase is
# idempotent). A full transcript is written to /var/log so a failure is
# diagnosable after the fact instead of scrolling off the screen.

set -uo pipefail

# ------------------------------------------------------------------------------
# Configuration
# ------------------------------------------------------------------------------

readonly WORDLIST_DIR="/usr/share/wordlists"
readonly MACCONF="/etc/NetworkManager/conf.d/00-macrandomize.conf"
readonly ZSHRC_MARKER="# >>> kali-deploy-physical >>>"
readonly ZSHRC_END_MARKER="# <<< kali-deploy-physical <<<"
readonly MIN_DISK_GB=20

# Tool metapackages. Kali curates these and resolves their dependencies, so the
# names are stable across rolling in a way a hand-listed set of tools is not.
# Each is probed with apt_available before install: one that Kali renames is a
# clean skip, never an aborted run.
#
# Deliberately omitted: kali-tools-sdr (gnuradio pulls a very large dependency
# tree and needs hardware you may not carry). Add it here if you want it.
TOOL_METAS=(
    kali-tools-information-gathering
    kali-tools-vulnerability
    kali-tools-web
    kali-tools-database
    kali-tools-passwords
    kali-tools-exploitation
    kali-tools-post-exploitation
    kali-tools-sniffing-spoofing
    kali-tools-windows-resources
    kali-tools-reverse-engineering
    kali-tools-802-11
    kali-tools-wireless
    kali-tools-bluetooth
    kali-tools-rfid
)

# Not guaranteed by the metapackages above, or wanted regardless.
# ncat split out of the nmap package on current Debian/Kali; psmisc provides
# the killall that polybar's launch.sh calls.
#
# The AD/web block below is here because the TOOL_METAS closure does NOT contain
# it. Four of them (netexec, bloodhound.py, ffuf, gobuster) happen to ship in
# kali-linux-default, so on a stock ISO they look present -- but that is the
# ISO's doing, not ours, and it evaporates on a netinst. The other three (mitm6,
# certipy-ad, enum4linux-ng) are absent on every install path. All seven were
# being ticked by the verification block while nothing installed them; tests/ T9
# now asserts that can't happen again.
EXTRA_PKGS=(
    ncat
    psmisc
    jq
    unzip
    curl
    wget
    git
    seclists
    wordlists
    ufw

    # The shell this whole script is written around. It was never listed, on the
    # assumption that Kali always ships it and makes it the default -- true of the
    # stock ISO, not true of every install path. When that assumption is wrong the
    # deploy still writes ~/.zshrc and still points kitty at /usr/bin/zsh, and you
    # get a bash login with none of it: no prompt, no recall, no lfcd. The remote
    # script has always listed it; this one now agrees.
    zsh

    # Command library / cheat-sheets. Replaces the hand-maintained snippets
    # that used to live in the dots repo: same {{placeholder}} grammar, 200+
    # sheets, and Kali maintains it so updates arrive via apt.
    arsenal-ng

    # Terminal file manager, for the loot/output tree an engagement leaves
    # behind -- a single static Go binary with no runtime dependencies. Its
    # one Recommends is ueberzug (in-terminal image previews), which is worth
    # having on a box with a display. The shell phase adds the `lfcd` wrapper
    # that makes quitting lf leave you in the directory you ended up in.
    lf

    # What the dots shell kit reaches for at runtime.
    #
    # dots writes the integrations for these and installs none of them -- its
    # tools/install-tools.sh is opt-in and the dots phase deliberately does not
    # run it, because that script also does a pipx install and three `go install`
    # builds, which SPEC.md rules out here. So the tools have to arrive the same
    # way lf does, from the distro.
    #
    # Without them the box deploys clean and the shell is half-wired: ^X^R recall
    # answers "fzf not installed" -- the ledger, the index and the ghost text all
    # unreachable -- `payload` the same, `denv` cannot auto-load an .envrc, `ll`
    # falls back to plain ls, and `listen` drops to bare nc. Verified against the
    # install closure: not one of these arrives with the metapackages.
    #
    # Debian ships bat's binary as batcat; dots' aliases already handle both.
    fzf         # ^X^R recall, payload, and the Ctrl-R/Ctrl-T/Alt-C bindings
    bat         # preview pane in payload and the recall picker
    eza         # the ll alias
    direnv      # denv -- per-engagement .envrc auto-load
    rlwrap      # listen's readline upgrade, ahead of bare nc

    # AD / web tooling not covered by the metapackages above
    netexec
    mitm6
    certipy-ad
    enum4linux-ng
    bloodhound.py
    ffuf
    gobuster
)

# Desktop. kali-desktop-i3 is a full desktop, not just a window manager: it
# pulls kali-desktop-core/base, i3, i3-dotfiles, lightdm, polybar, kitty, picom,
# feh, network-manager, pulseaudio and betterlockscreen. That registers the i3
# session with the display manager for us -- the thing v5 had to hand-patch on
# Ubuntu by adding xorg/xinit itself.
#
# polybar and kitty are already dependencies; they stay listed explicitly
# because this script writes configs for them and should fail loudly if they
# ever leave the metapackage.
#
# Do NOT add i3lock here. kali-desktop-i3 -> betterlockscreen -> i3lock-color,
# and i3lock-color both Conflicts and Provides i3lock, so naming plain i3lock
# makes the whole batch unresolvable (caught by tests/ T2). i3lock-color ships
# /usr/bin/i3lock, so the `i3lock -c` call in the i3 config below still works.
#
# Kali stages its own i3/polybar/kitty configs under /usr/share/i3-dotfiles/
# rather than installing them into $HOME, so they never collide with ours --
# worth a look if you want to borrow anything from them.
DESKTOP_PKGS=(
    kali-desktop-i3
    polybar
    kitty
    xss-lock
    fonts-powerline

    # i3 is a manual tiler: a third window in a horizontal container becomes a
    # third column, forever. autotiling watches the focused window and sets the
    # split along its longer axis, so a tall window splits horizontally and you
    # get one wide pane beside a stack instead of endless columns.
    #
    # --limit 2 in the i3 config turns that into a real master/stack layout: it
    # caps nesting at two levels, so window one holds the left half at full
    # height and everything after it stacks down the right column. Measured at
    # 1920x1200 with five windows that is 960x1200 beside four panes of 960x300,
    # which is the geometry awesome's tile layout gives at nmaster=1, mwfact=0.5.
    # Without the flag autotiling spirals inward instead, each new window halving
    # the last. The one thing this cannot do is awesome's fair layout: that
    # re-flows every window on the screen whenever the count changes, and i3's
    # layout is a persistent tree that only changes where you touch it.
    autotiling

    # All four already arrive inside kali-desktop-i3's dependency tree, but the
    # i3 config below drives them directly -- brightnessctl for the XF86 keys, feh
    # for the wallpaper, wpctl (shipped by wireplumber) for volume, and picom to
    # composite, without which kitty's background_opacity is inert. They are
    # listed for the same reason polybar and kitty are: if one ever leaves the
    # metapackage this should fail loudly here, not quietly deploy a config full
    # of keybindings that do nothing and a terminal that comes up solid.
    #
    # wireplumber is the one worth watching. kali-desktop-i3's *top-level*
    # dependency is pulseaudio and wireplumber only appears deeper in the tree, so
    # the config's use of wpctl over pactl is betting on pipewire winning the seat.
    brightnessctl
    feh
    wireplumber
    picom

    # Pillow, for the owl behind the terminal. dots' install.sh renders it from a
    # tracked mask with terminal/mkowl.py, whose only dependency this is, and
    # bails with "skip owl (needs Pillow)" when it is missing -- one line in a
    # long install log, on a box that otherwise deployed perfectly.
    #
    # It is in the install closure today without being asked for: lf Recommends
    # ueberzug, which Depends on it, and with 3000+ packages resolved there are
    # likely other paths too. Listed here for the same reason brightnessctl and
    # feh are -- something we ship drives it directly, so it should be a declared
    # dependency rather than a lucky one, and its disappearance should be a
    # resolution failure here instead of a bare terminal you notice weeks later.
    python3-pil
)

readonly ALL_PHASES=(base tools desktop harden i3 polybar kitty shell dots wordlists)

# Binaries the verification pass ticks at the end of a run. These are BINARY
# names, not package names: certipy-ad ships /usr/bin/certipy-ad, while
# /usr/bin/certipy belongs to python3-certipy, an unrelated cert library.
#
# tests/ T9 asserts every name here is actually delivered by the package set
# above. Ticking a tool nothing installs is the failure this list caused once
# already -- seven tools were verified and never installed, and you'd only find
# out on the hardware.
VERIFY_BINS_TOOLS=(
    nmap ncat hashcat john netexec impacket-ntlmrelayx responder
    mitm6 certipy-ad enum4linux-ng bloodhound-python proxychains4
    aircrack-ng wifite hcxdumptool bettercap sqlmap ffuf gobuster
)
VERIFY_BINS_DESKTOP=(
    i3 polybar kitty dmenu_run i3lock xss-lock Xorg
    brightnessctl wpctl feh autotiling
)

# Colors
readonly RED='\033[0;31m'
readonly GREEN='\033[0;32m'
readonly YELLOW='\033[1;33m'
readonly BLUE='\033[0;34m'
readonly NC='\033[0m'

DRY_RUN=0
MAC_STABLE=0
MAC_RANDOM=0
SKIP_PHASES=()
ONLY_PHASES=()

# ------------------------------------------------------------------------------
# Helper Functions
# ------------------------------------------------------------------------------

# warn/err go to stderr so they don't get captured by $(...) command
# substitutions (e.g. get_real_user) and so they're visible on the error path.
msg()   { echo -e "${GREEN}[+]${NC} $1"; }
warn()  { echo -e "${YELLOW}[*]${NC} $1" >&2; }
err()   { echo -e "${RED}[!]${NC} $1" >&2; }
phase() { echo -e "\n${BLUE}=== $1 ===${NC}"; }

# Help text is the header comment block itself. Read it structurally -- from
# line 3 to the first line that isn't a comment -- rather than by hardcoded line
# numbers, so editing the header can't leak code into --help.
usage() {
    awk 'NR>2 { if (/^#/) { sub(/^# ?/, ""); print } else { exit } }' "$0"
    exit 0
}

get_real_user() {
    if [[ -n "${SUDO_USER:-}" ]] && [[ "$SUDO_USER" != "root" ]]; then
        echo "$SUDO_USER"
    else
        err "This script must be run with sudo, not as root directly"
        err "Usage: sudo $0"
        exit 1
    fi
}

get_user_home() {
    getent passwd "$1" | cut -d: -f6
}

# Every mutating command goes through run() so --dry-run is honoured in one
# place rather than being sprinkled through each phase.
run() {
    if (( DRY_RUN )); then
        echo -e "${YELLOW}[dry-run]${NC} $*"
        return 0
    fi
    "$@"
}

# Write a heredoc to a file, honouring --dry-run. Reads content from stdin.
write_file() {
    local dst="$1" mode="${2:-}"
    if (( DRY_RUN )); then
        echo -e "${YELLOW}[dry-run]${NC} write $dst"
        cat >/dev/null
        return 0
    fi
    mkdir -p "$(dirname "$dst")"
    cat > "$dst" || { err "could not write $dst"; return 1; }
    [[ -n "$mode" ]] && chmod "$mode" "$dst"
    return 0
}

should_run() {
    local p="$1" x
    if (( ${#ONLY_PHASES[@]} )); then
        for x in "${ONLY_PHASES[@]}"; do [[ "$x" == "$p" ]] && return 0; done
        return 1
    fi
    for x in "${SKIP_PHASES[@]}"; do [[ "$x" == "$p" ]] && return 1; done
    return 0
}

is_phase() {
    local p="$1" x
    for x in "${ALL_PHASES[@]}"; do [[ "$x" == "$p" ]] && return 0; done
    return 1
}

# True if apt has an installation candidate for the package on THIS system.
# Lets us skip packages that were renamed/removed instead of aborting the batch.
apt_available() {
    local cand
    cand=$(apt-cache policy "$1" 2>/dev/null | awk '/Candidate:/ {print $2}')
    [[ -n "$cand" && "$cand" != "(none)" ]]
}

# Install a list of apt packages, falling back to one-by-one so that a single
# unavailable package doesn't take down the entire batch. In the fallback we
# probe availability first so a removed/renamed package is a clean skip.
apt_install() {
    (( $# )) || return 0
    if (( DRY_RUN )); then
        echo -e "${YELLOW}[dry-run]${NC} apt-get install -y $*"
        return 0
    fi
    if apt-get install -y "$@"; then
        return 0
    fi
    warn "Bulk apt install failed; retrying packages individually..."
    for pkg in "$@"; do
        if apt_available "$pkg"; then
            apt-get install -y "$pkg" || warn "Could not install '$pkg' (skipping)"
        else
            warn "Package '$pkg' not available on this system (skipping)"
        fi
    done
}

# Install the FIRST package from the list that this system actually offers.
apt_install_first() {
    local label="$1"; shift
    local pkg
    for pkg in "$@"; do
        if apt_available "$pkg"; then
            if (( DRY_RUN )); then
                echo -e "${YELLOW}[dry-run]${NC} $label: would install '$pkg'"
                return 0
            fi
            if apt-get install -y "$pkg"; then
                msg "$label: installed '$pkg'"
                return 0
            fi
        fi
    done
    warn "$label: none of [$*] are available (skipping)"
    return 1
}

# Disable and mask a systemd unit if it exists. Guarded for containers/WSL where
# there is no systemd at all.
# Report what actually happened. The earlier version warned on failure and then
# unconditionally claimed success, so a unit that refused to stop logged both
# "could not disable" and "disabled" -- and --dry-run reported units disabled
# that were never touched.
disable_unit() {
    local unit="$1" why="$2"
    systemctl list-unit-files "$unit" &>/dev/null || return 0
    systemctl cat "$unit" &>/dev/null || return 0

    if (( DRY_RUN )); then
        echo -e "${YELLOW}[dry-run]${NC} systemctl disable --now $unit ($why)"
    elif systemctl disable --now "$unit" 2>/dev/null; then
        msg "disabled $unit ($why)"
    else
        warn "could not disable $unit ($why)"
    fi
}

# ------------------------------------------------------------------------------
# Argument parsing
# ------------------------------------------------------------------------------

while (( $# )); do
    case "$1" in
        --dry-run)      DRY_RUN=1; shift ;;
        --mac-stable)   MAC_STABLE=1; shift ;;
        --mac-random)   MAC_RANDOM=1; shift ;;
        --skip)         [[ -n "${2:-}" ]] || { err "--skip needs a phase"; exit 1; }
                        SKIP_PHASES+=("$2"); shift 2 ;;
        --only)         [[ -n "${2:-}" ]] || { err "--only needs a phase"; exit 1; }
                        ONLY_PHASES+=("$2"); shift 2 ;;
        --list-phases)  printf '%s\n' "${ALL_PHASES[@]}"; exit 0 ;;
        # Every package name this script can install, one per line. The test
        # harness reads its package list from here so it can never drift out of
        # sync with the arrays above.
        --print-packages)
                        printf '%s\n' "${TOOL_METAS[@]}" "${EXTRA_PKGS[@]}" \
                                      "${DESKTOP_PKGS[@]}"; exit 0 ;;
        # Every binary the verification pass ticks. T9 cross-checks these
        # against the install closure of --print-packages.
        --print-checked-binaries)
                        printf '%s\n' "${VERIFY_BINS_TOOLS[@]}" \
                                      "${VERIFY_BINS_DESKTOP[@]}"; exit 0 ;;
        -h|--help)      usage ;;
        *)              err "unknown option: $1"; err "try --help"; exit 1 ;;
    esac
done

for p in "${SKIP_PHASES[@]}" "${ONLY_PHASES[@]}"; do
    is_phase "$p" || { err "unknown phase: $p"; err "valid: ${ALL_PHASES[*]}"; exit 1; }
done

# ------------------------------------------------------------------------------
# Pre-flight Checks
# ------------------------------------------------------------------------------

if [[ $EUID -ne 0 ]]; then
    err "This script must be run with sudo"
    exit 1
fi

# get_real_user's `exit 1` only exits the command-substitution subshell, so we
# must check its status and exit the parent ourselves (no `set -e` to do it).
REAL_USER=$(get_real_user) || exit 1
USER_HOME=$(get_user_home "$REAL_USER")

if [[ -z "$REAL_USER" || -z "$USER_HOME" ]]; then
    err "Could not determine the target user or home directory"
    exit 1
fi

# Log everything. A deploy that fails 40 minutes in is only debuggable if the
# transcript outlived the scrollback. Skipped for --dry-run (nothing to record).
LOGFILE="/var/log/kali-deploy-physical-$(date +%Y%m%d-%H%M%S).log"
if (( ! DRY_RUN )); then
    exec > >(tee -a "$LOGFILE") 2>&1
fi

phase "Pre-flight"
msg "User:      $REAL_USER ($USER_HOME)"
(( DRY_RUN )) && msg "Mode:      DRY RUN (nothing will be changed)" \
              || msg "Log:       $LOGFILE"

# Kali check -- advisory, not fatal. /etc/os-release on kali-rolling has ID=kali
# but NO VERSION_ID, so never branch on version: under `set -u` that is a crash.
distro_id="$(. /etc/os-release 2>/dev/null && echo "${ID:-unknown}")"
if [[ "$distro_id" != "kali" ]]; then
    warn "This does not look like Kali (ID=$distro_id)."
    warn "The kali-tools-* metapackages and kali-desktop-i3 will not resolve."
    warn "Continuing anyway -- every package is probed before install."
else
    msg "Distro:    Kali ($(. /etc/os-release 2>/dev/null && echo "${VERSION_ID:-rolling}"))"
fi

# Disk. The metapackage set is large; running out of space mid-install is the
# other classic way a deploy strands you.
avail_gb=$(df -BG --output=avail / 2>/dev/null | tail -1 | tr -dc '0-9')
if [[ -n "$avail_gb" ]]; then
    if (( avail_gb < MIN_DISK_GB )); then
        warn "Only ${avail_gb}G free on / (recommended: ${MIN_DISK_GB}G+)"
        warn "The tool metapackages may not fit. Ctrl-C now if that's a problem."
        sleep 5
    else
        msg "Disk:      ${avail_gb}G free on /"
    fi
fi

# Network. Cheap check so we fail loudly here rather than confusingly later.
if getent hosts http.kali.org >/dev/null 2>&1; then
    msg "Network:   kali mirror resolves"
else
    warn "Cannot resolve http.kali.org -- apt phases will likely fail"
fi

(( ${#SKIP_PHASES[@]} )) && msg "Skipping:  ${SKIP_PHASES[*]}"
(( ${#ONLY_PHASES[@]} )) && msg "Only:      ${ONLY_PHASES[*]}"

# ------------------------------------------------------------------------------
# Phase: base -- apt update / full-upgrade, debconf pre-seed
# ------------------------------------------------------------------------------

if should_run base; then
    phase "Phase: base"

    # Kali is a rolling release: `upgrade` can hold back packages and leave a
    # partially-upgraded system, which is a documented way to break it.
    # full-upgrade is the supported path.
    export DEBIAN_FRONTEND=noninteractive

    msg "Updating package lists..."
    run apt-get update || warn "apt-get update reported errors (continuing)"

    msg "Full-upgrading (rolling release; 'upgrade' is not safe here)..."
    run apt-get -y full-upgrade || warn "full-upgrade reported errors (continuing)"

    # Several packages inside the chosen metapackages ask debconf questions and
    # will HANG an unattended run waiting for an answer. DEBIAN_FRONTEND alone
    # picks the default; pre-seeding picks *our* answer. All three below are
    # security-relevant, and the safe answer is "no".
    #   wireshark-common -- give dumpcap setuid so non-root users can capture
    #   kismet           -- same question, plus which users to add
    #   macchanger       -- change MAC automatically on every ifup
    msg "Pre-seeding debconf (prevents interactive hangs mid-install)..."
    if (( DRY_RUN )); then
        echo -e "${YELLOW}[dry-run]${NC} debconf-set-selections <<< (wireshark/kismet/macchanger)"
    else
        debconf-set-selections <<'PRESEED' || warn "debconf pre-seed failed"
wireshark-common wireshark-common/install-setuid boolean false
kismet kismet/install-setuid boolean false
kismet kismet/install-users string
macchanger macchanger/automatically_run boolean false
PRESEED
    fi
fi

# ------------------------------------------------------------------------------
# Phase: tools -- kali-tools-* metapackages
# ------------------------------------------------------------------------------

if should_run tools; then
    phase "Phase: tools"

    export DEBIAN_FRONTEND=noninteractive

    available_metas=()
    for m in "${TOOL_METAS[@]}"; do
        if apt_available "$m"; then
            available_metas+=("$m")
        else
            warn "metapackage '$m' not available (skipping)"
        fi
    done

    if (( ${#available_metas[@]} )); then
        msg "Installing ${#available_metas[@]} tool metapackages (this takes a while)..."
        # One at a time: these are big, and a failure in one shouldn't cost you
        # the other thirteen. Each is already known-available from the probe.
        for m in "${available_metas[@]}"; do
            msg "  -> $m"
            apt_install "$m"
        done
    else
        warn "No tool metapackages available -- is this actually Kali?"
    fi

    msg "Installing extra packages..."
    apt_install "${EXTRA_PKGS[@]}"

    apt_install_first "Java runtime" default-jre-headless default-jre \
        openjdk-21-jre-headless openjdk-17-jre-headless
fi

# ------------------------------------------------------------------------------
# Phase: desktop -- kali-desktop-i3 + polybar + kitty
# ------------------------------------------------------------------------------

if should_run desktop; then
    phase "Phase: desktop"

    export DEBIAN_FRONTEND=noninteractive

    msg "Installing i3 desktop..."
    apt_install "${DESKTOP_PKGS[@]}"

    # Make kitty the x-terminal-emulator so anything that shells out to a
    # terminal gets the one we configured.
    if command -v kitty &>/dev/null; then
        run update-alternatives --install /usr/bin/x-terminal-emulator \
            x-terminal-emulator /usr/bin/kitty 50 || true
        run update-alternatives --set x-terminal-emulator /usr/bin/kitty || true
    fi

    # --- A patched font, so the dots prompt has glyphs to draw with.
    #
    # dots' prompt uses three codepoints from the Nerd Fonts private use area
    # (U+F0054, U+E725, U+F4DF). Nothing in DESKTOP_PKGS can render them:
    # fonts-powerline covers U+E0A0-E0D4 and stops, and Debian's
    # fonts-jetbrains-mono is the *unpatched* upstream family, which has no PUA
    # glyphs at all. The patched build ships only in the nerd-fonts GitHub
    # release, so it is fetched rather than apt-installed -- the one network
    # dependency in this phase.
    #
    # Deliberately non-fatal. If the fetch fails the shell phase probes for
    # coverage and tells the prompt to fall back to ASCII, so a box with no
    # network still ends up with a readable prompt rather than three tofu boxes.
    NERD_FONT_VER="v3.4.0"
    NERD_FONT_DIR="/usr/local/share/fonts/NerdFonts/JetBrainsMono"
    NERD_FONT_URL="https://github.com/ryanoasis/nerd-fonts/releases/download/${NERD_FONT_VER}/JetBrainsMono.tar.xz"

    if compgen -G "$NERD_FONT_DIR/*.ttf" >/dev/null 2>&1; then
        msg "JetBrainsMono Nerd Font already installed"
    elif (( DRY_RUN )); then
        echo -e "${YELLOW}[dry-run]${NC} fetch $NERD_FONT_URL into $NERD_FONT_DIR"
    else
        msg "Installing JetBrainsMono Nerd Font ${NERD_FONT_VER}..."
        NERD_TMP="$(mktemp -d)"
        # --wildcards keeps the archive's licence and readme out of the font
        # directory; fc-cache only wants the faces.
        if curl -fsSL --retry 3 --connect-timeout 15 \
                "$NERD_FONT_URL" -o "$NERD_TMP/JetBrainsMono.tar.xz" \
           && mkdir -p "$NERD_FONT_DIR" \
           && tar -xf "$NERD_TMP/JetBrainsMono.tar.xz" -C "$NERD_FONT_DIR" \
                  --wildcards '*.ttf'; then
            fc-cache -f "$NERD_FONT_DIR" >/dev/null 2>&1
            msg "JetBrainsMono Nerd Font installed to $NERD_FONT_DIR"
        else
            warn "could not install the Nerd Font -- the prompt will use ASCII"
            rm -rf "$NERD_FONT_DIR"
        fi
        rm -rf "$NERD_TMP"
    fi

fi

# ------------------------------------------------------------------------------
# Phase: harden -- keep the box quiet without getting in the tooling's way
# ------------------------------------------------------------------------------
#
# This is a pentest box, so "hardening" here is deliberately thin. The controls
# a general-purpose baseline would apply are the same ones that break the tools
# this script exists to install: a default-deny inbound firewall silently eats
# every reverse shell and every Responder capture, MAC cloning gets a VM's
# traffic dropped by the vSwitch, and disabling bluetoothd disables the BT
# tooling along with it. An engagement lost to a control nobody asked for is a
# worse outcome than a slightly noisier laptop.
#
# What survives is the part that is operationally useful anyway -- see below --
# plus opt-in flags for the rest.

if should_run harden; then
    phase "Phase: harden"

    # --- avahi and cups off. This is a port-conflict fix, not hardening:
    # avahi-daemon holds UDP 5353 and cups holds 631, and Responder needs 5353
    # free to poison mDNS. It binds what it can and stays quiet about the rest,
    # so the failure is a capture that never happens rather than an error. Both
    # daemons also advertise the host on a network where that is unhelpful,
    # which is the reason they were originally listed here.
    disable_unit avahi-daemon.service "frees UDP 5353 for Responder"
    disable_unit avahi-daemon.socket  "frees UDP 5353 for Responder"
    disable_unit cups.service         "frees 631, and stops printer chatter"
    disable_unit cups-browsed.service "printer discovery"

    # --- sshd and bluetoothd are deliberately left alone.
    #
    # sshd: this box is reached remotely, and a remote-access agent that depends
    # on X, the display manager and a vendor relay is a single point of failure.
    # sshd is the way back in when that breaks, and it is the pivot/forwarding
    # path during an engagement besides.
    #
    # bluetoothd: the BT tools this script installs drive it. Disabling the
    # daemon while installing the tooling meant the tooling did not work.

    # --- MAC cloning. Off unless asked for.
    #
    # --mac-stable  clones a per-connection-profile MAC: a given network sees
    #               the same address every time, so the DHCP lease persists.
    # --mac-random  re-draws on every activation. Every reconnect is a new lease
    #               and a new IP, which tears down any long-lived outbound TCP
    #               session -- a remote-access agent on this box will drop each
    #               time NetworkManager reconnects. This is what shipped by
    #               default once, and it is why the ScreenConnect relay kept
    #               dying with "the network connection has been disconnected".
    #
    # Neither is safe unguarded on a VM: a hypervisor's virtual switch forwards
    # only frames whose source MAC it assigned to the vNIC. Hyper-V exposes that
    # as "Enable MAC address spoofing" on the adapter's Advanced Features and
    # ships it off, and with it off a cloned MAC blackholes the guest, stable
    # and random alike, and stays that way across reboots because every boot
    # re-applies it. The flags still work there; they just warn first.
    if systemd-detect-virt --quiet 2>/dev/null; then
        MAC_VIRT=$(systemd-detect-virt 2>/dev/null) || MAC_VIRT="a hypervisor"
    else
        MAC_VIRT=""
    fi

    MAC_MODE=""
    (( MAC_STABLE )) && MAC_MODE="stable"
    (( MAC_RANDOM )) && MAC_MODE="random"

    if [[ -z "$MAC_MODE" ]]; then
        # Remove rather than merely decline to write. A box deployed by an
        # earlier version still has this file, and on a VM that file is why its
        # network is down. Re-running the script is the documented way to fix a
        # box, so it has to undo what an earlier run did.
        if [[ -f "$MACCONF" ]]; then
            if run rm -f "$MACCONF"; then
                msg "removed $MACCONF left by an earlier run"
                run systemctl reload NetworkManager 2>/dev/null \
                    || warn "could not reload NetworkManager (applies on next start)"
            else
                warn "could not remove $MACCONF"
            fi
        else
            msg "MAC cloning off (--mac-stable / --mac-random to enable)"
        fi
    else
        if [[ "$MAC_MODE" == "random" ]]; then
            MAC_NOTE="fresh MAC per activation -- long-lived connections will drop"
        else
            MAC_NOTE="per-network MAC -- the DHCP lease survives a reconnect"
        fi

        if [[ -n "$MAC_VIRT" ]]; then
            warn "MAC cloning requested on a $MAC_VIRT guest"
            warn "  the host must have MAC spoofing enabled or this box loses the network"
        fi

        msg "Configuring NetworkManager MAC cloning ($MAC_MODE)..."
        write_file "$MACCONF" <<NMCONF
# Managed by kali-deploy-physical -- MAC cloning (opt-in).
# scan-rand-mac-address randomizes the MAC used while scanning for networks;
# cloned-mac-address hides the hardware MAC when associating. Delete this file
# to restore stock behaviour (captive portals, MAC-allowlisted networks and
# hypervisors that don't permit MAC spoofing will all need you to).
#
# Mode here is "$MAC_MODE": $MAC_NOTE.
[device]
wifi.scan-rand-mac-address=yes

[connection]
wifi.cloned-mac-address=$MAC_MODE
ethernet.cloned-mac-address=$MAC_MODE
NMCONF
        msg "  $MAC_NOTE"
        run systemctl reload NetworkManager 2>/dev/null \
            || warn "could not reload NetworkManager (applies on next start)"
    fi

    # --- Firewall. Explicitly NOT default-deny inbound.
    #
    # This is the control that cost the most. Half the toolset here is a
    # listener: msfconsole handlers and nc catchers, Responder on 445/139/80/
    # 443/5355, ntlmrelayx, impacket-smbserver, a python http.server delivering
    # a payload. Every one of them binds successfully behind a default-deny
    # policy and then catches nothing, which is a failure you debug from the
    # target end, mid-engagement, having forgotten the firewall exists.
    #
    # An earlier run enabled ufw, so leaving it alone is not enough -- a
    # re-deploy has to put the box back. ufw stays installed; `fw-open` and
    # `fw-status` (see the shell phase) are there when a specific engagement
    # wants a policy, and that is a decision to make deliberately rather than
    # one to inherit from a deploy script.
    if command -v ufw &>/dev/null; then
        if ufw status 2>/dev/null | grep -q "Status: active"; then
            if run ufw --force disable; then
                # Not "disabled ..." -- tests/ T6 greps for that wording to catch
                # the phase claiming it disabled a systemd unit it never touched.
                msg "turned ufw off (default-deny inbound breaks listeners)"
            else
                warn "ufw: could not disable"
            fi
        else
            msg "ufw inactive -- left that way (see fw-open/fw-status)"
        fi
    fi
fi

# ------------------------------------------------------------------------------
# Phase: i3 -- window manager config
# ------------------------------------------------------------------------------

if should_run i3; then
    phase "Phase: i3"

    I3_DIR="$USER_HOME/.config/i3"

    # Back up only what we didn't write. Copying unconditionally meant the second
    # run overwrote the backup with our own generated config, so the original was
    # recoverable exactly once.
    if [[ -f "$I3_DIR/config" && ! -f "$I3_DIR/config.backup" ]]; then
        run cp "$I3_DIR/config" "$I3_DIR/config.backup"
        msg "backed up the existing i3 config to config.backup"
    fi

    write_file "$I3_DIR/config" <<'I3CONFIG'
# i3 config -- kali-deploy-physical
# Mod is Super/Windows (Mod4). This box is bare metal, so nothing upstream
# swallows the Super key the way a hypervisor or a remote desktop client does --
# and leaving Alt free means i3 never shadows an application's own Alt+<key>.
#
# It was Mod1 until now, carried over from the Ubuntu recipe (and briefly back to
# Mod1 by PR #1). Changed deliberately: on hardware you sit at, Super is the key
# with no other owner.

set $mod Mod4

font pango:monospace 8

# Borders: 2px edge, no titlebar. Floating windows match, otherwise they keep
# the default titlebar and look inconsistent with the tiled ones.
default_border pixel 2
default_floating_border pixel 2

# Colors. i3's built-in client.focused is blue (#4C7899 border, #285577 title,
# #2E9EF4 indicator); these are greys off the same dark palette as the i3lock
# background below. The other client.* defaults are already neutral, so they
# are left alone. The text field only shows in stacking/tabbed layouts, which
# draw titlebars regardless of default_border.
#                       border  bground text    indicator child_border
client.focused          #5c5f66 #3a3d42 #dadada #7f838a   #5c5f66

# client.urgent was left at i3's own default (#900000, a harsh near-pure
# red) -- it stood out badly against this palette. #B2A1C0 instead: the
# same lavender polybar calls "primary" and dots' prompt.zsh uses for its
# icon glyphs (VINNY_ICON) -- the one hue-distinct accent already in use
# everywhere else on the box, rather than a new colour just for this.
client.urgent           #b2a1c0 #3a3d42 #dadada #b2a1c0   #b2a1c0

# Terminal
bindsym $mod+Return exec kitty

# Kill window
bindsym $mod+Shift+q kill

# Launcher
bindsym $mod+d exec dmenu_run

# Focus
bindsym $mod+h focus left
bindsym $mod+j focus down
bindsym $mod+k focus up
bindsym $mod+l focus right
bindsym $mod+Left focus left
bindsym $mod+Down focus down
bindsym $mod+Up focus up
bindsym $mod+Right focus right

# Move
bindsym $mod+Shift+h move left
bindsym $mod+Shift+j move down
bindsym $mod+Shift+k move up
bindsym $mod+Shift+l move right
bindsym $mod+Shift+Left move left
bindsym $mod+Shift+Down move down
bindsym $mod+Shift+Up move up
bindsym $mod+Shift+Right move right

# Split
bindsym $mod+b split h
bindsym $mod+v split v

# Fullscreen
bindsym $mod+f fullscreen toggle

# Layout
bindsym $mod+s layout stacking
bindsym $mod+w layout tabbed
bindsym $mod+e layout toggle split

# Floating
bindsym $mod+Shift+space floating toggle
bindsym $mod+space focus mode_toggle

# Parent container
bindsym $mod+a focus parent

# Workspaces
set $ws1 "1"
set $ws2 "2"
set $ws3 "3"
set $ws4 "4"
set $ws5 "5"
set $ws6 "6"
set $ws7 "7"
set $ws8 "8"
set $ws9 "9"
set $ws10 "10"

bindsym $mod+1 workspace number $ws1
bindsym $mod+2 workspace number $ws2
bindsym $mod+3 workspace number $ws3
bindsym $mod+4 workspace number $ws4
bindsym $mod+5 workspace number $ws5
bindsym $mod+6 workspace number $ws6
bindsym $mod+7 workspace number $ws7
bindsym $mod+8 workspace number $ws8
bindsym $mod+9 workspace number $ws9
bindsym $mod+0 workspace number $ws10

bindsym $mod+Shift+1 move container to workspace number $ws1
bindsym $mod+Shift+2 move container to workspace number $ws2
bindsym $mod+Shift+3 move container to workspace number $ws3
bindsym $mod+Shift+4 move container to workspace number $ws4
bindsym $mod+Shift+5 move container to workspace number $ws5
bindsym $mod+Shift+6 move container to workspace number $ws6
bindsym $mod+Shift+7 move container to workspace number $ws7
bindsym $mod+Shift+8 move container to workspace number $ws8
bindsym $mod+Shift+9 move container to workspace number $ws9
bindsym $mod+Shift+0 move container to workspace number $ws10

# Reload/Restart
bindsym $mod+Shift+c reload
bindsym $mod+Shift+r restart
bindsym $mod+Shift+e exec "i3-nagbar -t warning -m 'Exit i3?' -B 'Yes' 'i3-msg exit'"

# Resize mode
mode "resize" {
    bindsym h resize shrink width 10 px or 10 ppt
    bindsym j resize grow height 10 px or 10 ppt
    bindsym k resize shrink height 10 px or 10 ppt
    bindsym l resize grow width 10 px or 10 ppt
    bindsym Left resize shrink width 10 px or 10 ppt
    bindsym Down resize grow height 10 px or 10 ppt
    bindsym Up resize shrink height 10 px or 10 ppt
    bindsym Right resize grow width 10 px or 10 ppt
    bindsym Return mode "default"
    bindsym Escape mode "default"
    bindsym $mod+r mode "default"
}
bindsym $mod+r mode "resize"

# Polybar
exec_always --no-startup-id $HOME/.config/polybar/launch.sh

# Automatic split direction. i3 itself has no rule for this -- for_window matches
# window properties and never a window count, and workspace_layout is a single
# global default -- so it takes an IPC client. autotiling sets the split on the
# focused window from its shape: taller than wide gets splitv, wider than tall
# gets splith. On this 1920x1200 panel that means window two lands beside window
# one, and window three lands *below* window two, since window two is 960x1200
# by then. Resize a column past square and the direction flips, because the rule
# is geometry and not ordinal position.
#
# --limit 2 is what makes it master/stack rather than a spiral: it caps nesting at
# two levels, so window one keeps the left half at full height and every window
# after it stacks down the right column instead of subdividing whichever window
# was opened last. Measured at 1920x1200 with five windows, that is 960x1200 on
# the left and four panes of 960x300 on the right -- the same geometry awesome's
# tile layout produces at nmaster=1, mwfact=0.5.
#
# Drop the flag and you get autotiling's default inward spiral, where window four
# halves window three, window five halves window four, and so on down.
#
# Note this line only fires at i3 startup and on restart ($mod+Shift+r), not on
# reload ($mod+Shift+c) -- despite the common claim otherwise, exec_always is
# documented and observed to re-run on restart alone. Editing this block and
# pressing $mod+Shift+c will not pick it up.
#
# flock is the single-instance guard, since autotiling has none of its own: the
# lock is held for the process lifetime, so a second copy exits immediately
# instead of piling up behind a restart. pkill is the usual advice here and the
# wrong tool -- every -f pattern that matches autotiling also matches the shell
# i3 starts it from, so it kills its own replacement.
exec_always --no-startup-id flock -n $XDG_RUNTIME_DIR/autotiling.lock autotiling --limit 2

# Wallpaper. Indirect through ~/.fehbg, which feh rewrites every time it sets a
# background -- so changing wallpaper later is just `feh --bg-fill <image>` with
# no edit here and no reload.
#
# This script owns the mechanism and not the image: dots' install.sh writes
# ~/.fehbg during the dots phase, the same way it appends the owl to kitty.conf.
# What the box looks like is that repo's job; what is installed on it is this
# one's. The guard matters more for it: a box whose dots phase skipped for want
# of credentials has no ~/.fehbg at all, and i3 must not log a failed exec on
# every reload because of it.
exec_always --no-startup-id [ -x $HOME/.fehbg ] && $HOME/.fehbg

# Compositor. picom arrives inside kali-desktop-i3's tree but nothing starts
# it, which is why this line exists.
#
# --backend glx is required explicitly: picom 13 dropped its implicit backend
# fallback, and Kali's /etc/xdg/picom.conf doesn't set one either, so a bare
# `picom` now hard-fails with "Backend not specified" instead of composing.
# glx is what Intel iGPUs (i915, AIGLX/DRI2) support; drop to --backend
# xrender by hand if a box turns out to have no usable GLX.
#
# Foreground under flock, not `picom -b`: -b daemonises, the parent exits, and
# flock releases the lock the moment it does -- which would leave the guard
# guarding nothing. Same single-instance reasoning as autotiling above.
exec_always --no-startup-id flock -n $XDG_RUNTIME_DIR/picom.lock picom --backend glx

# Brightness. brightnessctl writes /sys/class/backlight/<dev>/brightness, which
# udev makes group-writable by `video` -- the user is already in that group on a
# normal install, so this needs no sudo and no setuid helper. -n keeps the floor
# at 1: without it, holding the down key blacks the panel out completely and the
# way back is a keypress you can no longer see to aim.
bindsym XF86MonBrightnessUp   exec --no-startup-id brightnessctl -n set 5%+
bindsym XF86MonBrightnessDown exec --no-startup-id brightnessctl -n set 5%-

# Volume. wpctl is wireplumber's control tool: Kali runs pipewire, so pactl
# would be talking to the pulse compatibility shim rather than the real server.
# -l caps at 100% -- without it, repeated presses push the sink into software
# amplification, which distorts rather than getting louder.
bindsym XF86AudioRaiseVolume exec --no-startup-id wpctl set-volume -l 1.0 @DEFAULT_AUDIO_SINK@ 5%+
bindsym XF86AudioLowerVolume exec --no-startup-id wpctl set-volume -l 1.0 @DEFAULT_AUDIO_SINK@ 5%-
bindsym XF86AudioMute        exec --no-startup-id wpctl set-mute @DEFAULT_AUDIO_SINK@ toggle
bindsym XF86AudioMicMute     exec --no-startup-id wpctl set-mute @DEFAULT_AUDIO_SOURCE@ toggle

# Lock screen -- manual, plus on suspend. No idle timeout.
#
# It used to lock after 5 minutes idle (`xset s 300 300`). On a box reached over
# a remote session that mostly means coming back to a lock screen in the middle
# of an engagement, and a long-running job you were watching is behind it. The
# threat it answered -- an unattended unlocked laptop on a conference floor --
# isn't the one a VM faces. `xset s off` kills the idle timer.
#
# xss-lock stays: with no screensaver timeout it only fires on suspend, which is
# worth keeping and costs nothing during normal work.
#
# betterlockscreen wraps i3lock-color: it caches a scaled copy of the lock image
# per resolution and passes the styling from ~/.config/betterlockscreenrc, which
# is a great deal of i3lock-color flags not to have to carry on this line.
#
# Both paths go through owl-lock, a two-line wrapper this script writes, rather
# than calling betterlockscreen directly. betterlockscreen -l fails closed when
# its cache is missing -- and leaves the screen UNLOCKED. That is the one
# outcome this binding must never produce, so the wrapper falls back to plain
# i3lock. Putting it in a script rather than on the bindsym line is what lets
# the xss-lock path have the same fallback: xss-lock takes a command, not a
# shell expression, so `a || b` written here would protect the keybinding and
# silently not protect the idle timeout.
#
# The cache is built by the dots phase. Rebuilt here when absent because
# betterlockscreen -u shells out to xrandr, so it cannot run at deploy time from
# a TTY or over SSH -- only from inside a session, which is what this is.
exec --no-startup-id [ -d $HOME/.cache/betterlockscreen ] || \
    betterlockscreen -u /usr/share/backgrounds/owlshells/lock.png

bindsym $mod+Escape exec --no-startup-id owl-lock
exec --no-startup-id xss-lock --transfer-sleep-lock -- owl-lock
exec --no-startup-id xset s off
I3CONFIG

    run chown -R "$REAL_USER:$REAL_USER" "$I3_DIR"
    msg "i3 config written to $I3_DIR/config"

    # The locker wrapper. Both the keybinding and xss-lock call this, so the
    # fallback covers the idle path too -- see the i3 config above for why that
    # cannot be done with `||` on the bindsym line.
    #
    # exec, not a subshell: xss-lock signals the locker to tell it the screen is
    # actually locked, and a wrapper that stays in the middle would swallow that.
    write_file /usr/local/bin/owl-lock 755 <<'OWLLOCK'
#!/bin/sh
# Written by kali-deploy-physical. Locks with betterlockscreen, falling back to
# plain i3lock: betterlockscreen -l exits non-zero when its cache is missing and
# would otherwise leave the screen unlocked, which is the one thing a lock
# binding must never do.
exec betterlockscreen -l 2>/dev/null || exec i3lock -c 282828 -n
OWLLOCK
    msg "lock wrapper written to /usr/local/bin/owl-lock"

    # betterlockscreen's theme. Colours are RRGGBBAA, and they are the prompt
    # palette: seafoam ring to match polybar's accent, lavender while verifying,
    # the pinned alert red for a wrong password. Same values the bar and the
    # prompt use, so the locked screen is recognisably the same machine.
    #
    # solid_color is the fallback ground when no image has been cached, and is
    # #282828 like everything else. No dim or blur effect is applied: the greeter
    # shows this same image untreated, and a lock screen that dims while the
    # login screen does not is the mismatch this whole exercise is about.
    write_file "$USER_HOME/.config/betterlockscreen/betterlockscreenrc" <<'BLSRC'
# Written by kali-deploy-physical. Delete to fall back to betterlockscreen's own.
#
# This path, not ~/.config/betterlockscreenrc: 4.4.0 sources the old location but
# prints a migration error to stderr every single time it runs.
display_on=0
span_image=false
lock_timeout=300
fx_list=(dim blur dimblur pixel dimpixel color)
dim_level=40
blur_level=1
pixel_scale=10,1000
solid_color=282828
wallpaper_cmd="feh --bg-fill"
quiet=false

# The prompt palette -- dots/shell/zsh/prompt.zsh
loginbox=282828cc
loginshadow=00000000
locktext="locked"
font="JetBrainsMono Nerd Font"
ringcolor=83A0A4ff
insidecolor=28282800
separatorcolor=00000000
ringvercolor=B2A1C0ff
insidevercolor=28282800
ringwrongcolor=FF2D2Dff
insidewrongcolor=FF2D2D33
timecolor=DADADAff
time_format="%H:%M"
greetercolor=8A8A8Aff
layoutcolor=8A8A8Aff
keyhlcolor=B2A1C0ff
bshlcolor=FF2D2Dff
veriftext="checking"
verifcolor=B2A1C0ff
wrongtext="no"
wrongcolor=FF2D2Dff
modifcolor=B2A1C0ff
bgcolor=282828ff

# No ring. betterlockscreen hardcodes --radius/--ring-width, so the circle can
# only be removed from this side: -u/--no-unlock-indicator suppresses the arc in
# draw_indic(). The clock and the greeter text are built outside that guard and
# survive it, and betterlockscreen already passes --force-clock, so the time
# stays up with the indicator gone.
#
# This appends rather than replaces: betterlockscreen sets lockargs=(-n) before
# it sources this file, and -n (nofork) is what keeps xss-lock working.
#
# The greeter has no ring to mirror, so dropping it here is also what makes the
# two screens the same picture with the same text over it, and nothing else.
lockargs+=(--no-unlock-indicator)
BLSRC
    run chown -R "$REAL_USER:$REAL_USER" "$USER_HOME/.config/betterlockscreen"
    msg "lock screen theme written to $USER_HOME/.config/betterlockscreen/betterlockscreenrc"

    # The greeter. Same image and same palette as the lock screen, because they
    # are the same moment as far as anyone looking at the laptop is concerned.
    #
    # The image is at a /usr/share path rather than in $HOME because the greeter
    # runs as the `lightdm` user and cannot read your home directory at all --
    # a background under ~/ is simply never drawn, with nothing logged. The dots
    # phase publishes it there; if that phase skipped, background falls back to
    # the flat #282828 below and the greeter still comes up.
    #
    # hide-user-image kills the avatar circle. round-user-image is set too, so
    # that a box where an avatar does exist doesn't reintroduce a circle.
    #
    # No `position` line, deliberately, and it must stay that way. Writing the
    # documented default `position=50% 50%` does NOT reproduce the default: the
    # built-in WINDOW_POS_CENTER carries anchor=0 (centre), but
    # read_position_from_str() gives a string with no explicit anchor part
    # anchor=-1 (start), and get_absolute_position() then skips the `x -=
    # window/2` step. The result is the window's top-left corner pinned to the
    # centre of the screen, i.e. visibly down and to the right. Omitting the key
    # is the only way to get the centred default; if it ever needs to move, the
    # syntax is `position=50%,center 40%,center` -- the anchor is not optional.
    write_file /etc/lightdm/lightdm-gtk-greeter.conf <<'GREETER'
# Written by kali-deploy-physical.
[greeter]
background=/usr/share/backgrounds/owlshells/lock.png
user-background=false
theme-name=owlshells
icon-theme-name=Adwaita
font-name=JetBrainsMono Nerd Font 11
xft-antialias=true
xft-hintstyle=slight
xft-rgba=rgb
hide-user-image=true
round-user-image=false
clock-format=%H:%M
indicators=~spacer;~clock;~spacer;~session;~power
GREETER
    msg "greeter config written to /etc/lightdm/lightdm-gtk-greeter.conf"

    # The greeter's colours. lightdm-gtk-greeter has no "load this CSS" option --
    # its sample CSS ships as documentation, not as a config path -- so the only
    # way in is a GTK theme it can be pointed at by name. This is a theme in the
    # minimum sense: a gtk.css that inherits nothing and styles the four widgets
    # the greeter actually draws.
    #
    # /usr/share/themes because, again, the lightdm user has to be able to read
    # it. Named widgets come from the upstream sample; the palette is the prompt's.
    write_file /usr/share/themes/owlshells/gtk-3.0/gtk.css <<'GREETERCSS'
/* Written by kali-deploy-physical. The prompt palette, on the greeter.
   Every selector below is a widget id taken from lightdm-gtk-greeter 2.0.9's
   own glade file, not from the upstream sample CSS -- that sample is headed
   "for lightdm-gtk-greeter 1.8" and names widgets that no longer exist. The
   element-form menubar selectors match what the greeter's own fallback CSS
   uses on this version. */

/* This import is load bearing. Naming a theme REPLACES Adwaita rather than
   extending it, so a gtk.css of pure overrides leaves every widget with no base
   style at all -- the login box renders as a small pale unstyled rectangle, and
   nothing anywhere reports a problem. Pulling in GTK's built-in dark Adwaita
   first gives the widgets their padding, borders and states back; everything
   below is then an override on top of a working theme rather than the whole of
   one. The resource path is compiled into libgtk-3, so there is no file to
   install and nothing to keep in sync. */
@import url("resource:///org/gtk/libgtk/theme/Adwaita/gtk-contained-dark.css");

/* The ground, and what shows if the image is ever missing. */
.lightdm-gtk-greeter,
#screen_overlay {
    background-color: #282828;
    color: #DADADA;
}

/* The login window, and the power dialog that shares its look. */
#login_window,
#power_window {
    background-color: rgba(40, 40, 40, 0.90);
    border: 1px solid #3A3D42;
    border-radius: 2px;
    color: #DADADA;
}

#content_frame,
#login_box {
    background-color: transparent;
    color: #DADADA;
}

/* The fields. Flat, with a seafoam underline that brightens to lavender on
   focus -- the two accents the bar and the prompt already use. */
#username_entry,
#password_entry {
    background-color: rgba(58, 61, 66, 0.85);
    background-image: none;
    border: none;
    border-bottom: 2px solid #83A0A4;
    border-radius: 0;
    color: #DADADA;
    padding: 6px 8px;
}

#username_entry:focus,
#password_entry:focus {
    border-bottom-color: #B2A1C0;
}

#user_combobox {
    color: #88A9B5;
}

#login_button,
#cancel_button {
    background-image: none;
    background-color: transparent;
    border: 1px solid #3A3D42;
    border-radius: 2px;
    color: #88A9B5;
}

#login_button:hover,
#cancel_button:hover {
    border-color: #B2A1C0;
    color: #B2A1C0;
}

/* Wrong password, and anything else the greeter needs to say. */
#message_label {
    color: #FF2D2D;
}

#greeter_infobar {
    background-color: rgba(40, 40, 40, 0.95);
    color: #FF2D2D;
}

/* The top panel: clock, session and power. Quiet -- it is not what you came
   here to look at. */
#panel_window {
    background-color: rgba(40, 40, 40, 0.85);
    color: #8A8A8A;
    box-shadow: inset 0 -1px #3A3D42;
}

#panel_window menubar,
#panel_window menubar > menuitem {
    background-color: transparent;
    color: #8A8A8A;
}

#panel_window menubar > menuitem:hover {
    color: #B2A1C0;
}

#panel_window menubar > separator {
    background: transparent;
}
GREETERCSS
    msg "greeter theme written to /usr/share/themes/owlshells/gtk-3.0/gtk.css"

    # picom's config, derived from Kali's rather than written from scratch.
    #
    # Kali's /etc/xdg/picom.conf still carries options picom 13 deprecated --
    # glx-no-stencil, glx-no-rebind-pixmap, and a ":c" type specifier on the
    # _GTK_FRAME_EXTENTS shadow-exclude rule. picom does not merely log these:
    # it raises a GUI warning dialog on every session start, which on a box
    # whose whole point is to come up clean is a permanent papercut.
    #
    # Derived rather than authored because that shadow-exclude rule is load
    # bearing -- it suppresses shadows on GTK client-side-decorated windows, and
    # a hand-written config would drop it and produce double borders on every
    # GTK app. Kali's tuning is kept; only the dead options are removed.
    #
    # It has to be a copy rather than an edit: picom reads the FIRST config it
    # finds and does not merge, so there is no override file. Editing the
    # packaged one instead would be reverted by the next picom upgrade and would
    # make this script the owner of a file dpkg already owns.
    PICOM_SRC="/etc/xdg/picom.conf"
    PICOM_DIR="$USER_HOME/.config/picom"
    PICOM_DST="$PICOM_DIR/picom.conf"

    if [[ ! -f "$PICOM_SRC" ]]; then
        warn "no $PICOM_SRC to derive from -- leaving picom on its defaults"
    elif [[ -f "$USER_HOME/.config/picom.conf" ]]; then
        # This path outranks ours in picom's search order, so writing our file
        # would produce something that is never read. Say so rather than lie.
        warn "$USER_HOME/.config/picom.conf exists and outranks $PICOM_DST"
        warn "  leaving both alone -- picom will keep reading the one you have"
    elif [[ -f "$PICOM_DST" ]] && ! grep -q 'kali-deploy-physical' "$PICOM_DST"; then
        warn "$PICOM_DST is not ours -- leaving your picom config alone"
    else
        {
            echo "# Generated by kali-deploy-physical from $PICOM_SRC."
            echo "# Kali's config, minus the options picom 13 deprecated. Re-run the i3"
            echo "# phase to regenerate; delete this file to fall back to Kali's."
            echo
            # Drop the two dead options by key, and strip the deprecated type
            # specifier from any c2 rule that still carries one.
            grep -vE '^[[:space:]]*(glx-no-stencil|glx-no-rebind-pixmap)[[:space:]]*=' \
                "$PICOM_SRC" | sed 's/@:c"/@"/g'
        } | write_file "$PICOM_DST"
        run chown -R "$REAL_USER:$REAL_USER" "$PICOM_DIR"
        msg "picom config written to $PICOM_DST (deprecated options removed)"
    fi
fi

# ------------------------------------------------------------------------------
# Phase: polybar -- status bar
