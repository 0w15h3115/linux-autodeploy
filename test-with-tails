#!/bin/bash

# Update and upgrade system packages
echo "Ready... Set... Go! "
sudo apt update -y
sudo apt upgrade -y
# Working

# Install Pip
sudo apt install python3-pip pipx -y
# Working

# Install NeoVim
sudo apt install neovim -y
# Working

# Install Nmap (includes Ncat)
echo "Installing Nmap..."
sudo apt install nmap -y
# Working

# Install Apache server
# Started but deliberately not enabled: Tails is amnesic, so there is no next
# boot for an enabled unit to survive into -- `systemctl enable` writes a
# symlink into a filesystem that disappears with the session. It also leaves a
# listener up on a box whose whole point is not having one (see README).
echo "Installing Apache server..."
sudo apt install apache2 -y
sudo systemctl start apache2
# Working

# Install Impacket via pip
echo "Installing Impacket..."
sudo apt install python3-impacket -y
# Working

# Install Build-Essential for compiling software
echo "Installing build-essential..."
sudo apt install build-essential -y
# Working

# Install Sliver C2
echo "Installing Sliver..."
sudo -u amnesia torify wget https://github.com/BishopFox/sliver/releases/latest/download/sliver-server_linux -O sliver-server
chmod +x sliver-server
sudo mv sliver-server /usr/local/bin/sliver-server
# Working

# Download and Install Burp Suite Community Edition
# No version= parameter. With one (this was pinned to 2023.6.1) you pull a
# years-stale Burp down over Tor and get told to update it on first launch;
# without one PortSwigger serves the current Community build for the platform.
# It is ~380 MB, so this is the slow part of the run.
echo "Installing Burp Suite..."
sudo -u amnesia torify wget "https://portswigger.net/burp/releases/download?product=community&type=Linux" -O burpsuite.sh
sudo chmod +x burpsuite.sh
# will need to run installer at later time (./burpsuite.sh)
# Working somewhat

# Install Netexec
# NetExec ships a prebuilt Linux binary as a GitHub release asset, but the
# newest release does not always carry one (v1.5.1 has no assets at all), so
# /releases/latest/download 404s. The asset name has also changed across
# versions -- nxc, nxc-ubuntu-latest, nxc-ubuntu-latest.zip -- so ask the API
# for the newest release that actually has a Linux build and take its name as
# it comes.
echo "Installing NetExec..."
sudo apt install unzip -y
NXC_URL=$(sudo -u amnesia torify wget -qO- https://api.github.com/repos/Pennyw0rth/NetExec/releases | python3 -c '
import json, re, sys
for rel in json.load(sys.stdin):
    if rel["draft"] or rel["prerelease"]:
        continue
    for asset in rel["assets"]:
        if re.search(r"ubuntu|linux", asset["name"], re.I) or asset["name"] == "nxc":
            print(asset["browser_download_url"])
            sys.exit()
')
if [ -n "$NXC_URL" ]; then
    echo "  from $NXC_URL"
    sudo -u amnesia torify wget "$NXC_URL" -O /tmp/nxc.download
    case "$NXC_URL" in
        *.zip) unzip -p /tmp/nxc.download nxc > /tmp/nxc ;;
        *)     cp /tmp/nxc.download /tmp/nxc ;;
    esac
    rm -f /tmp/nxc.download
    chmod +x /tmp/nxc
    sudo mv /tmp/nxc /usr/local/bin/nxc
    nxc --version && echo "NetExec installed as nxc"
else
    echo "NetExec: no Linux release asset found, skipping. Install it by hand:"
    echo "  https://github.com/Pennyw0rth/NetExec/releases"
fi
# Working -- binary lands at /usr/local/bin/nxc, run it as: nxc smb <target>

# Install Proxychains
sudo apt install proxychains -y
# Working

echo "Tails ready to Test!"
